      <rules>
        <rule name="Curse of the Void" id="9169-f360-b7b7-bc4c" hidden="false" page="168" publicationId="3ae4-9ad8-pubN65739">
          <description>Any unit, friendly or enemy, within the Faction Craftworld Eldar, Dark Eldar, Eldar Corsairs or Harlequin suffers a -1 modifier to their Leadership value while within 12&quot; of at least one Corsair Malevolent Band. In addition, a Corsair Malevolent Band never counts as a Scoring unit under any circumstances.</description>
        </rule>
      </rules>
