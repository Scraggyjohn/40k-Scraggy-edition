        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 1, Blast, Shred</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Shuriken Cannon" id="c208-d493-2195-7587" hidden="false" page="150" publicationId="3ae4-9ad8-pubN105560" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
