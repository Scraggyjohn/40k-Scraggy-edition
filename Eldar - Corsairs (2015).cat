      </characteristics>
    </profile>
    <profile name="Shuriken Pistol" id="acaa-8094-58c1-5117" hidden="false" page="150" publicationId="3ae4-9ad8-pubN105560" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
