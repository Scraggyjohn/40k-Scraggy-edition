    <profile name="Sonic Lance" id="0362-a74e-a482-a9f7" hidden="false" page="194" publicationId="3ae4-9ad8-pubN65739" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Hellstorm</characteristic>
