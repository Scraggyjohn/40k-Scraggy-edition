    <profile name="Dissonance Breach Charge" id="1402-be05-f076-4a14" hidden="false" page="155" publicationId="3ae4-9ad8-pubN65739" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
