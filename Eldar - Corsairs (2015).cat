    <profile name="Splinter Rifle" id="36da-77fb-8e87-b248" hidden="false" publicationId="3ae4-9ad8-pubN99804" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">1</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Rapid Fire, Poisoned (4+)</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Star Engines" id="8669-a743-a9c7-345f" hidden="false" page="155" publicationId="3ae4-9ad8-pubN105560" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A non-Walker vehicle with this upgrade can move up to 24&quot; when making a Flat Out. A Walker with this upgrade instead Runs an additional 3&quot; (this will normally be D6+3&quot;).</characteristic>
      </characteristics>
    </profile>
    <profile name="Starcannon" id="0fc6-d1be-3c70-ffdb" hidden="false" page="151" publicationId="3ae4-9ad8-pubN105560" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">36&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Tanglefield Grenade" id="7839-aa34-8cfc-96ec" hidden="false" page="155" publicationId="3ae4-9ad8-pubN65739" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">8&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">2</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 1, Blast, Tanglefield</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Venom Blade" id="ac6e-9757-f843-eb68" hidden="false" publicationId="3ae4-9ad8-pubN99804" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Poisoned (2+)</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Void Hardened Armour" id="b721-2622-12b1-0aea" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with Void Hardened Armour may re-roll failed saves made against weapons of either the Template or Blast type and reduces the distance rolled for Charges, Sweeping Advances and Run moves by 1&quot;. Note that void hardened armour does not bestow or modify a model&apos;s armour save, and has some additional effects when playing a Zone Mortalis game (as noted in the Zone Mortalis rules).</characteristic>
      </characteristics>
    </profile>
    <profile name="Void Sabre" id="5d8d6b2a-475b-c354-5250-1280c68f13fc" hidden="false" page="156" publicationId="3ae4-9ad8-pubN65739" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+1</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Rending</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Voidplate Harness" id="9bee-1704-ecd0-8ca2" hidden="false" page="155" publicationId="3ae4-9ad8-pubN65739" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A Voidplate Harness grants a 3+ Armour save. Models equipped with a Voidplate Harness lose the Fleet special rule if they possess it, but may re-roll all Difficult terrain and Dangerous terrain rolls. In games of Zone Mortalis, models equipped with voidplate harnesses gain the Void Hardened Armour special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Witch Staff" id="869b-65b0-2efd-de69" hidden="false" page="152" publicationId="3ae4-9ad8-pubN105560" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Armourbane, Fleshbane, Soul Blaze</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Acrobatic" id="a9549564-27be-ad60-971a-908a6d6cda57" hidden="false" publicationId="3ae4-9ad8-pubN99925">
      <description>A unit that consists entirely of models with this special rule adds 3&quot; to its maximum move distance when it Runs and when it makes charge moves. Furthermore, models with this special rule do not suffer the Initiative penalty for charging enemies through difficult terrain.</description>
    </rule>
    <rule name="Acrobatic Grace" id="b0b5-2001-3816-d334" hidden="false">
      <description>A model with this special rule has a 4+ cover save unless it remained stationary in its previous Movement phase.</description>
    </rule>
    <rule name="Agile" id="2243-1d72-669d-1780" hidden="false" publicationId="3ae4-9ad8-pubN105545"/>
    <rule name="Bladestorm" id="ce57-25dd-7d75-6574" hidden="false" page="150" publicationId="3ae4-9ad8-pubN105560">
      <description>When firing a weapon with this special rule, a To Wound roll of a 6 wounds automatically, regardless of the target&apos;s Toughness, and is resolved at AP2.</description>
    </rule>
    <rule name="Corsair Combat Drugs" id="1e77-71e1-ffec-1229" hidden="false" page="159" publicationId="3ae4-9ad8-pubN65739">
      <description>Before deployment, roll a D6 on the following table and apply the effects of the result to all units with the Corsair Combat Drugs special rule for the duration of the battle:

1         Adrenalight: +1 Attack
2         Grave Lotus: +1 Strength
3         Hypex: +1 Initiative
4         Painbringer: +1 Toughness
5         Serpentin: +1 Weapon Skill
6         Chymaeric: Roll two more results and apply both. This result may only be gained once - re-roll any further results of a 6.</description>
    </rule>
    <rule name="Dancing on the Blade&apos;s Edge" id="b271-25f7-1ad4-8971" hidden="false" page="154" publicationId="3ae4-9ad8-pubN65739">
      <description>A unit with this special rule has two values listed for their Leadership value, separated by a slash, for example, 10/6. The first is used for all Leadership tests or Morale checks, including Pinning tests, taken by the unit except for Regroup tests. The second value is used for all Regroup tests made by the unit. When accompanied by a Character model with a single Leadership value, the unit may use this value for Regroup tests where it is higher than the unit&apos;s value.</description>
    </rule>
    <rule name="Dispersed" id="cf7c-0f52-e3af-979e" hidden="false" page="174" publicationId="3ae4-9ad8-pubN65739">
      <description>A weapon with this special rule, when rolling on the Destroyer Weapons Attack table, counts all rolls of 6 (Devastating Hit/Deathblow) as 5 (Solid Hit/Seriously Wounded) results instead.</description>
    </rule>
    <rule name="Dissonance Wave" id="acf2-909b-a6e6-1b4b" hidden="false" page="155" publicationId="3ae4-9ad8-pubN65739">
      <description>A weapon with this type rolls 3D6 for Armour Penetration rolls, adding the results together to determine the final result. If any of the dice rolled for Armour Penetration score a 6, the Strength of the weapon is increased by +1 and the AP is improved by -1.</description>
    </rule>
    <rule name="Eldar Jetbike" id="61d6-8501-533f-1470" hidden="false" page="153" publicationId="3ae4-9ad8-pubN99925">
      <description>A model riding an Eldar Jetbike has a 3+ Armour Save and a Twin-linked Shuriken Catapult. Their unit type also changes to Eldar Jetbike. (See Warhammer 40k Rulebook)</description>
    </rule>
    <rule name="Fighter Ace" id="e60ddb5a-86a2-651e-7941-d8e8a17b9435" hidden="false" publicationId="3ae4-9ad8-pubN105674">
      <description>Eldar/Dark Eldar:
1-2 Dance of the Dawn: The Fighter Ace has +1 Ballistic Skill
3-4 Dance of the Dusk: The Fighter Ace can pivot up to 180-degrees before moving in the Movement phase each turn.
5-6 Symbol of Khaine: All friendly units within 12&quot; of the Fighter Ace that are from the same Faction as the Fighter Ace have the Hatred special rule.</description>
    </rule>
    <rule name="Internal Politics" id="c85b-7a5e-fc77-55e9" hidden="false" page="153" publicationId="3ae4-9ad8-pubN65739">
      <description>The separate Coteries that make up this Detachment (but not the Command Crew) count each other as Allies of Convenience.</description>
    </rule>
    <rule name="Laser-web" id="9ccf-21b3-f4fe-eacf" hidden="false" page="175" publicationId="3ae4-9ad8-pubN65739">
      <description>When a weapon with this special rule targets a Zooming Flyer or Fast Skimmer, it gains the Ignores Cover special rule for that attack.</description>
    </rule>
    <rule name="Mesh Armour" id="a728-b12a-12a8-7b83" hidden="false" page="153" publicationId="3ae4-9ad8-pubN99925">
      <description>Mesh Armour confers a 5+ Armour Save</description>
    </rule>
    <rule name="Monofilament" id="d501-cb15-d042-2823" hidden="false" page="150" publicationId="3ae4-9ad8-pubN105560">
      <description>When rolling To Wound for a weapon that has this special rule, use the target&apos;s Initiative instead of its Toughness (note that the model&apos;s Toughness is still used to determine whether an attack has the Instant Death special rule). In addition, if a 6 is rolled To Wound when attacking with a weapon that has this special rule, the Wound is resolved at AP2 unless the weapon is AP1.</description>
    </rule>
    <rule name="Plasma Grenades" id="189a0e59-280c-e882-c68b-07949792039e" hidden="false" publicationId="3ae4-9ad8-pubN105768">
      <description>Models equipped with plasma grenades don&apos;t suffer the penalty to their Initiative for charging enemies through difficult terrain, but fight at their normal Initiative step in the ensuing combat.</description>
    </rule>
    <rule name="Reckless Abandon" id="e2e8-6547-0d4a-7fd9" hidden="false" page="154" publicationId="3ae4-9ad8-pubN65739">
      <description>A unit which includes only models with this special rule that fires at an enemy unit within 12&quot; of itself may make an immediate move of 6&quot; after all effects of the shooting attack have been resolved. If the unit has the type Jet Pack Infantry or Eldar Jetbike, this move is increased to 6+D6&quot;. This move cannot place the unit into close combat, within 1&quot; of any enemy unit or be used to move them closer to any unit targeted by their shooting attack.</description>
    </rule>
    <rule name="Skilled Flyer" id="c8f343b8-e738-e17e-e6b7-afc6da9b899e" hidden="false" publicationId="3ae4-9ad8-pubN105545">
      <description>Unit may re-roll failed Dangerous Terrain tests.</description>
    </rule>
    <rule name="Soundquake" id="0b25-f4d5-065f-ca0c" hidden="false" page="194" publicationId="3ae4-9ad8-pubN65739">
      <description>To fire the Sonic Lance, place the Hellstorm template so that the narrow end is within 18&quot; of the weapon and the large end is no closer to the weapon than the narrow end. All non-vehicle models hit by this are wounded on a 3+ regardless of their Toughness value. Vehicle models struck by this weapon take a single hit at Strength 1 and roll 3D6 for Armour Penetration.</description>
    </rule>
    <rule name="Star Engines" id="2fe0f87b-f865-2291-a091-a47f6d547ff7" hidden="false" page="155" publicationId="3ae4-9ad8-pubN99925">
      <description>A non-Walker vehicle with this upgrade can move up to 24&quot; when moving Flat Out. A Walker with this upgrade instead Runs an additional 3&quot; (this will normally be D6+3&quot;).</description>
    </rule>
    <rule name="Sworn Protector" id="dba0be32-6239-505f-a7d1-46d4153a98c6" hidden="false" publicationId="3ae4-9ad8-pubN105545">
      <description>An Independent Character in a unit that contains at least one model with this special rule automatically passes Look Out, Sir attempts.</description>
    </rule>
    <rule name="Tanglefield" id="18e1-83cc-67f9-3afe" hidden="false" page="155" publicationId="3ae4-9ad8-pubN65739">
      <description>A unit that suffers any hits from a weapon with this special rule must take an immediate Strength test. If it is failed, the unit has its Initiative and WS values reduced by half until the end of its controlling player&apos;s next turn.</description>
    </rule>
    <rule name="Vibro-pulse" id="d66f-7e7d-2554-87bc" hidden="false" page="155" publicationId="3ae4-9ad8-pubN65739">
      <description>For each model from the same unit that scores a 6 To Hit when firing a weapon with this special rule, while targeting the same target unit, add +1 to the Strength (to a maximum of 10) and subtract -1 from the AP (to a minimum of 1) when resolving To Wound rolls for all weapons with this special rule during this Shooting attack only.</description>
    </rule>
    <rule name="Warlord" id="cea4-fe6a-8796-d4dc" hidden="false"/>
    <rule name="Wild Psyker" id="d8ee-98d6-c1f4-fd93" hidden="false" page="154" publicationId="3ae4-9ad8-pubN65739">
      <description>A model with this special rule follows all the usual rules for Psykers and is considered to have the Psyker special rule, but when called upon to roll on the Perils of the Warp table rolls on the following table instead:

D6     Result
1       Devoured: the psyker is claimed, body and soul, by the great power which destroyed the Eldar empire of old. The model gains the Daemon of Slaanesh* special rule and no longer acts in its original controlling player&apos;s turn. It instead acts during the opposing player&apos;s turn, is counted as an enemy model and is controlled for the remainder of the battle by the opposing player. If the model was part of a unit when this result was rolled, it is now locked in combat with that unit. The model counts as destroyed for the purposes of Victory points and objectives, and may no longer attempt to manifest Psychic powers after having rolled this result.
   
          *Daemon of Slaanesh: a model with this special rule gains the Daemon, Hatred (Daemons of Khorne) and Rend special rules, and may Run an additional 3&quot;.

2-3     Soul-wracked: The cruel caresses of the minions of Slaanesh send the psyker into a paroxysm of pain and twist the intent of their art to murderous purposes. This model and any unit it has joined is treated as though it had failed a Pinning test and Goes to Ground. The opposing player then chooses a new target for the Psychic power the model was attempting to manifest, and may choose for the power to treat units under their control as friendly or enemy for the purposes of targeting the power. The new target unit must be a permissible target as noted under the power&apos;s description, and the opposing player may choose to have the power simply fail if no alternative targets are available or possible.

4-5     Warp Terrors: Daemons swirl close about the frayed veil that separates realspace from the Warp, taunting the Eldar witch and their kin with the doom that awaits them. All friendly units with the Faction Eldar Corsair within 6&quot;, including this model and any unit it has joined, must make an immediate Morale check, rolling three D6 and keeping the two highest dice to determine the result.

6         The Eye of She Who Thirsts: The psyker gains the attention of Slaanesh. For the remainder of the game, whenever this model is called upon to take a Psychic test, the controlling player must roll on the Wild Psyker Perils of the Warp table if any doubles are rolled. A model already affected by this result must re-roll any results of 6 on this table.</description>
    </rule>
    <rule name="Break Turns" id="978f-c419-1286-4893" hidden="false" publicationId="3ae4-9ad8-pubN81385">
      <description>Zooming Flyers with the Strike-fighter, Air Leviathan or Utility Craft Combat Roles may not make Break Turns.</description>
    </rule>
  </sharedRules>
