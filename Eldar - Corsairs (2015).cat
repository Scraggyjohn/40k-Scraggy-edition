          <profiles>
            <profile name="The Mask of Secrets" id="41d8-e35d-7910-8db7" hidden="false" page="93" publicationId="3ae4-9ad8-pubN101373" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with the Mask of Secrets has the Fearless special rule. In addition, enemy models within 12&quot; of the bearer suffer -2 to their Leadership.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cegorach&apos;s Rose" id="1695-d1b5-67f9-d483" collective="false" hidden="false" import="true" page="93" publicationId="3ae4-9ad8-pubN101373" type="upgrade">
