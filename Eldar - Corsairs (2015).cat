    <profile name="Splinter Pistol" id="6b21-0c62-bc92-46ba" hidden="false" publicationId="3ae4-9ad8-pubN99804" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12&quot;</characteristic>
