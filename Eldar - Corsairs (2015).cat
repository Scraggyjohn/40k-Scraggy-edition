      <selectionEntryGroups>
        <selectionEntryGroup name="Cotorie Specialization - 1 optional" id="cbd9-0e5a-af22-8a61" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Titan Breakers" id="eafc-59fc-5c6f-5001" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <rules>
                <rule name="Titan Breakers" id="457d-4645-6917-2687" hidden="false" page="153" publicationId="3ae4-9ad8-pubN65739">
                  <description>All Infantry and Eldar Jetbike units in this Coterie gain the Preferred Enemy (vehicles with the Tank or Walker type) special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Head Takers" id="8ff2-6a0b-fa5f-8ff9" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <rules>
                <rule name="Head Takers" id="437f-c17e-fdd3-35c9" hidden="false" page="153" publicationId="3ae4-9ad8-pubN65739">
                  <description>During any Assault phase in which at least one model from a unit with this special rule is engaged in a Challenge, the entire unit (including the model engaged in a Challenge) may re-roll To Wound rolls of 1 for the duration of that combat.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Vault Breachers" id="de10-326b-2c68-34a9" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <rules>
                <rule name="Vault Breachers" id="6070-61fc-91b5-3b92" hidden="false" page="153" publicationId="3ae4-9ad8-pubN65739">
                  <description>All Infantry and Eldar Jetbike units in this Coterie gain Dissonance Breach Charges at no additional points cost.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Sky Burners" id="808b-430c-2b66-a102" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <rules>
                <rule name="Sky Burners" id="b2f5-d7b1-6f35-e29b" hidden="false" page="153" publicationId="3ae4-9ad8-pubN65739">
                  <description>Units in this Coterie roll one less D6 when rolling for scatter as part of a Deep Strike deployment, and may re-roll failed Reserves rolls.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Night Hunters" id="993a-339a-d6f3-bd62" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <rules>
                <rule name="Night Hunters" id="5499-172b-2118-096e" hidden="false" page="153" publicationId="3ae4-9ad8-pubN65739">
                  <description>All Infantry and Eldar Jetbike units in this Coterie gain the Night Vision special rule and while the Night Fighting rules are in effect, they also gain the Preferred Enemy (Everything) special rule.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Hate Bringers" id="e7ac-a724-51c4-68af" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <rules>
                <rule name="Hate Bringers" id="412e-537b-15f9-4f27" hidden="false" page="153" publicationId="3ae4-9ad8-pubN65739">
                  <description>Select a single enemy unit that is on the table at the beginning of game turn 1 (this may include units inside transport vehicles). All Infantry and Eldar Jetbike units in this Coterie gain the Hatred (the chosen unit) special rule and if the target unit is destroyed during the course of play, the Coterie&apos;s controling player gains +1 VP. This counts as a secondary objective in games using Victory Points.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
