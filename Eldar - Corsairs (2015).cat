                  </costs>
                  <profiles>
                    <profile name="Wasp Jump Pack" id="dd4a-2ac7-fafb-434b" hidden="false" page="169" publicationId="3ae4-9ad8-pubN65739" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A Wasp Jump Pack can be used in either the Movement phase or Assault phase, but not both in the same turn. If used in the Movement phase, the Wasp Assault Walker may move up to 12&quot; and no less than 8&quot; in any direction, ignoring intervening terrain and models; when moving in this fashion the Wasp Assault Walker may only fire Snap Shots in the following Shooting phase. If used in the Assault phase, the Wasp Assault Walker may roll an additional dice when determining Charge distances and use the two highest results, and additionally gains the Hammer of Wrath special rule for that phase, inflicting D6+1 hits instead of just one.  Any use of the Wasp Jump Pack in either phase grants a model with a Corsair Kinetic Shroud a 4+ invulnerable save against Shooting attacks, and re-rolls on failed invulnerable saves until the beginning of the controlling player&apos;s next turn.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
