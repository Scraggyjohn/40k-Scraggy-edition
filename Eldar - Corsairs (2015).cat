        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Chain-snares" id="e8a5-097d-a33a-8f65" hidden="false" publicationId="3ae4-9ad8-pubN99804" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with Chain-snares is allowed to Tank Shock even if it is not a Tank. However, it may not Ram.</characteristic>
      </characteristics>
    </profile>
    <profile name="Corsair" id="69ab-2993-2d1f-3193" hidden="false" page="163" publicationId="3ae4-9ad8-pubN65739" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
