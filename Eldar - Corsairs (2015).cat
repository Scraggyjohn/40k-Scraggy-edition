    <profile name="Splinter Cannon" id="c855-93cb-df38-2a1f" hidden="false" publicationId="3ae4-9ad8-pubN99804" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
