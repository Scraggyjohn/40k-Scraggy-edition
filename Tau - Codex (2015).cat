          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of this model&apos;s Movement phase, choose a special rule: Counter-attack, Furious Charge, Monster Hunter, Stubborn or Tank Hunters. This model has that rule until the start of his next Movement phase.</characteristic>
          </characteristics>
        </profile>
