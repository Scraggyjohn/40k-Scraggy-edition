    <selectionEntry name="Drone Perimeter Defence Team" id="567fd298-c39c-da31-8947-5fcc857bff5e" collective="false" hidden="false" import="true" page="86" publicationId="24a0-49b6-pubN67347" type="upgrade">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="567fd298-c39c-da31-8947-5fcc857bff5e-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="25"/>
      </costs>
      <rules>
        <rule name="Networked Defence" id="333cf3f3-a09a-295b-c04f-089404012761" hidden="false" page="86" publicationId="24a0-49b6-pubN67347">
          <description>Each unit in this formation must be placed within 12&quot; of another unit in this formation.</description>
        </rule>
        <rule name="Technical Support" id="2527775e-ea32-7b09-d895-02970d5d5548" hidden="false" page="86" publicationId="24a0-49b6-pubN67347">
          <description>A DX-4 Technical Drone that spends a turn in base contact with a damaged Sentry Turret can repair a destroyed weapon on a roll of 5+.</description>
        </rule>
        <rule name="Hold the Line" id="471edf56-1fc1-d8ca-cb43-bb1d80177f9e" hidden="false" page="86" publicationId="24a0-49b6-pubN67347">
          <description>Drones in this formation are allowed to re-group regardless of the amount of casualties they have sustained.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="DX-4 Technical Drone" id="f5202b3a-efc8-be5b-19ab-e13bbb0700cd" collective="false" hidden="false" import="true" page="86" publicationId="24a0-49b6-pubN67347" type="model">
