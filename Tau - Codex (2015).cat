    <selectionEntry name="Ghostkeel Wing" id="7050-615d-27dc-08fe" collective="false" hidden="false" import="true" page="76" publicationId="24a0-49b6-pubN65836" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Coordinated Attacks" id="f6a0-f30b-4a84-20af" hidden="false">
          <description>In the Shooting Phase, add 1 to the Ballistic Skill of a Ghostkeel from this Formation if it shoots at a unit that has already been shot at this phase by any other Ghostkeel from this Formation.</description>
        </rule>
        <rule name="Networked Stealth Field" id="f312-6c69-8c88-a695" hidden="false">
          <description>Any friendly unit with the Tau Empire Faction that is within 12&quot; of two or more units from this Formation has the Stealth special rule. If the unit already has Stealth, it receives the Shrouded special rule. If it already has Stealth and Shrouded, it recieves no additional benefit.</description>
        </rule>
        <rule name="Phantom Charge" id="b5b9-2dd8-73c8-0544" hidden="false">
          <description>Enemy units cannot make Overwatch attacks against a unit from this Formation that is within 6&quot; of another unit from this Formation when the Overwatch attack would be made.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Ghostkeels - 3 required" id="916f-45d5-7bed-e0ae" collective="false" defaultSelectionEntryId="0ffc-8c11-62f5-0606" hidden="false" import="true">
