        <infoLink name="Move Through Cover" id="a6f9-4670-cad4-97ed" hidden="false" targetId="7ecc-bc3d-6e22-63dc" type="rule"/>
        <infoLink name="Outflank" id="4c29-4c66-0503-0921" hidden="false" targetId="c2d5-d82e-74f8-fe82" type="rule"/>
