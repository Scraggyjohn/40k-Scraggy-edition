      <rules>
        <rule name="Low Altitude Deployment" id="32e2-1780-9449-4d3f" hidden="false">
          <description>If all of the units from this Formation start in Reserve, you can announce before the battle begins that they will use Low Altitude Deployment. If you do so, deploy the entire Formation using the Deep Strike special rule at the start of your Second Turn.</description>
        </rule>
        <rule name="Drop Zone Clear" id="d034-d535-e4fe-0c7c" hidden="false">
