      <profiles>
        <profile name="Neuroweb System Jammer" id="8d8c-3c5c-14fc-c152" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each enemy Shooting phase, this model can target a single enemy unit in 12&quot;. All shooting weapons in the target unit gain the Gets Hot special rule until the end of the phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
