    <profile name="Automated Repair System" id="3c8ab6f4-f626-d1d4-5d79-fa9e1b4bdc62" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of each friendly turn, roll a D6 for each vehicle with an automated repair system that has suffered an Immobilised or Weapon Destroyed result. On a 6, one such result of the owning player&apos;s choice is repaired. Note, this does not restore any Hull Points.</characteristic>
      </characteristics>
    </profile>
    <profile name="Blacksun Filter" id="31fbbe6a-8a4e-346e-2dc4-ab2dc1613f82" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Night Vision and is immune to the effects of Blind.</characteristic>
      </characteristics>
