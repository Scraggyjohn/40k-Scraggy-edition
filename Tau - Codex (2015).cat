    </selectionEntry>
    <selectionEntry name="Ranged Support Cadre" id="3541-3bf1-ee2c-0e5a" collective="false" hidden="false" import="true" page="74" publicationId="24a0-49b6-pubN65836" type="unit">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="3541-3bf1-ee2c-0e5a-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Dedicated Spotting Teams" id="18db-8eb3-c487-0a13" hidden="false">
          <description>Double the value of any markerlight counters placed by any of this Formation&apos;s Pathfinders if the counter is used by any of this Formation&apos;s Broadside units.</description>
        </rule>
        <rule name="Hidden Observers" id="ae2d-302d-5cec-9a60" hidden="false">
          <description>All Pathfinder Teams in the formation have the Infiltrate and Shrouded special rules. The Shrouded special rule is lost immediately by any unit that moves from its starting location (for any reason), and by any unit that makes an attack with anything other than its markerlights.</description>
        </rule>
        <rule name="Dedicated Support Units" id="af35-1f98-65d1-eb28" hidden="false">
          <description>The Broadside units in this Formation can provide Supporting Fire for the Pathfinder Teams in this Formation at any range, as long as it does not exceed their weapon&apos;s maximum range.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Pathfinders - 3 required" id="e5bf-2eb4-632f-c5e2" collective="false" defaultSelectionEntryId="f22d-cdfe-8e04-b394" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="3"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
          <entryLinks>
