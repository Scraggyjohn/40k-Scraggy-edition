      <profiles>
        <profile name="Warscaper Drone" id="6045-9e1c-e8fa-b916" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Nominate a Drone purchased by the character from the Drones list - this is a Warscaper Drone in addition to its usual type. All models in the same unit as the Warscaper Drone have the Move Through Cover, Outflank and Acute Senses special rules. Furthermore, any enemy unit that is both outside of its deployment zone and within 12&quot; of a Warscaper Drone treats difficult terrain as dangerous terrain.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
