        <rule name="Rapid Deployment" id="0200facd-abb9-1c44-036a-201a102c39f5" hidden="false" page="85" publicationId="24a0-49b6-pubN67347">
          <description>All models in the cadre count as having the Scout special rule if they do not already do so.</description>
        </rule>
        <rule name="Marked for Destruction" id="59519ff2-f2d8-9362-0d9a-867132dc91cf" hidden="false" page="85" publicationId="24a0-49b6-pubN67347">
          <description>While the Command Devilfish is still mobile, it may coordinate the cadre&apos;s attacks to eliminate strategically valuable targets. Pick a single enemy target model or unit each turn: no models in the Search and Destroy Cadre need to pass a Targeting Priority roll to attack it this turn.</description>
        </rule>
      </rules>
