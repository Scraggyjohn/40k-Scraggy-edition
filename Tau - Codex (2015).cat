    <selectionEntry name="The Mirrorcodex" id="d3da-a4e7-0471-1f1e" collective="false" hidden="false" import="true" page="85" publicationId="24a0-49b6-pubN65836" type="upgrade">
      <constraints>
        <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
        <constraint id="maxInRoster" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="50"/>
      </costs>
      <infoLinks>
        <infoLink name="Preferred Enemy" id="75f7-0204-e895-5c80" hidden="false" targetId="f217-b311-e5b1-c8c7" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="The Mirrorcodex" id="f987-1f7f-25a2-81bd" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model in your army has the Mirrorcodex, you can add 1 to your dice roll when Seizing the Initiative. Furthermore, if a model in your army is bearing the Mirrorcodex, roll a D6 at the beginning of each of your turns and consult the table below. The effects listed affect the bearer and all friendly units within 6&quot;, and last until the end of the turn.   1-3    No Effect  4       Preferred Enemy (Space Marines)  5       Preferred Enemy (Space Marines and Astra Militarum)  6       Preferred Enemy</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Tidewall Counterstrike Cadre" id="895f-f16f-d37f-a520" collective="false" hidden="false" import="true" publicationId="24a0-49b6-pubN123620" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Defensive Fusillade" id="bde2-4715-64db-8349" hidden="false">
          <description>If a model from a Breacher Team in a Tidewall Counterstrike Cadre is on a Tidewall Shieldline from its Formation when it shoots, use the Pulse Blaster&apos;s &quot;up to 5 inches&quot; profile for enemies up to 10&quot; away, and the &quot;5-10 inches&quot; profile for enemies up to 15&quot; away.</description>
        </rule>
        <rule name="Precision Sweep" id="a5ec-9619-c818-555c" hidden="false">
          <description>Models from the Strike Team in a Tidewall Counterstrike Cadre can re-roll failed to-hit rolls whilst on a Tidewall Gunrig or Droneport from their Formation.</description>
        </rule>
        <rule name="Rapid Advance" id="f703-902d-0755-b2f6" hidden="false">
          <description>Tidewall fortifications from a Tidewall Counterstrike Cadre can move up to 9&quot; in their Movement phase so long as they end their move closer to the Pathfinder Team from the same Formation.</description>
        </rule>
        <rule name="Tidewall Counterstrike Cadre (Restriction)" id="2582-378f-9258-986b" hidden="false">
          <description>Units in this Formation may not take Dedicated Transports. When deploying the Tidewall fortifications from this Formation, each Gunrig and Shieldline must be within 6&quot; of the Droneport. If you wish to move the Tidewall Defense Network, this restriction must still be met once each element has moved.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Pathfinders - 1 required w/o transport" id="eec3-f8e8-1b20-e757" collective="false" defaultSelectionEntryId="e2f5-97b0-ede6-6b65" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <entryLinks>
