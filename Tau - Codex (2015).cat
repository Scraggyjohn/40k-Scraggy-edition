    <selectionEntry name="Rapid Insertion Force" id="8aed-5435-9d49-3e8b" collective="false" hidden="false" import="true" page="73" publicationId="24a0-49b6-pubN65836" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Locked Coordinates" id="954b-7982-7e0f-338b" hidden="false">
          <description>The Stealth Battlesuits in the Rapid Insertion Force must begin the game deployed on the battlefield. The rest of the forces in the Formation must be held in Reserve and arrive by Deep Strike. Any Crisis Battlesuits or Riptides from the Formation that choose to Deep Strike within 6&quot; of this unit of Stealth Battlesuits do not scatter, and count all their weapons as Twin-linked in the ensuing Shooting phase.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Stealth Team - 1 required" id="3ea0-0c47-fa1c-7f57" collective="false" defaultSelectionEntryId="5d04-bef8-9723-a7b0" hidden="false" import="true">
