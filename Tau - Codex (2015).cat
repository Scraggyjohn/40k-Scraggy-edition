    <selectionEntry name="Kroot Hunting Pack" id="06d06089-6d2f-ef60-3bc3-bdd12d41dcdf" collective="false" hidden="false" import="true" page="179" publicationId="24a0-49b6-pubN67895" type="upgrade">
