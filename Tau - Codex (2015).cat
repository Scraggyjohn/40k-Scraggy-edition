    <selectionEntry name="Paradox Squadron" id="d0ea-ad58-634a-4cf6" collective="false" hidden="false" import="true" page="60" publicationId="24a0-49b6-pubN67769" type="upgrade">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="d0ea-ad58-634a-4cf6-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="Paradox Attack" id="93f9-2d39-f98d-075d" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">D</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Large Blast, Paradox</characteristic>
            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Paradox" id="533a-33b9-9b16-faf9" hidden="false">
          <description>Rolls of 1 on the Destroyer Weapon Attack table result in the model being attacked recovering any Wounds or Hull Points it had lost earlier in the battle, instead of having the usual effects.</description>
        </rule>
        <rule name="Paradox Attack" id="0c66-abbc-25a9-d139" hidden="false">
          <description>If the formation is in Arrowhead Attack Pattern and has three or more pulse bombs, one Flyer in the formation may make a single Bombing Run using the following profile. No other Flyer from the formation may make a Bombing Run in the same phase, and all of the Flyers in the formation are considered to have used their pulse bombs after the attack has been made (roll as normal to see if they generate new ones).</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Bombers - 3 to 5 required" id="02c1-20bd-1f4b-b4b2" collective="false" defaultSelectionEntryId="0433-5853-7336-0edf" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="3"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="5"/>
          </constraints>
          <entryLinks>
            <entryLink name="AX39 Sun Shark Bomber" id="0433-5853-7336-0edf" collective="false" hidden="false" import="true" targetId="37423448-21bf-e3ff-cb66-f2cbbb21fe3a" type="selectionEntry"/>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Pathfinder Search and Destroy Cadre" id="d7547c93-858b-86fa-50fb-960f3b7bab8c" collective="false" hidden="false" import="true" page="85" publicationId="24a0-49b6-pubN67347" type="upgrade">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="d7547c93-858b-86fa-50fb-960f3b7bab8c-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
