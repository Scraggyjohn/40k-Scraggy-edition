    <selectionEntry name="Hammerhead Interdiction Cadre" id="f5bb-43b1-6188-db51" collective="false" hidden="false" import="true" page="59" publicationId="24a0-49b6-pubN67769" type="upgrade">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="f5bb-43b1-6188-db51-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Markerlight Targeting Array" id="1226-ee97-9411-c6b9" hidden="false">
          <description>As long as the Command Vehicle of this formation has not been wrecked or suffererd an Explodes! result, the Tau Empire player gains D3+1 markerlight counters per turn. These are placed at the start of the Tau Empire Shooting phase on any enemy unit within line of sight of the Command Vehicle.</description>
        </rule>
      </rules>
