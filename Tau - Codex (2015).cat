      <rules>
        <rule name="Command Override" id="7656-fc04-49b6-1808" hidden="false">
          <description>Sky Ray Gunships within 12&quot; of the Formation&apos;s Devilfish in the Shooting Phase can fire any number of their remaining seeker missiles.</description>
        </rule>
        <rule name="Early Warning" id="d17c-c9eb-fa16-41ee" hidden="false">
          <description>As long as the Devilfish is not destroyed, all units in the Skysweep Missile Defense formation recieve a 5+ cover save against shooting attacks made by enemy Flyers, Super-heavy Flyers, Flying Monstrous Creatures and Flying Gargantuan Creatures.</description>
        </rule>
      </rules>
