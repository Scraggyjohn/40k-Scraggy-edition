            <entryLink name="Commander Farsight" id="4d4733e1-bd80-9f96-9f60-b7983916ec3d" collective="false" hidden="false" import="true" targetId="85da10b2-7258-4956-8129-7cf94ff97e16" type="selectionEntry"/>
            <entryLink name="Commander R&apos;alai [FW]" id="d221d90f-562e-7f51-2a65-8c1b35b5ea6c" collective="false" hidden="false" import="true" targetId="f76ebd89-ec8b-2586-182e-9bd08675426b" type="selectionEntry"/>
            <entryLink name="Commander Shadowsun" id="38ef4cb2-afd2-395b-3702-f9f41afb8e86" collective="false" hidden="false" import="true" targetId="c82e082e-b355-47ec-8438-9ffe255d4f20" type="selectionEntry"/>
