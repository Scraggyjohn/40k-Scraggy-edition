          </costs>
          <infoLinks>
            <infoLink name="Smart Missile System" id="a435-e984-e75f-ad95" hidden="false" targetId="81a25964-dcbc-15ae-aba4-f128872da8f2" type="profile"/>
            <infoLink name="Burst Cannon" id="0b18-66f6-2970-cbd0" hidden="false" targetId="098adddb-eedc-e062-e858-2e34ca7a7ef6" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Vigilance Defence System" id="faba-8068-4a5a-a53e" hidden="false" publicationId="24a0-49b6-pubN79550" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vigilance defence system comprises two smart missile systems and two twin-linked burst cannon which may be fired normally. In addition, these weapons can be used to make Overwatch attacks at BS2 contrary to the usual rules for Gargantuan Creatures.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Barrier Shield Generator" id="1b39-6ef1-c33d-5acd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Barrier Shield Generator" id="73f2-d10b-2c91-af64" hidden="false" publicationId="24a0-49b6-pubN99881" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The barrier shield provides a 5+ invulnerable save, increasing to 4+ save against Shooting attacks. When a model with a barrier shield is struck by a Destroyer attack and &apos;Deathblow&apos; result occurs, the amount of wounds inflicted is halved but the shield stops working until the start of the controlling player&apos;s next turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
