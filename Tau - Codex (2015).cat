    <selectionEntry name="Tidewall Defence Network" id="5dff-af07-1b47-3871" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Indomitable Position" id="4347-fd1b-5e54-12d2" hidden="false">
          <description>Models with the Tau Empire Faction have the Stubborn special rule whilst on a Tidewall Shieldline from a Tidewall Defence Network.</description>
        </rule>
        <rule name="Information Relay" id="d397-828d-998e-a731" hidden="false">
          <description>Models with the Tau Empire Faction on a Tidewall Shieldline from a Tidewall Defence Network can operate the railgun or activate the Drones on its central platform.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Shieldlines - 4 required" id="ae1d-06cc-c8aa-8eac" collective="false" defaultSelectionEntryId="1bb9-ecd5-b011-53dd" hidden="false" import="true">
