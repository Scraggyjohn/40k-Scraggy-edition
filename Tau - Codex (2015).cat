    <selectionEntry name="Ethereal Council" id="27c6-a68c-f511-3b40" collective="false" hidden="false" import="true" page="78" publicationId="24a0-49b6-pubN65836" type="unit">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="27c6-a68c-f511-3b40-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Fearless" id="3178-f745-d7bb-dfb4" hidden="false" targetId="8d37-2e47-4a04-58f7" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Fanatical Fervour" id="e793-5753-79b2-aea7" hidden="false">
          <description>The range of the Failure Is Not An Option special rule is increased from 12&quot; to 24&quot; for all of the models in the Ethereal Council that have the rule.</description>
        </rule>
        <rule name="Collective Elemental Power" id="9caf-7007-0b76-50b5" hidden="false">
          <description>As long as the Ethereal Council has at least 2 members, it invokes all four elemental powers each turn instead of only one power per member. The Ethereal Council, and all friendly non-vehicle units that have the Tau Empire Faction within 12&quot; of it, benefit from the effects of all four elemental powers until the start of the Council&apos;s next Movement phase.</description>
        </rule>
        <rule name="United Council" id="08d8-4dfe-d56f-12a2" hidden="false">
          <description>The members of the Ethereal Council form a single unit, and are treated as Characters rather than Independent Characters as long as at least 2 members of the council remain alive.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Ethereals" id="ad04-ceed-600b-9546" collective="false" defaultSelectionEntryId="00b0-a81e-1f60-5572" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="3"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="7"/>
          </constraints>
          <entryLinks>
