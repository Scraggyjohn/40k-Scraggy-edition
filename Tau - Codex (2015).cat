    <profile name="Point Defense Targeting Relay" id="15eadab0-2d20-42ad-5a5c-9c282ae2412f" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle can fire Overwatch with weapopns of Strength 5 or less. Attached drones may also fire Overwatch with weapons of Strength 5 or less. In addition, the vehicle has the Supporting Fire special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Positional Relay" id="4399fd29-0e42-7362-a9bf-e1231412fe4e" hidden="false" page="69" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Whilst the bearer is within 6&quot; of a board edge, any friendly unit with the Tau Empire Faction that arrives from Reserve using the Outflank special rule, can choose to move on from that board edge (even if it is your, or your opponent&apos;s board edge).</characteristic>
      </characteristics>
    </profile>
