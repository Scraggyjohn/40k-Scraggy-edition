      <rules>
        <rule name="Ideal Mission Commander" id="38dc-c0f5-b97f-d276" hidden="false" page="198" publicationId="24a0-49b6-pubN65836">
          <description>If this Detachment is your Primary Detachment, you can choose to re-roll the result on the Warlord Traits table.</description>
        </rule>
        <rule name="Killing Blow" id="8135-e388-0523-6912" hidden="false" page="198" publicationId="24a0-49b6-pubN65836">
          <description>At the start of each enemy turn, secretly record the identity of one enemy unit. At the start of your turn, reveal which unit it was that you picked. You can re-roll failed To Wound and Armour Penetration rolls against that unit for the rest of your turn.</description>
        </rule>
      </rules>
    </forceEntry>
