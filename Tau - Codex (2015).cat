    <selectionEntry name="Heavy Retribution Cadre" id="3104-8758-a1f1-50d9" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Monsoon of Destruction" id="b535-10ae-99a4-7539" hidden="false">
          <description>If an enemy unit is chosen as the target by at least two units from this Formation in the same shooting phase, that unit cannot Run or move Flat Out in their next turn. In addition, such units must halve the result of any Charge rolls they make in the next turn (rounding fractions down).</description>
        </rule>
        <rule name="Optimum Fire Position" id="c924-0304-af63-6e09" hidden="false">
          <description>You can re-roll failed To Hit rolls for shooting attacks made by Stormsurges from this Formation if the target unit is within 12&quot; of a Ghostkeel Battlesuit from this Formation.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Ghostkeels - 1 required" id="c754-971b-4bd0-3328" collective="false" defaultSelectionEntryId="d39e-5757-7d29-2d5c" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink name="XV95 Ghostkeel Battlesuits" id="d39e-5757-7d29-2d5c" collective="false" hidden="false" import="true" targetId="30c7-d50a-37d8-3e4f" type="selectionEntry"/>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Stormsurges - 2 required" id="a95a-eb08-b3a1-9392" collective="false" defaultSelectionEntryId="9b00-b409-c8c8-cd5e" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="2"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="2"/>
          </constraints>
          <entryLinks>
            <entryLink name="KV128 Stormsurges" id="9b00-b409-c8c8-cd5e" collective="false" hidden="false" import="true" targetId="ab5b-128e-ccce-4ea0" type="selectionEntry"/>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Hunter Cadre" id="e1fc-abb7-7061-fad8" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Unbreakable Bonds of Comradeship" id="156a-6d2f-6abf-4f6a" hidden="false">
          <description>Units from this Formation that have the Supporting Fire special rule can provide Supporting Fire to any other model in this Formation if they are within 12&quot; of each other, rather than 6&quot;.</description>
        </rule>
        <rule name="Ambushes and Feints" id="f2a8-d1de-257d-93ce" hidden="false">
          <description>Units from this Formation that are within 12&quot; of this Formation&apos;s Commander or Cadre Fireblade at the start of the Shooting phase can Run or move Flat Out and then shoot in that Shooting Phase. Each unit must complete both actions before you move onto the next unit - otherwise the chance to make the second action is forfeit.</description>
        </rule>
      </rules>
      <selectionEntries>
