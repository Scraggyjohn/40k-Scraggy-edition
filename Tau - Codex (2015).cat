            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">5+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Supreme Loyalty" id="0336-04da-735d-2937" hidden="false">
          <description>While Aun&apos;Va is alive, all friendly units with the Tau Empire Faction on the battlefield re-roll failed Fear, Morale, Pinning and Regroup tests.</description>
        </rule>
        <rule name="Great Invocation" id="9014-ee90-68a8-7006" hidden="false">
          <description>When using Invocation of the Elements special rule, Aun&apos;Va invokes up to two elemental powers per turn, instead of just one.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="The Paradox of Duality" id="f58f60b3-9968-29a9-04b7-5c33f8e980c8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="The Paradox of Duality" id="1069-299b-3fb7-b3e2" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Whenever Aun&apos;Va&apos;s unit suffers one or more unsaved Wounds from a shooting attack, roll a D6. If the result is equal to or higher than the AP of the shot, the Wound is discounted, exactly as if a cover save had been passed (Wounds from AP1 weapons are therefore automatically discounted). This roll cannot be made against weapons with AP-.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
