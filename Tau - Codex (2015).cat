            </profile>
            <profile name="Ionic Discharge Cannon (Nova)" id="422c-3bcd-316f-3af0" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
