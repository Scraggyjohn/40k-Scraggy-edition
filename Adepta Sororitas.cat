                        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">2</characteristic>
                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 1, Fleshbane, Rad-phage</characteristic>
                        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Rad-phage" id="aef4-7205-c36d-d16e" hidden="false">
                      <description>A model which loses one or more wounds to an attack with this special rule and survives has its Toughness value reduced by -1 for the rest of the battle.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
