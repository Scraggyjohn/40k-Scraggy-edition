            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
          </characteristics>
        </profile>
        <profile name="The Ardent Blade (Ranged)" id="3d1f-fcf8-bf85-1bf1" hidden="false" page="0" publicationId="818a0a0f--pubN68426" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
