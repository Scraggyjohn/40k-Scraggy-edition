          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Flank Speed" id="1870-1bf6-20da-7828" hidden="false" page="0" publicationId="818a0a0f--pubN85253">
          <description>If the Cerastus Knight-Lancer opts to make a Run move rather than firing a weapon in the Shooting phase, it may move 3D6&quot;.</description>
        </rule>
      </rules>
