          <profiles>
            <profile name="Blazing Weapons" id="57ef-ada0-cf89-5beb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Cypher can fire both of his weapons, even before or after running. He also fires Overwatch on full ballistic skill. In addition, half (rounded up) of his Melee attacks are resolved at S4, AP5 and the remaining at S7, AP2.</characteristic>
              </characteristics>
