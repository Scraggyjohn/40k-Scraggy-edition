                <profile name="Hellfury Missile" id="3671-d496-c45e-d9e3" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">72&quot;</characteristic>
                    <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
                    <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Large Blast, No Cover Saves, Missile, One Use Only</characteristic>
                    <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
