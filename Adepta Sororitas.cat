          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Flank Speed" id="2983-baec-957d-467d" hidden="false" page="0" publicationId="818a0a0f--pubN85253">
          <description>May Run 3D6&quot; instead of shooting</description>
        </rule>
      </rules>
      <selectionEntries>
