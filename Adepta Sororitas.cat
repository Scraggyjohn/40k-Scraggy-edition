      <profiles>
        <profile name="Uriah Jacobus" id="9634-97d8-40ca-7a22" hidden="false" page="0" publicationId="818a0a0f--pubN68426" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic>
