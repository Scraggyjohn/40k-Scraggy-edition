      </infoLinks>
      <rules>
        <rule name="Macabre Collectors" id="c832ffa2-28ae-e282-f067-29988d1b0fc4" hidden="false">
          <description>All units of Wracks from this Formation that are within 12&quot; of this Formation&apos;s Haemonculus have the Precision Strikes special rule.</description>
        </rule>
        <rule name="Master of Epicureans" id="b7dab4a4-4dd0-3ee7-067b-651bb30ea98e" hidden="false">
          <description>The units of Wracks in this Formation treat the current turn as being one higher than it actually is when determining what special rules they benefit from as the result of the Power from Pain special rule. This is cumulative with the Master of Pain or Father of Pain special rules.</description>
        </rule>
      </rules>
