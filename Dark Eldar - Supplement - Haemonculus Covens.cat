      <rules>
        <rule name="Lord of Pain" id="da572b22-c90c-d54f-3bfa-833c469ea5da" hidden="false">
          <description>As long as Urien Rakarth (or the Haemonculus from the Grotesquerie Formation) is alive, his Father/Master of Pain special rule affects all non-vehicle units in this Formation.</description>
        </rule>
        <rule name="The Torturer&apos;s Art" id="09fd4bc8-299e-de6c-7fa7-80f5bbbc08a2" hidden="false">
          <description>All non-vehicle models from the Carnival of Pain re-roll failed To Wound rolls of a 1 in close combat.</description>
        </rule>
      </rules>
