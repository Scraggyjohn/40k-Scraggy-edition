    <selectionEntry name="Formation: Corpsethief Claw" id="11ed381a-557c-9bfb-4235-248d016422a0" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Formation" id="11ed381a-557c-9bfb-4235-248d016422a0-28b94f51-e66b-4096-aa59-0c9df620a77d" hidden="false" primary="true" targetId="28b94f51-e66b-4096-aa59-0c9df620a77d"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Freakish Spectacle" id="71e8c2ea-a91d-ffee-ef6f-7b246641867b" hidden="false" targetId="9addafac-476c-1d71-2a6a-1f863bd67388" type="rule"/>
        <infoLink name="Scout" id="2fde5ab0-413b-bc06-3086-af460c6850d5" hidden="false" targetId="1794-e0e0-bedf-e46b" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Let the Harvest Begin" id="6823475d-595a-0c49-0873-7c903cf6353e" hidden="false">
          <description>Each time a unit from this Formation completely destroys an enemy non-vehicle unit in close combat, the controlling player scores 1 Victory Point. In missions where players earn Victory Points for completely destroying enemy units, the controlling player will score 1 additional Victory Point each time a unit from this Formation completely destroys an enemy non-vehicle unit in close combat.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
