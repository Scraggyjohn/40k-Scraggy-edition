        <categoryLink name="Fortification" id="f68f-89dc-76d2-7e00-d713cda3-5d0f-40d8-b621-69233263ec2a" hidden="false" primary="false" targetId="d713cda3-5d0f-40d8-b621-69233263ec2a">
          <constraints>
            <constraint id="b713-9cb4-79a0-ac54" field="selections" includeChildForces="true" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
