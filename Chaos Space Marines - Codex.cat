      </modifiers>
      <profiles>
        <profile name="Seer&apos;s Bane" id="f75b-b561-f2bb-59a8" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Bane of Wisdom, Daemon Weapon, Force</characteristic>
            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Bane of Wisdom" id="d1aa-893f-74ca-f092" hidden="false">
          <description>Against non-vehicle targets, the S value of the Seer&apos;s Bane is equal to the bearer&apos;s Leadership characteristic, and all To Wound rolls are made against the target&apos;s Leadership characteristic instead of their Toughness. However, use the target&apos;s Toughness values as normal for determining whether or not the Seer&apos;s Bane inflicts Instant Death</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Helm of the Third Eye" id="1e5a-09d8-daa1-d0b7" collective="false" hidden="true" import="true" type="upgrade">
      <constraints>
        <constraint id="e029-2ea7-63df-f8e4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
