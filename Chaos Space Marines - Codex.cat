      </profiles>
      <rules>
        <rule name="Repelling Sweep" id="7836-e8a1-2e7f-2c5c" hidden="false">
          <description>Enemy units attempting ot charge the bearer or his unit must subtract 2 from their charge roll.</description>
        </rule>
      </rules>
    </selectionEntry>
