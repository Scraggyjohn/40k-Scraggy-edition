          </constraints>
        </categoryLink>
        <categoryLink name="Command" id="1d27-88dc-b936-fb22-9050-d437-3301-7e42" hidden="false" primary="false" targetId="9050-d437-3301-7e42">
          <constraints>
            <constraint id="da0e-a992-0a17-4d2a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="4"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Auxiliary" id="1d27-88dc-b936-fb22-ef2b-83bd-1bad-5742" hidden="false" primary="false" targetId="ef2b-83bd-1bad-5742">
          <constraints>
            <constraint id="af8f-323f-3e30-d2df" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
          </constraints>
        </categoryLink>
      </categoryLinks>
      <rules>
        <rule name="Berzerker Lord" id="1c47-18ce-3e91-c287" hidden="false">
          <description>If this Detachment is your Primary Detachment, you can re-roll the result when rolling on the World Eaters Warlord Traits table.</description>
        </rule>
        <rule name="Blood Mad" id="5a2b-26a2-3bf4-c2ba" hidden="false">
          <description>After both sides have deployed (including Infiltrators), but before the first player begins their first turn, all non-vehicle units comprised entirely of models from this Detachment can immediately make a 2D6&quot; move (roll separately for each unit). In addition, non-vehicle units and Walkers from this Detachment can re-roll failed charge rolls they make during the battle.</description>
        </rule>
      </rules>
    </forceEntry>
  </forceEntries>
