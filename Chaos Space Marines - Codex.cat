      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="The Chosen of Abaddon (Apocalypse)" id="c086-3c8d-92f5-5490" collective="false" hidden="false" import="true" publicationId="5af86795--pubN136352" type="upgrade">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="c086-3c8d-92f5-5490-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Blessed by the Chaos Gods" id="be06-6bd2-ffbb-9a68" hidden="false">
          <description>Each Lord or sorceror starts the battle with 1 chaos boon. Roll separately for each character.</description>
        </rule>
        <rule name="Protect the Despoiler" id="1db7-1720-cef0-7994" hidden="false">
          <description>Any unit in this formation within 12&quot; of Abaddon gets Fearless.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
