        </rule>
        <rule name="Disgustingly Resilient" id="6906-1071-76c7-70e5" hidden="false">
          <description>Units from this Detachment can re-roll FNP rolls of 1.</description>
        </rule>
        <rule name="Cloud of Flies" id="7d66-6e2a-4520-0ebb" hidden="false">
          <description>If an enemy unit targets a unit from this Detachment that is 18&quot; or more away, the target unit has the Stealth special rule while that attack is resolved.</description>
        </rule>
      </rules>
