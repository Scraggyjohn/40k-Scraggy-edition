              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Let Slip the Hounds" id="c4be-38f8-518e-85bc" hidden="false">
          <description>Once per game, at the start of any of your turns after the first, you can declare a massed assault. For the duration of that turn, units from this Formation can charge in the Assault phase even if they made a Run move in the same turn.</description>
        </rule>
        <rule name="Khorne&apos;s Favor" id="f2b3-95ca-171f-81ae" hidden="false">
          <description>If a unit from this Formation makes a successful charge and the total rolled for its charge range is 8 or more (before modifiers), add 1 to the Strength of its models until the end of the Assault phase.</description>
        </rule>
        <rule name="The Hounds of Abaddon" id="7521-9dca-5791-f6b3" hidden="false">
          <description>Any unit that has the option to take a Mark of Khorne must do so, but at no additional points cost.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="1-3 Khorne Berzerkers" id="77fb-8c47-e82c-ef4c" collective="false" defaultSelectionEntryId="08c6-8059-3702-c809" hidden="false" import="true">
