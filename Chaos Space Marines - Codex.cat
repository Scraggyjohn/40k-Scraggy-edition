      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="70b1-2164-14ed-1d31" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Without Equal" id="316a-48bc-4305-c6b3" hidden="false">
          <description>Chaos Terminators that are part of this Formation (including the Terminator Champion) have a WS and BS of 5 rather than 4.</description>
        </rule>
        <rule name="The Despoiler&apos;s Guard" id="556b-30ca-10e1-c462" hidden="false">
          <description>While Abaddon the Despoiler is joined to the unit of Chaos Terminators from this Formation, you can re-roll one Look Out, Sir roll for him in each phase.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Abaddon" id="29cf-7f2f-7077-247c" collective="false" defaultSelectionEntryId="d8c2-bdd5-4168-e25a" hidden="false" import="true">
