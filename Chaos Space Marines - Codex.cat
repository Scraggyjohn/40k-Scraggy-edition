      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="Legacies of Ruin: Fourth Quadrant Rebellion" id="8d49ee23-7943-37cd-eeae-86f1c61f42d7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units of Cultists within 12&quot; are Fearless. When the vehicle has 1 Hull Point remaining, it gains a 4+ Invunerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
