        </modifier>
      </modifiers>
      <rules>
        <rule name="Sight of the Third Eye" id="77d2-2012-8c40-57c6" hidden="false">
          <description>If the Chosen Champion from Draznicht&apos;s Ravagers is alive at the start of your turn, you can pick one of the units from the Formation to benefit from his prescience. For the duration of your turn, that unit can re-roll all failed To Hit rolls.</description>
        </rule>
      </rules>
