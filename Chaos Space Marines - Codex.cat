    <selectionEntry name="Seer&apos;s Bane" id="4742-b01e-2efc-4b59" collective="false" hidden="true" import="true" type="upgrade">
      <constraints>
        <constraint id="ba34-2be5-8106-61ea" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
