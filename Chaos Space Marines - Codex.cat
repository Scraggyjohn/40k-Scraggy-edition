    <selectionEntry name="Favoured of Chaos" id="4454-be9a-5d49-12d4" collective="false" hidden="true" import="true" page="127" publicationId="5af86795--pubN180378" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="2ea0-9eab-fa80-66b9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Baleful Nexus of Warp Energies" id="abdd-1756-842c-609e" hidden="false">
          <description>Units of Possessed from the Favoured of Chaos that are within 12&quot; of their Daemon Prince at the start of their Fight sub-phase receive the benefit of all three Mutations from their Mutation table, rather than only one.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Daemon Prince" id="3f3b-78d6-7758-0ae9" collective="false" defaultSelectionEntryId="34a9-3105-0714-0053" hidden="false" import="true">
