        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Daemonic Possession" id="4b6b68dc-57e9-3eca-a948-e56e5b1647a9" hidden="false" targetId="41d92af2-6429-c745-dbae-fef1ccbe7878" type="profile"/>
        <infoLink name="Fear" id="81c2-73d6-65f9-f508" hidden="false" targetId="280d-1a0c-5916-3012" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Legacy of Ruin: Auloth the Primordial Iterator" id="188197d1-55b3-ccb5-578c-fe7cba13d6a3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Has Fear. All weapons have Pinning. All friendly units with an Icon of wrath within 12&quot; have the fear and Feel no Pain special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Legacy of Ruin: Badab Uprising" id="3724d23d-156b-7c0f-54af-c93695e8e9d5" collective="false" hidden="false" import="true" type="upgrade">
