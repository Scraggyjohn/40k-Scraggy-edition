      <rules>
        <rule name="Avaricious Vigour" id="ef9f-bf8d-e22a-652b" hidden="false">
          <description>Tzaangor units from this Formation can Run and charge in the same turn. In addition, if a charging Tzaangor unit rolls 9 or more for its charge roll add +1 S and +1 I in the ensuing Fight sub-phase.</description>
        </rule>
      </rules>
