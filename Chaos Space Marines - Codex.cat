          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Helm of the Third Eye" id="84e9-9fc4-2ce7-29d0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The wearer and any unit he joins can fire Overwatch even if they have the Slow and Purposeful special rule. Units that do not have the Slow and Purposeful special rule can instead fire Overwatch at BS2.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
