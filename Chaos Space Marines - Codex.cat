        </categoryLink>
      </categoryLinks>
      <rules>
        <rule name="Salt the Earth" id="3289-46ed-794a-cc6c" hidden="false">
          <description>When a model from this Detachment fires a Barrage weapon with the Blast type, leave the template in place after resolving all damage from the attack until the beginning of the controlling player&apos;s next turn. The area under the template is considered dangerous terrain by all models.</description>
        </rule>
        <rule name="Forbidden Munitions" id="2caa-9a4f-c6ca-f2f2" hidden="false">
          <description>Any friendly unit in the army equipped with flamers or heavy flamers may be upgraded to be equipped with chemical flamers for free, and any model equipped with a missile launcher may take chemical rockets as a free upgrade.</description>
        </rule>
      </rules>
    </forceEntry>
    <forceEntry name="CSM Thousand Sons Grand Coven" id="98f7-97a3-da5c-70c6" hidden="false">
      <categoryLinks>
        <categoryLink name="Core" id="98f7-97a3-da5c-70c6-bf93-7277-bf48-16f7" hidden="false" primary="false" targetId="bf93-7277-bf48-16f7">
          <constraints>
            <constraint id="2577-ad6b-c0ad-1f3a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Command" id="98f7-97a3-da5c-70c6-9050-d437-3301-7e42" hidden="false" primary="false" targetId="9050-d437-3301-7e42">
          <constraints>
            <constraint id="e72e-2022-0621-e9cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="4"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Auxiliary" id="98f7-97a3-da5c-70c6-ef2b-83bd-1bad-5742" hidden="false" primary="false" targetId="ef2b-83bd-1bad-5742">
          <constraints>
            <constraint id="3ddd-91aa-f16f-6364" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
          </constraints>
        </categoryLink>
      </categoryLinks>
      <rules>
        <rule name="Lord of Fallen Prospero" id="951d-7da4-b4ce-5adc" hidden="false">
          <description>If this Detachment is your Primary Detachment, you can re-roll the result when rolling on the Thousand Sons Warlord Traits table.</description>
        </rule>
        <rule name="Masters of Arcane Knowledge" id="8fc4-bc0c-45e0-197c" hidden="false">
          <description>If a Psyker from this Detachment suffers Perils of the Warp, you can choose to re-roll the result. In addition, Psykers from this Detachment can attempt to manifest one additional psychic power in each Psychic phase. For example, a Psyker with a ML of 3 could attempt to manifest 4 psychic powers.</description>
        </rule>
      </rules>
    </forceEntry>
    <forceEntry name="CSM Word Bearers Grand Host" id="6cf2-f751-e19f-f386" hidden="false">
      <categoryLinks>
        <categoryLink name="Core" id="6cf2-f751-e19f-f386-bf93-7277-bf48-16f7" hidden="false" primary="false" targetId="bf93-7277-bf48-16f7">
