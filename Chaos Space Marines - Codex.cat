        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Chaos Warband" id="6bc4-1215-355d-72b6" collective="false" hidden="false" import="true" page="118" publicationId="5af86795--pubN180378" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Favoured Scions" id="7ba1-ee2a-4694-74ea" hidden="false">
          <description>When a model from a Chaos Warband earns a roll on the Chaos Boon table as a result of the Champion of Chaos special rule, roll twice on the table and choose either one or both of the results.</description>
        </rule>
        <rule name="Objective Secured" id="c061-d3bb-0a49-0acb" hidden="false">
          <description>All units in a Chaos Warband have this special rule and will control objectives even if an enemy scoring unit is within range of the Objective Marker, unless the enemy unit also has this special rule.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
