    <selectionEntry name="Fist of the Gods" id="5792-6a7d-3f61-a09e" collective="false" hidden="false" import="true" page="124" publicationId="5af86795--pubN180378" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Dark Wards" id="92be-1639-16e7-0a09" hidden="false">
          <description>All vehicles form the Fist of the Gods have a 6++ save whilst they are within 12&quot; of their Warpsmith.</description>
        </rule>
        <rule name="Unholy Blessings" id="6a9f-e2fd-71c0-cd56" hidden="false">
          <description>The Warpsmith from this Formation has a +1 bonus when making attempts to repair a vehicle from its Formation.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Warpsmith" id="bce8-2f48-b8c3-61d5" collective="false" defaultSelectionEntryId="489a-5f4d-6e57-3bb6" hidden="false" import="true">
