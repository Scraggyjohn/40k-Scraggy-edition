    <selectionEntry name="The Balestar of Mannon" id="6fc37ffe-53d8-156a-be35-9d85282e4005" collective="false" hidden="true" import="true" publicationId="5af86795--pubN112041" type="upgrade">
      <constraints>
        <constraint id="maxInRoster" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
