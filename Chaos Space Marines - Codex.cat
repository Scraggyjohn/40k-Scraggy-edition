          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Vehicle/Super-Heavy Vehicle: Gains Fear and Preferred Enemy (Space Marines) Walker: Gains Rage and Hatred (Chaos Space Marines)</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Legacy of Ruin: Blood of Mackan" id="ddde490e-0924-a162-a9d1-e2ff4eca6048" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="maxInRoster" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
        <constraint id="30d6-9363-1ea5-58b1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="Legacies of Ruin: Blood of Mackan" id="1cca0062-e1a7-794b-a4d0-2eebba9499d9" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains Preferred Enemy (Blood Angels) and doesn&apos;t treat defence lines and barricades as Dangerous Terrain.  If the vehicle is fitted with Destroyer Blades, the damage inflicted from a Tank Shock attack (after Death or Glory) has an AP value equal to the number of Hull Points left (with over 6 being &quot;-&quot;)</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Legacy of Ruin: Death of Kasyr Lutien" id="9e850255-4e7d-0403-5c7d-57bca88757b3" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="maxInRoster" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
        <constraint id="4a75-1ea7-d9a7-6718" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="Legacies of Ruin: Death of Kasyr Lutien" id="5e433c24-1133-7e85-b16c-11f0081a4ab6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Vehicle gains the fear special rule. In addition, when psychic tests to use Maelific powers are made by friendly psykers within 12&quot;, one D6 may be re-rolled for every Hull Point remaining.   If the test is failed, the vehicle suffers a penetrating hit in addition to the normal psyker consquences.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Legacy of Ruin: First War of Armageddon" id="7ad80394-82e9-e84b-a546-6ba0f9f8ca9d" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
