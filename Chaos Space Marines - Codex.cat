    <selectionEntry name="Brethren of the Dark Covenant" id="26ab-2a98-6e0c-9af6" collective="false" hidden="true" import="true" publicationId="5af86795--pubN112041" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Zealot" id="bf04-f1c3-92d2-19a2" hidden="false" targetId="6fc0-ebe5-6c64-7c9f" type="rule"/>
