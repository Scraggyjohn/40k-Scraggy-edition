        </rule>
        <rule name="Thirst for Glory" id="5244-efd0-57b1-7862" hidden="false">
          <description>If an enemy unit is completely destroyed by a unit from a Black Legion Warband, all other units from teh same Black Legion Warband can re-roll To Hit and To Wound rolls of 1 until the end of the phase.</description>
        </rule>
      </rules>
