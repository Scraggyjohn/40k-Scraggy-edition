      </profiles>
      <rules>
        <rule name="Frenzied Charge" id="1ac2-11bd-2c42-2e4c" hidden="false" page="51" publicationId="5af86795--pubN100859">
          <description>when charging, roll 3D6 and add together for total charge distance.</description>
        </rule>
        <rule name="Runes of the Blood God" id="d2a3-ee25-35e3-fd0a" hidden="false" page="51" publicationId="5af86795--pubN100859">
          <description>Any psyker who targets the scorpion suffers perils of the warp irrespective of a pass or failure.</description>
        </rule>
        <rule name="Doomsday Reactor" id="dfa5-0040-b83e-f537" hidden="false" page="51" publicationId="5af86795--pubN100859">
          <description>Adds +2 modifier when rolling on the Catastrophic damage table.</description>
        </rule>
        <rule name="Multi-legged Terror" id="03a8-0ec6-e2a6-9b64" hidden="false" page="51" publicationId="5af86795--pubN100859">
          <description>When making stomp attacks, the scorpion makes D3+2 stomps</description>
        </rule>
      </rules>
