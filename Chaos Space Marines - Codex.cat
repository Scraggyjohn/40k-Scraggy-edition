    <profile name="Sigil of Corruption" id="18cbc9e8-3b34-33f1-5463-afaec221cf2f" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Confers a 4+ Invulnerable Save</characteristic>
      </characteristics>
    </profile>
    <profile name="Sonic Blaster" id="a712b346-1af7-324e-01c1-b39f31a9c6d8" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Salvo 2/3, Ignores Cover</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Sorcerer" id="0dc7d750-fac9-1d04-f3c7-edb7ebd31f8a" hidden="false" page="0" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic>
        <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">5</characteristic>
        <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
        <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic>
        <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic>
        <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic>
        <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">4</characteristic>
        <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic>
        <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
        <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">3+</characteristic>
      </characteristics>
    </profile>
    <profile name="Soulburner" id="560176f7-107e-1e08-373a-968f23557293" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 1, Blast (3&quot;), Rending</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Spell Familiar" id="30a626c5-1443-5f29-d592-80510cb44b14" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer may re-roll failed Psychic tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Steed of Slaanesh" id="5f637bd5-ca32-c805-9a68-d4001de6ed46" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gains +1 Attack and +3&quot; to his Run moves. Also gains Outflank and Acute Senses. Becomes Cavalry.</characteristic>
      </characteristics>
    </profile>
    <profile name="Talon of Horus" id="d4d19aa8-8887-ea7e-858c-39af2061a35f" hidden="false" page="0" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">- (+ combi-bolter)</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">x2</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Shred, Specialist Weapon</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Terminator Armour" id="555984b7-f596-aa5d-79e1-1123f78ac454" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+/5++, have the Bulky, Deep Strike, Relentless special rules, and may not make sweeping advances.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warpflame Gargoyles" id="39727fe9-2186-da1f-121a-ba156ae612eb" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All weapons on the Vehicle have Soul Blaze</characteristic>
      </characteristics>
    </profile>
    <profile name="Inferno Combi-bolter" id="4732-99ba-d4d1-d9de" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Rapid Fire, Twin-linked</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Soulreaper Cannon" id="bee4-e35b-3786-b5f3" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 4, Rending</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Hellfyre Missile Rack" id="716c-227f-6dee-ddaa" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2</characteristic>
