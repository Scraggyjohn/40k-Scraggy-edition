          <constraints>
            <constraint id="d079-2239-ff84-8755" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="4"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Auxiliary" id="6cf2-f751-e19f-f386-ef2b-83bd-1bad-5742" hidden="false" primary="false" targetId="ef2b-83bd-1bad-5742">
          <constraints>
            <constraint id="d072-92d0-6922-122c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
          </constraints>
        </categoryLink>
      </categoryLinks>
      <infoLinks>
        <infoLink name="Crusader" id="ee8f-bd37-0899-ebe4" hidden="false" targetId="f987-c2a3-1a7a-9703" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="The Coryphaus" id="5081-8f70-a57b-5490" hidden="false">
          <description>If this Detachment is your Primary Detachment, you can re-roll the result when rolling on the Word Bearers Warlord Traits table.</description>
        </rule>
        <rule name="Dark Crusaders" id="ce67-b83e-13ec-9b23" hidden="false">
          <description>All non-vehicle units in this Detachment have the Crusader special rule.</description>
        </rule>
        <rule name="The Eight-fold Path" id="2fb8-af6e-7bab-7def" hidden="false">
          <description>At the start of each of your turns, pick one character from this Detachment and make a roll on the Chaos Boon table for them. Each character can only benefit from this rule once, though they may still earn further rolls on the Chaos Boon table as normal.</description>
        </rule>
      </rules>
    </forceEntry>
    <forceEntry name="CSM World Eaters Butcherhorde" id="1d27-88dc-b936-fb22" hidden="false">
      <categoryLinks>
        <categoryLink name="Core" id="1d27-88dc-b936-fb22-bf93-7277-bf48-16f7" hidden="false" primary="false" targetId="bf93-7277-bf48-16f7">
          <constraints>
