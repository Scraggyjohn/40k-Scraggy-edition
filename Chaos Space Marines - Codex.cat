    <selectionEntry name="Daemon-Engine Hunting Pack" id="17f4-9b8e-8684-fbfe" collective="false" hidden="false" import="true" publicationId="5af86795--pubN136352" type="unit">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="17f4-9b8e-8684-fbfe-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Hunting Pack" id="0d70-c046-82b6-eb5f" hidden="false">
          <description>After deployment, but before the first turn, nominate one character model int eh enemy army. All vehicles in the spearhead have the Preferred Enemy rule when attacking this model. In addition, if the nominated enemy model is destroyed, the side this formation belongs to scores 1 Strategic Victory Point.</description>
        </rule>
        <rule name="Prized Possessions" id="92b6-d646-8f8d-f982" hidden="false">
          <description>At the start of the battle, you may nominate one Chaos Warpsmith in the same army to be the Daemon Engine Pack&apos;s owner. Any models from this formation that are within 12&quot; of the owner may use his WS and BS instead of their own.</description>
        </rule>
        <rule name="Thunderous Charge" id="c238-177c-0266-8c6d" hidden="false">
          <description>If the spearhead is in Rapier Attack Pattern, it may charge even if it Ran in the Shooting phase.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Fiends" id="0aff-d2aa-7b6e-2bee" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="3"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="5"/>
          </constraints>
          <entryLinks>
