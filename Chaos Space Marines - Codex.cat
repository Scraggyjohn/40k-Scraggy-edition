      <infoLinks>
        <infoLink name="Shrouded" id="3bd7-7d22-bb94-e23d" hidden="false" targetId="7182-6dce-dc98-9f7c" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="I Am Alpharius" id="3c7b-3491-1cae-9a79" hidden="false">
          <description>If this Detachment is your Primary Detachment, you can re-roll the result when rolling on the Alpha Legion Warlord Traits table.</description>
        </rule>
        <rule name="Hidden Deployment" id="1bac-1224-8fc7-55e4" hidden="false">
          <description>All non-vehicle units in this Detachment have the Shrouded special rule during the first game turn.</description>
        </rule>
        <rule name="Cult Uprising" id="d8bc-14e5-3cab-893d" hidden="false">
          <description>When a unit of Chaos Cultists from this Detachment is completely destroyed, you may add 1 to the dice roll for the A Tide of Traitors special rule when determining whether or not a new unit is placed into Ongoing Reserves.</description>
        </rule>
      </rules>
    </forceEntry>
    <forceEntry name="CSM Black Crusade Detachment" id="1d17-fd64-f8e0-7079" hidden="false">
      <categoryLinks>
        <categoryLink name="Core" id="1d17-fd64-f8e0-7079-bf93-7277-bf48-16f7" hidden="false" primary="false" targetId="bf93-7277-bf48-16f7">
