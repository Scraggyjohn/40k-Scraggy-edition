      <profiles>
        <profile name="Warpbreacher" id="55ad-4d3e-eb42-33bc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Warpsmith only. Warpbreacher is an upgrade to the bearer&apos;s mechatendrils. At the start of each of your turns, the bearer can grant the Daemonic Possession Chaos Vehicle Equipment upgrade to a friendly vehicle within 3&quot; of him, so long as the vehicle has the CSM faction and does not already have the upgrade.</characteristic>
