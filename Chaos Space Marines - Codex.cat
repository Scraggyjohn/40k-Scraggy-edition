            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Specialist Weapon, Unwieldy, Whirlwind of Blood</characteristic>
            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
