        <infoLink name="Fear" id="844e-e3d5-802b-4534" hidden="false" targetId="280d-1a0c-5916-3012" type="rule"/>
        <infoLink name="Crusader" id="1482-6560-14f7-b041" hidden="false" targetId="f987-c2a3-1a7a-9703" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Tip of the Spear" id="9880-3333-b39e-2b35" hidden="false">
          <description>If this Detachment is your Primary Detachment, you can re-roll the result when rolling on the Black Legion Warlord Traits table.</description>
        </rule>
        <rule name="Heralds of the Black Crusade" id="a9d4-9c43-61b9-94ef" hidden="false">
          <description>All non-vehicle units in this Detachment have the Fear and Crusader special rules.</description>
        </rule>
        <rule name="Speartip Strike" id="b1e3-012c-8460-0a5b" hidden="false">
          <description>Any units with the Deep Strike special rule from this Detachment can make a Reserve Roll to see if they arrive from Deep Strike Reserve on the first turn, requiring a roll of 3+ to be successful. In addition, if this Detachment is your Primary Detachment and your Warlord has the Deep Strike special rule, you can choose to automatically pass his unit&apos;s Reserve Roll to arrive on the first turn.</description>
        </rule>
      </rules>
    </forceEntry>
