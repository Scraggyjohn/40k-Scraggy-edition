    <selectionEntry name="Maelstrom of Gore" id="c693-2441-4bbf-5679" collective="false" hidden="false" import="true" page="119" publicationId="5af86795--pubN180378" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Fleet" id="2bd6-80bf-bfb3-eb5c" hidden="false" targetId="39c6-1f20-a156-47f4" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Blood-crazed" id="01e9-ff45-1b67-6c2d" hidden="false">
          <description>Maelstrom of Gore units have the Fleet special rule and add 3&quot; to their charge distances.</description>
        </rule>
        <rule name="Red Rain" id="fa8a-6682-478b-2ccb" hidden="false">
          <description>Once per battle, at the start of your Movement phase, a Maelstrom of Gore can summon the red rain. When it does so, every unit in the Formation that is locked in combat is allowed to Pile In and fight as if it were a Fight sub-phase, but enemy units cannot fight back. Using this ability does not stop the Maelstrom of Gore&apos;s units from fighting again in the Assault phase of the same turn.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Berzerkers" id="8386-de16-936d-5955" collective="false" defaultSelectionEntryId="fee0-60b0-5234-0ee5" hidden="false" import="true">
          <constraints>
            <constraint id="730a-a5ba-b97c-c56b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="4"/>
            <constraint id="1667-50e7-cdc3-ef2b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="8"/>
          </constraints>
          <entryLinks>
