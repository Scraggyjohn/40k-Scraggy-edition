    <selectionEntry name="Heldrake Fear Squadron" id="8deb-3f12-acc9-fd78" collective="false" hidden="false" import="true" publicationId="5af86795--pubN133092" type="unit">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="8deb-3f12-acc9-fd78-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
