        </rule>
        <rule name="The Blessing of Khorne" id="8c9d-8705-e9b0-1db9" hidden="false">
          <description>Units that have the VotLW special rule have the Adamantium Will special rule.</description>
        </rule>
        <rule name="The Butcher&apos;s Nails" id="5e42-2b79-7587-2e85" hidden="false">
          <description>Units that have the VotLW special rule have the Fearless and Furious Charge special rules.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Death Guard" id="9c55-dd66-6f7b-8bc8" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="bfb5-1cd3-c00c-2716" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="0"/>
