    <selectionEntry name="The Red Onslaught" id="67ac-ff22-911d-d120" collective="false" hidden="true" import="true" publicationId="5af86795--pubN112041" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Crimson Slaughter" id="5880-6026-5442-762a" hidden="false" targetId="b3ad-2a40-c969-66d9" type="rule"/>
      </infoLinks>
