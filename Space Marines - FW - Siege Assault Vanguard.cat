    <profile name="The Bones of Osrak" id="11a58870-2f99-78ce-8734-42f3669a9bff" hidden="false" page="83" publicationId="d227da84--pubN81691" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Bones of Osrak can only be taken by a Librarian. The bearer generates an additional Warp Charge point, and can re-roll failed Psychic tests.</characteristic>
      </characteristics>
    </profile>
