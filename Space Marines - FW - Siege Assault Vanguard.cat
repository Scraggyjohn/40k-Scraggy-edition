    <profile name="Augmented Atomantic Shielding" id="189ef190-7333-b576-bdb6-fa2c13e74c87" hidden="false" page="147" publicationId="d227da84--pubN83302" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
