        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Combi-Weapons" id="b9acf151-1b3a-6d61-fc07-074c4ed705f2" hidden="false" page="0" publicationId="d227da84--pubN174730" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Bolter may be fired every turn, secondary weapon may be fired once. (Combi-plasma does have Rapid Fire). Cannot fire both in same turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Command Vox Relay" id="a95ace0e-b272-e2f5-5bbf-6a0ceeef9705" hidden="false" page="186" publicationId="d227da84--pubN70050" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">May add or subtract 1 from all reserve rolls while on the table</characteristic>
      </characteristics>
    </profile>
