    <profile name="Assault Drill" id="6370155d-69ef-fd4a-a94b-4957e3c9dde1" hidden="false" page="171" publicationId="d227da84--pubN70050" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">x2 (Max 10)</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">+D6 to pen. bunkers, fortifications, bastions, other buildings &amp; any vehicle classed as stationary that turn.</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Assault Drill In-built Heavy Flamer" id="7ea5e1f0-19de-ebb7-69f7-7a7faed89eb4" hidden="false" page="171" publicationId="d227da84--pubN70050" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In addition to normal use, if the DCCW inflicts a pen. hit against a building/vehicle that is occupied, but the target is not destroyed outright, then all models inside suffer a single Heavy Flamer hit automatically after the Dreadnought&apos;s other attacks have been resolved (Str 5, Ap 4, distributed as per wounds from a shooting attack). This flamer hit only occurs once per Combat phase, not once per hit.</characteristic>
      </characteristics>
    </profile>
