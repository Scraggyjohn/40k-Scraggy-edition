    <profile name="The Raven Helm" id="7c9b-9eca-824e-d371" hidden="false" page="0" publicationId="d227da84--pubN101007" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Non-vehicle units that target Shadow Captain Solaq or his unit with a shooting attack must first pass a Ld test. If this test is failed, that unit can onlf fire Snap Shots for the rest of the turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Raven Skull of Korvaad" id="f5a6-7ad4-aaa3-ccd1" hidden="false" page="166" publicationId="d227da84--pubN223892" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">+1WS and +1LD. if the model is removed as a casualty, note its last position. For the rest of the battle, friendly Raven Guard models have Hatred and Rage while they are within 6&quot; of this position.</characteristic>
      </characteristics>
    </profile>
