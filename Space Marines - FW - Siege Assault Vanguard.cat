    <profile name="Signum" id="d7eeda14-0931-5ae4-5bfe-f74d10baf1d9" hidden="false" page="0" publicationId="d227da84--pubN66388" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the Shooting phase, a model with a signum can choose to use it instead of shooting. If he does so, one model in his squad is BS5 for the remainder of the Shooting phase. Declare that the signum is being used before any rolls To Hit are made.</characteristic>
      </characteristics>
    </profile>
