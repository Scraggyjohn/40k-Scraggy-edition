    <profile name="The Banner of Staganda" id="83af42ec-c7eb-453f-e36a-e8dd1fe52dba" hidden="false" page="83" publicationId="d227da84--pubN81691" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Banner of Staganda can only be taken by a model that may take a Company Standard. The bearer has the Counter-Attack and Crusader special rules. In addition,  friendly units within 12&quot; of the bearer, and with the same Chapter Tactics, re-roll failed Morale checks and Pinning tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Banner of the Eagle" id="82a7-4a86-b15d-79c0" hidden="false" page="154" publicationId="d227da84--pubN223892" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly White Scars units within 12&quot; have Fleet and Furious Charge.</characteristic>
      </characteristics>
    </profile>
