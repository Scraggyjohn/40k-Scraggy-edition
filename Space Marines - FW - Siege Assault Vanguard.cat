        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv. The model and any unit they have joined gains the Stubborn and Preferred Enemy (Chaos Space Marines) special rules.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Primarch&apos;s Wrath" id="daf6edf3-d92b-3fb4-5a39-6cc500119f08" hidden="false" page="0" publicationId="d227da84--pubN66388" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
