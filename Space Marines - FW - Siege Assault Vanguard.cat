    <profile name="Vulkan&apos;s Sigil" id="77bb-a05d-5a80-db66" hidden="false" page="95" publicationId="d227da84--pubN81691" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per game, at the start of any Fight sub-phase, the bearer of Vulkan&apos;s Sigil can use its power. When he does so, he and all other Salamanders models in his unit gain +1A until the end of the current phase.</characteristic>
      </characteristics>
    </profile>
