    <profile name="The Emperor&apos;s Champion" id="82b22d55-4092-0a4f-0157-90e5d9d493f7" hidden="false" page="0" publicationId="d227da84--pubN66388" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
