    <profile name="Battle Alchemistry Hellfire Bolt Pistol" id="f7b64554-430b-0752-9b9b-9ed57a8b7724" hidden="false" page="29" publicationId="d227da84--pubN67929" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
