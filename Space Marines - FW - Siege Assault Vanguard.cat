    <profile name="The Panoply of the Crusader" id="5b81-4e93-c365-f3a1" hidden="false" page="0" publicationId="d227da84--pubN148517" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
