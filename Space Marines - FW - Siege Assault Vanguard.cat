              <profiles>
                <profile name="Sunfury Plasma Annihilator" id="c84a-2d66-6615-a5e4" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
