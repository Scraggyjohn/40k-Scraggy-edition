    <rule name="Dark Fury" id="ed89ab8b-7135-9a6d-ef07-dba4d3792ddf" hidden="false" page="31" publicationId="d227da84--pubN72917"/>
    <rule name="Dark Shadows" id="ea694291-9e12-0303-2ef7-6be9fd5922fe" hidden="false" page="46" publicationId="d227da84--pubN223164"/>
