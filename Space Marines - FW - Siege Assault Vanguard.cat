    <profile name="Frag Assault Launchers" id="2606862c-04f8-43b0-9f29-f20b58fa508e" hidden="false" page="0" publicationId="d227da84--pubN66388" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
