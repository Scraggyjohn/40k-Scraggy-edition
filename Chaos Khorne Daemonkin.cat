      <rules>
        <rule name="Siege Crawler" id="819e-81f4-8a57-dba8" hidden="false">
          <description>Maulerfiends can move up to 12&quot; in the movement phase and are not slowed by difficult terrain (even when charging). This unit gets +1 Armour penetration rolls against buildings in Close Combat.</description>
        </rule>
      </rules>
