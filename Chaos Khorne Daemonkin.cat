    <profile name="Collar of Khorne" id="5cc7-56a8-7625-0b68" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A Unit containing 1 or more collar of Khorne adds +2 to all Deny the Witch rolls.</characteristic>
