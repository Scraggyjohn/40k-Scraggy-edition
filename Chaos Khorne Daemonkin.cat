        <infoLink name="Blood for the Blood God!" id="8350-de63-cdc7-545a" hidden="false" targetId="c573-9539-c944-eca6" type="rule"/>
        <infoLink name="Fearless" id="84e6-ff66-d0d3-b6fc" hidden="false" targetId="8d37-2e47-4a04-58f7" type="rule"/>
        <infoLink name="Rage" id="205c-8b1c-0759-66f2" hidden="false" targetId="3ac5-a550-39f8-f28a" type="rule"/>
        <infoLink name="Fear" id="3d26-cc9e-2ac1-a66b" hidden="false" targetId="280d-1a0c-5916-3012" type="rule"/>
        <infoLink name="Very Bulky" id="d2c9-f487-10ee-1d39" hidden="false" targetId="20e0-3f6c-f3ac-fda2" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Random Attacks" id="9615-28bf-9d60-b9b6" hidden="false">
          <description>At the start of each fight sub-phase, roll a D6. The result is the number of attacks for all Chaos Spawn model in the unit for the rest of the turn.</description>
        </rule>
        <rule name="Mutated Beyond Reason" id="fc0e-87a7-8339-d43e" hidden="false">
          <description>At the start of each sub-fight phase (before even rolling the random attacks), roll A D3 and consult the mutation table as presented in Codex: Khorne Daemonkin. The unit has that mutation until the end of the turn.

1 Subcutaneous Armour: The Chaos Spawn have an Armour Save of 4+.
2 Grasping Pseudopods: The Chaos Spawn unit rolls two D6 and picks the highest for
their Random Attacks.
3 Toxic Haemorrhage: The Chaos Spawn&apos;s Attacks have the Poisoned (4+) special rule.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Spawn count" id="8b2d-0cd9-4356-6c9b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
