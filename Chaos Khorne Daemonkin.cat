    <selectionEntry name="The Bloodied Horde" id="5ee2-070f-11bc-d0ed" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Rage" id="4d58-0924-3619-32cf" hidden="false" targetId="3ac5-a550-39f8-f28a" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="The Bloodied Horde Unleashed" id="47a1-3792-8dc0-19aa" hidden="false">
          <description>All units in this formation must begin the game in Deep Strike Reserve. 

When making reserve rolls, a single dice result counts for the entire formation. You may choose to make a single re-roll for this reserve roll.</description>
        </rule>
        <rule name="Daemonic Tide" id="06ee-cda2-9244-759f" hidden="false">
          <description>Each time either a unit of Bloodletters or Bloodcrushers is destroyed, roll a D6. on a 4+ a new unit (consisting of the previous units upgrade costs and size) is created and placed into Ongoing reserves. They are counted as being part of the original formation and must start in Deep Strike.

Victory points are awarded as normal.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Bloodcrushers" id="59d2-41e2-fc5b-6383" collective="false" defaultSelectionEntryId="81b9-8927-14ac-2339" hidden="false" import="true">
