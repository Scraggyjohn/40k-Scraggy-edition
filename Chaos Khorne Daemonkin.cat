      </costs>
      <infoLinks>
        <infoLink name="Adamantium Will" id="aeb3-eafe-cca0-3dae" hidden="false" targetId="8714-46ad-62c0-ce35" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="The Brazen Rune" id="f5dd-16a2-fb2f-d69c" hidden="false">
          <description>Confers Adamantium Will. 

Once per game at the start of the enemies psychic phase, you can declare that you are using the Runes full power. Until the end of that phase, all psykers within 24&quot; of the bearer suffers Perils of the Warp on the roll of a double. After the phase has ended the model loses Adamantium Will.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="The Goreguard" id="b8fc-9a78-208b-5643" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Rampage" id="7146-edec-c7d5-cc49" hidden="false" targetId="814f-6a54-47ae-6abd" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Feel no Pain" id="a087-85cf-759a-c279" hidden="false"/>
        <rule name="The Chosen of An&apos;ggrath" id="65a3-99ef-bdaf-f1d5" hidden="false">
          <description>All bloodthirsters in the formation that are within 18&quot; of An&apos;ggrath have Adamantium Will, Counter-Attack and gain an extra attack.</description>
        </rule>
        <rule name="Terror Made Manifest" id="b113-7f2a-1418-8de9" hidden="false">
          <description>Enemy units that fail a Fear test caused by any model in this formation suffer 1 wound for each point the test was failed. No saves of any kind are allowed.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Bloodthirster Retinue" id="2e81-aeca-3686-40b4" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="8"/>
