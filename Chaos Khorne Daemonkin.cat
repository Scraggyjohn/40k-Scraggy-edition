      <rules>
        <rule name="Blood Frenzy" id="4eae-041f-64d6-ac0a" hidden="false">
          <description>At the beginning of your turn, before deciding to spend blood tithe points, you automatically generate an additional Blood Tithe.</description>
        </rule>
        <rule name="Chosen of Khorne" id="138c-7bfd-b5a5-632a" hidden="false">
          <description>If this detachment is your primary detachment, you may re-roll the result of the Warlord traits in Codex: Khorne Daemonkin.</description>
        </rule>
      </rules>
    </forceEntry>
