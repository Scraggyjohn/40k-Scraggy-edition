      <rules>
        <rule name="Frenzied Charge" id="498e-30b8-b3cf-8770" hidden="false" page="51" publicationId="9b32-f1cf-pubN75240">
          <description>when charging, roll 3D6 and add together for total charge distance.</description>
        </rule>
        <rule name="Runes of the Blood God" id="5f91-133c-6b6b-baa3" hidden="false" page="51" publicationId="9b32-f1cf-pubN75240">
          <description>Any psyker who targets the scorpion suffers perils of the warp irrespective of a pass or failure.</description>
        </rule>
        <rule name="Doomsday Reactor" id="048b-0e07-e7bc-55ef" hidden="false" page="51" publicationId="9b32-f1cf-pubN75240">
          <description>Adds +2 modifier when rolling on the Catastrophic damage table.</description>
        </rule>
        <rule name="Multi-legged Terror" id="5a40-606f-0df7-4151" hidden="false" page="51" publicationId="9b32-f1cf-pubN75240">
          <description>When making stomp attacks, the scorpion makes D3+2 stomps</description>
        </rule>
      </rules>
