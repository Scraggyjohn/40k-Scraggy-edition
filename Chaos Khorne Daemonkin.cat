          </constraints>
          <entryLinks>
            <entryLink name="Bloodthirster of Insensate Rage" id="70c0-3c2f-af4d-cb0e" collective="false" hidden="false" import="true" targetId="d2c8-3da1-917f-725e" type="selectionEntry"/>
            <entryLink name="Bloodthirster of Unfettered Fury" id="e3c0-a0db-5bc9-7084" collective="false" hidden="false" import="true" targetId="025a-8de9-b4f2-84cf" type="selectionEntry"/>
            <entryLink name="Wrath of Khorne Bloodthirster" id="07b7-9743-fa79-567e" collective="false" hidden="false" import="true" targetId="6aad-e340-5e43-970b" type="selectionEntry"/>
          </entryLinks>
        </selectionEntryGroup>
