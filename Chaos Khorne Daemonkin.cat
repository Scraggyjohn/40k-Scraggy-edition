    <selectionEntry name="Brazen Onslaught" id="0a1d-30ae-a402-3b25" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Khorne&apos;s Chosen Slaughterers" id="82b4-5b5a-c522-ded0" hidden="false">
          <description>At the beginning of each fight-sub phase, check to see if a unit in this formation that is engaged in combat has more enemy models than friendlies in the same combat. If a unit in this formation is then outnumbered, each model in that unit gets +1 Attack until the end of that phase.</description>
        </rule>
      </rules>
