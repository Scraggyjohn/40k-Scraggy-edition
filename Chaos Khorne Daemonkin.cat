            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">1</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">6</characteristic>
            <characteristic name="Front" typeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f">13</characteristic>
            <characteristic name="Side" typeId="5f9a3780-eecb-4c70-be1d-e5bd06b06e9e">12</characteristic>
            <characteristic name="Rear" typeId="0a9f33cb-0412-420a-89d2-20707c360bd2">10</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">4</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">3</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Walker)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Fury of Khorne" id="f4f6-3c1d-ae9d-5840" hidden="false" page="0">
          <description>When charging into Assault, the Blood Slaughterer gains +D3 attacks instead.</description>
        </rule>
        <rule name="Blind Fury" id="94db-d9cc-81bc-caa2" hidden="false" page="0">
          <description>It must always move as fast as possible towards the closest visible enemy and must consolidate towards the closest visible enemy. If it chooses to run during the shooting phase, it must be towards the closest visible enemy. Does not apply if there are no visible enemies.</description>
        </rule>
        <rule name="Daemonic Resiliance" id="fe41-7363-2041-5018" hidden="false">
          <description>The unit ignores Crew shaken can Crew stunned results on a 2+.
Hull Point is still lost.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Weapons" id="6679-88db-e55b-e846" collective="false" defaultSelectionEntryId="819c-f32f-65cc-a94b" hidden="false" import="true">
