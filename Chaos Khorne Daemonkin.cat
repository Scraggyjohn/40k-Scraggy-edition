    <profile name="Icon of Wrath" id="dcbf-169e-104d-a986" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit with this Icon adds 1 to their combat resolution result. Any units with Mark of Khorne carrying the Icon gain Furious Charge, and may re-roll charge distance.</characteristic>
      </characteristics>
    </profile>
    <profile name="Improvised Armour" id="11c0-2c58-2aae-4fe1" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Confers a 6+ Armour save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Instrument of Chaos" id="6de0-cb8d-b56a-b2f5" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Whenever a unit with an insturment of chaos passes a Reserve roll, select another Deep Striking Daemon that is yet make a reserve roll and that unit enters play automatically.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ion Shield" id="6e09-f2cd-d5e6-f5d7" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of the opponents shooting phase, select the facing of the Ion Shield. The Ion Shield confers a 4+ Invunerable save against that facing until the start of your opponents next shooting phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Jump Packs" id="0f1c-5944-1031-9ac3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
