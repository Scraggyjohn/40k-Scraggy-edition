                <profile name="Lasher Tendrils" id="6a6e-10f5-6977-5b3d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each set of Lasher Tendrils reduce the base attacks of all models in base contact with the Maulerfiend by 1 to a minimum of 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
