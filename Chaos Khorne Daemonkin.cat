                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Dreadskulls, Ignores Cover, Large Blast</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Dreadskulls" id="1222-d309-1e13-d72c" hidden="false">
              <description>Place a marker next to any units that take hits from the skull cannon. Any units from this codex that charges the marked units do not suffer penalties for moving through Difficult Terrain. Remove any Dreadskull markers at the end of the Assault phase.</description>
