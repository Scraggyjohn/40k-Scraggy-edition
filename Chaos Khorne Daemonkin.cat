                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Magma Cutters" id="07f1-c171-0466-a155" hidden="false">
                  <description>If the maulerfiend hits with at least 1 attack in the fight sub-phase, it may use its Magma Cutters against the targetted model (as an additional attack). If ALL of its attacks hit, then 2 Magma Cutter attacks are granted against the model. The attacks automatically hit, and are resolved at Initiative 1.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="2x Lasher Tendrils" id="0d99-506f-b46f-4df2" collective="false" hidden="false" import="true" type="upgrade">
