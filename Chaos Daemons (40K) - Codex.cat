      <profiles>
        <profile name="Lesser Locus of Transmogrification" id="5174-24cf-5ace-a739" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Pink Horror in this model&apos;s unit is slain in close combat, the unit that inflicted the unsaved wound immediately suffers a S3 AP- hit. Each time a Blue Horror in this model&apos;s unit is slain in close combat, the unit that inflicted the unsaved wound immediately suffers a S2 AP- hit. Each time a Brimstone Horror in this model&apos;s unit suffers an unsaved wound in close combat, the unit that inflicted the unsaved wound immediately suffers a S1 AP- hit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
