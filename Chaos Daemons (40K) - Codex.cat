  <forceEntries>
    <forceEntry name="CD Daemonic Incursion" id="8111-5066-a5a7-fee8" hidden="false">
      <categoryLinks>
        <categoryLink name="Command" id="8111-5066-a5a7-fee8-9050-d437-3301-7e42" hidden="false" primary="false" targetId="9050-d437-3301-7e42">
          <constraints>
            <constraint id="33b4-e23d-a48a-ea8a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="4"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Core" id="8111-5066-a5a7-fee8-bf93-7277-bf48-16f7" hidden="false" primary="false" targetId="bf93-7277-bf48-16f7">
          <constraints>
            <constraint id="3bfd-3ff7-d55d-a3fb" field="selections" includeChildForces="true" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Auxiliary" id="8111-5066-a5a7-fee8-ef2b-83bd-1bad-5742" hidden="false" primary="false" targetId="ef2b-83bd-1bad-5742">
          <constraints>
            <constraint id="2179-aa0e-b35f-3a99" field="selections" includeChildForces="true" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
          </constraints>
        </categoryLink>
      </categoryLinks>
      <rules>
        <rule name="The Warp Unleashed" id="cc2d-4275-21cd-b469" hidden="false">
          <description>You can choose to re-roll any Daemonic Instability tests for units from this Detachment.</description>
        </rule>
        <rule name="Unearthly Power" id="8313-ad10-0bd8-3c31" hidden="false">
          <description>When rolling on the Warp Storm table you can choose to add or subtract 1 from the result.</description>
        </rule>
        <rule name="Daemonic Corruption" id="57a1-9280-6880-0fc9" hidden="false">
          <description>Any Objective Markers controlled by units from this Detachment at the end of your turn count as being under your control for the rest of the game, even inf you have no units within 3&quot; of them. A unit can only corrupt a single Objective Marker in this manner at the end of each of your turns. This effect lasts until an enemy scoring unit cleanses the objective by controlling it.</description>
        </rule>
        <rule name="Patronage of the Dark Gods" id="7758-5b87-8663-447f" hidden="false">
          <description>Psykers from this Detachment can choose to generate all of their psychic powers from the Discipline of Change, Plague or Excess (as appropriate) if they wish. However, if they do so, then the rules for Chaos Focus (see BRB) no longer apply to them; they follow the normal rules for Psychic Focus instead.</description>
        </rule>
      </rules>
    </forceEntry>
    <forceEntry name="CD Pandemoniad of Tzeentch" id="a129-1f4b-1aa2-f3fa" hidden="false">
      <categoryLinks>
        <categoryLink name="Core" id="a129-1f4b-1aa2-f3fa-bf93-7277-bf48-16f7" hidden="false" primary="false" targetId="bf93-7277-bf48-16f7">
          <constraints>
            <constraint id="df7f-4402-6354-a4df" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Command" id="a129-1f4b-1aa2-f3fa-9050-d437-3301-7e42" hidden="false" primary="false" targetId="9050-d437-3301-7e42">
          <constraints>
            <constraint id="f0d7-7160-157a-2d2a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Auxiliary" id="a129-1f4b-1aa2-f3fa-ef2b-83bd-1bad-5742" hidden="false" primary="false" targetId="ef2b-83bd-1bad-5742">
          <constraints>
            <constraint id="cdb5-eaea-878c-50f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
        </categoryLink>
      </categoryLinks>
      <rules>
        <rule name="Ephemeral Form" id="8559-5f31-f0c5-932c" hidden="false">
          <description>Models from this Detachment add 1 to their invulnerable saves (to a maximum of 3++) instead of re-rolling save rolls of 1.</description>
        </rule>
        <rule name="Master of Fate" id="5d54-0acb-8e76-39ee" hidden="false">
          <description>If this Detachment is your Primary Detachment, you can re-roll the result when rolling on the Tzeentch Warlord Traits table and can re-roll the result when rolling on the Tzeentchian Warp Storm table.</description>
        </rule>
      </rules>
    </forceEntry>
  </forceEntries>
