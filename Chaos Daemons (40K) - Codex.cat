          </costs>
          <profiles>
            <profile name="The Staff of Cataclysm" id="088da6ed-9753-cf4c-fdde-32eb7d6c929a" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
