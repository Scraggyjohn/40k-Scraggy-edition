      </infoLinks>
      <rules>
        <rule name="Daemon of Nurgle" id="0056-2d52-69bc-7507" hidden="false">
          <description>Daemons of Nurgle have the Daemon, Hatred (Daemons of Tzeentch), Shrouded, and Slow and Purposeful special rules. In addition, units that are composed entirely of Daemons of Nurgle are treated as having defensive grenades.</description>
        </rule>
      </rules>
    </selectionEntry>
