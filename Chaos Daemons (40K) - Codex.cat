      <profiles>
        <profile name="Blasted Standard" id="2aad-62bc-7d0d-1c5d" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A Blasted Standard is an Icon of Chaos. Once per game, the unit can declare it is using a Blasted Standard. This is done immediately before the unit makes a Shooting attack (including Overwatch), or attempts to manifest a Witchfire power. If it does so, any unit hit by that attack suffers an additional 2D6 S4 AP- hits.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
