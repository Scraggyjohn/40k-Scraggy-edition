      </costs>
      <entryLinks>
        <entryLink name="Daemon of Tzeentch" id="1fcc-694a-fa64-33d4" collective="false" hidden="false" import="true" targetId="a567e325-4907-1e0f-0a93-b2e3f562a1f8" type="selectionEntry"/>
        <entryLink name="Warlord" id="8243-b939-14a0-fcc8" collective="false" hidden="false" import="true" targetId="ab06-4df6-b427-4e06" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Daemonic Instability" id="9be8-fd10-bd23-9b40" hidden="false" targetId="521fb0b8-870d-f3e9-6f25-483767d3b77e" type="rule"/>
        <infoLink name="Deep Strike" id="2155-ac0f-8ebf-0a70" hidden="false" targetId="243a-b08c-3c8c-c363" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="The Blue Scribes" id="7fdf-fa19-e1e1-0406" hidden="false" page="0" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Jetbike (Character)</characteristic>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">3</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic>
            <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">3</characteristic>
            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">3</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Scrolls of Sorcery" id="495e-3723-7005-220f" hidden="false" publicationId="83d27dcf--pubN104574" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each friendly Psychic Phase, choose a Psychic Discipline from the BRB and roll a D6. This turn, the Blue Scribes automatically manifest that power without the need for a psychic test (they cannot swap it for the Primaris Power). This power is treated as having been manifested by the minimum amount of Warp Charge points required to manifest the power, for the purposes of Deny the Witch rolls. Note that the Blue Scribes are not Psykers for the purposes of any special rules that target Psykers.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Spell Syphon" id="b2b4-937b-28dd-09a2" hidden="false" page="0">
          <description>Each time an enemy Psyker successfully manifests a psychic power, place a syphon token next to the Blue Scribes. At the start of each of your turns, roll a D6 for each syphon token next to the Blue Scribes; for each 6 rolled, one friendly psyker within 12&quot; of the Blue Scribes immediately gains a Warp Charge point. Then remove all syphon tokens from the board.</description>
        </rule>
      </rules>
    </selectionEntry>
