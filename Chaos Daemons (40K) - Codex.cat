    <selectionEntry name="Burning Skyhost" id="77e0-abe4-f8f5-e6d3" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Harbinger of Tzeentch" id="0774-1e55-d340-24c8" hidden="false" targetId="2a61-6373-1e4b-0211" type="rule"/>
        <infoLink name="Warpflame" id="5219-bc81-d437-ab89" hidden="false" targetId="de070752-2c93-5c2c-d937-5cab4ff68531" type="rule"/>
        <infoLink name="Soul Blaze" id="1885-27f8-ff32-7d5f" hidden="false" targetId="acb1-64c4-ef54-3a55" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Trail of Transmuting Flame" id="be4d-c13a-4ead-3feb" hidden="false">
          <description>If a Burning Chariot of Tzeentch from a Burning Skyhost moves Flat Out, pick an unengaged enemy unit it moved over. That unit suffers D6 S5 AP4 hits with Soul Blaze and Warpflame special rules. Use the final position of the Burning Chariot for the purposes of determining Wound allocation; vehicles are always hit on their side armour.

Furthermore, Screamers from a Burning Skyhost cause D3+1 S4 AP- hits when making a Slashing Attack rather than D3 hits. These attacks also have the Soul Blaze and Warpflame special rules.</description>
        </rule>
      </rules>
