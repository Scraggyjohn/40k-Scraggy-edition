                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Apocalyptic Barrage (6+D3),  Haywire, Posion 4+</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="The Staff of Cataclysm" id="890643c8-08a7-d6ba-59bc-1d50cb283121" hidden="false">
              <description>Aetaos must remain stationary to use and cannot use when in an assault. Aetaos must pass a Ld check for each usage of the staff. If passed, the barrage goes as planned. If failed, the opponent gets to target the attack.</description>
            </rule>
          </rules>
        </selectionEntry>
