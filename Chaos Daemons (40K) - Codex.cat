      </costs>
      <entryLinks>
        <entryLink name="Daemon of Nurgle" id="9229-a1d7-f975-c159" collective="false" hidden="false" import="true" targetId="bc47ebb1-051d-12f5-85f9-a2520a661c51" type="selectionEntry"/>
