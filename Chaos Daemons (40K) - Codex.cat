      <rules>
        <rule name="Warp Contradiction" id="b211-7a7e-1ff8-6ceb" hidden="false">
          <description>Once per turn, when taking Psychic test, the bearer can pick up and turn all dice he has rolled to their opposide side instead (ie 1, 3, and 5 become 6, 4, and 2).</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Pink Horrors of Tzeentch" id="a9cf-4334-0021-b8c1" collective="false" hidden="false" import="true" page="0" type="unit">
