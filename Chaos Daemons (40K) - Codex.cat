        <profile name="Brass Collar of Bloody Vengeance" id="c386-5769-c9ac-f44a" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">See Collar of Khorne.  In addition, any Psyker that takes a Psychic test within 12&quot; of Karank suffers Perils of the Warp on any double.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Prey of the Blood God" id="4bb1-eb1d-c83e-1ad9" hidden="false" page="0">
          <description>At the start of the game, before deployment, nominate one character in the enemy army; this is Karanak&apos;s quarry. Karanak re-rolls all failed To Hit and To Wound rolls against the nominated model and his unit whilst the target model is alive.</description>
        </rule>
      </rules>
