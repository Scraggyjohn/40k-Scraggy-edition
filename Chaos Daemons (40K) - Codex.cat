    <selectionEntry name="Greater Locus of Trickery" id="7360-6501-9557-622d" collective="false" hidden="false" import="true" page="0" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="20"/>
      </costs>
      <profiles>
        <profile name="Greater Locus of Trickery" id="032c-1a6f-a50a-f5cc" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the beginning of each turn, roll a D6; any To Hit rolls that target the model, or any models in his unit, that have the same score as the result this turn count as having rolled a 1 instead.</characteristic>
          </characteristics>
