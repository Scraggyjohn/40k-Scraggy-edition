    <selectionEntry name="Tetragon of Darkness" id="6f7a-93c2-621e-ca80" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="6f7a-93c2-621e-ca80-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
      </categoryLinks>
