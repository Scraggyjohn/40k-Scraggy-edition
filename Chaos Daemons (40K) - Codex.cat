    <selectionEntry name="Exalted Locus of Creation" id="0acf-6970-e940-742e" collective="false" hidden="false" import="true" page="0" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="35"/>
      </costs>
      <profiles>
        <profile name="Exalted Locus of Creation" id="010e-5397-d33b-adea" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a Pink Horror in this model&apos;s unit is slain, it splits into four Blue Horrors instead of two. Each time a Blue Horror in this model&apos;s unit is slain, it splits into two pairs of Brimstone Horrors instead of one.</characteristic>
          </characteristics>
        </profile>
