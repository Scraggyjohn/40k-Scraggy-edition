    <selectionEntry name="Seer Council" id="c247-a310-f563-6418" collective="false" hidden="false" import="true" page="141" publicationId="555e-9663-pubN65910" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Psychic Bond" id="45dc-1514-93cf-8988" hidden="false" page="141" publicationId="555e-9663-pubN65910">
          <description>Both Farseers must join the Warlock Conclave before deployment, and cannot leave the unit.</description>
        </rule>
        <rule name="Path of the Seer" id="a137-ef26-62e4-eea0" hidden="false" page="141" publicationId="555e-9663-pubN65910">
          <description>If this Formation is chosen as your Primary Detachment, you can re-roll the result when rolling on the Warlord Traits table in Codex: Craftworlds.</description>
        </rule>
        <rule name="Psychic Might" id="edd2-cf38-155a-d670" hidden="false" page="141" publicationId="555e-9663-pubN65910">
          <description>When models from this Formation make Psychic tests, results of 3+ will harness a Warp Charge point instead of results of 4+.</description>
        </rule>
        <rule name="Formation Restrictions (Seer Council)" id="abf6-0360-5da9-56ad" hidden="false">
          <description>If any Farseer or Warlock in this Formation upgrades to be a Farseer Skyrunner or Warlock Skyrunner, all other models must also do so.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Farseers - 2 required" id="b877-ea3c-48bb-d27c" collective="false" defaultSelectionEntryId="adae-b3c9-2173-9633" hidden="false" import="true">
