            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Warlord Trait: Mark of the Imcomparable Hunter" id="b6c3-f173-723a-9221" hidden="false" page="148" publicationId="555e-9663-pubN65910"/>
        <rule name="Crack Shot" id="338d-9220-f042-a055" hidden="false" page="105" publicationId="555e-9663-pubN65910">
          <description>A model with this special rule can re-roll one failed To Hit or To Wound roll, or Armour Penetration roll, per turn.</description>
        </rule>
        <rule name="Unquenchable Resolve" id="f220-9eb5-0faf-05c7" hidden="false" page="105" publicationId="555e-9663-pubN65910">
          <description>At the end of any phase in which Fuegan suffers one or more unsaved Wounds, his Strength and Attacks increase by 1 for each unsaved Wound suffered. These characteristic bonuses last for the rest of the game.</description>
        </rule>
      </rules>
      <selectionEntries>
