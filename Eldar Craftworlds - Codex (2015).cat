    <profile name="Triskele (Melee)" id="ff4b-c43d-1c24-b568" hidden="false" page="152" publicationId="555e-9663-pubN65910" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
