      <rules>
        <rule name="Ghost Warrior Warhost (Restriction)" id="4139-2726-840f-07ea" hidden="false" page="474" publicationId="555e-9663-pubN78255">
          <description>The entire formation must fight on foot: no Dedicated Transports may be taken as upgrades.</description>
        </rule>
        <rule name="Revered Ancients" id="aecc-ecf6-4891-df85" hidden="false" page="47" publicationId="555e-9663-pubN78255">
          <description>Every friendly Eldar unit within 12&quot; of a unit from this formation has the Fearless special rule.</description>
        </rule>
        <rule name="Wrath of the Slain" id="7493-d6bb-1302-aa78" hidden="false" page="47" publicationId="555e-9663-pubN78255">
          <description>Nominate a codex immediately before determining Warlord traits. Whilst a unit from this formation is within 6&quot; of at least one of the formation&apos;s Spiritseers, that unit has the Preferred Enemy special rule against all units from the nominated codex.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
