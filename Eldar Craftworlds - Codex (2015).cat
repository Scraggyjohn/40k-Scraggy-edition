    <profile name="Star Engines" id="8669-a743-a9c7-345f" hidden="false" page="155" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A non-Walker vehicle with this upgrade can move up to 24&quot; when moving Flat Out. A Walker with this upgrade instead Runs an additional 3&quot; (this will normally be D6+3&quot;).</characteristic>
      </characteristics>
    </profile>
    <profile name="Star Lance" id="680c-2a42-f96e-d3f4" hidden="false" page="152" publicationId="555e-9663-pubN65910" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
