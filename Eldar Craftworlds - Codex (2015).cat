      <rules>
        <rule name="Wisdom from Beyond the Veil" id="cee9-e7fa-ce95-5c44" hidden="false" page="179" publicationId="555e-9663-pubN70264">
          <description>If taken as the army&apos;s Warlord, the Wraithseer may roll two D6 when determining the Warlord Trait to be used and select which dice to use.</description>
        </rule>
        <rule name="Bound to Serve" id="73f3-4b08-0073-df73" hidden="false" page="179" publicationId="555e-9663-pubN70264">
          <description>Wraithblade units from this Formation may re-roll missed close combat attacks of a &apos;1&apos; on the turn they charge into a combat that includes the Wraithseer chosen as part of this Formation.</description>
        </rule>
      </rules>
