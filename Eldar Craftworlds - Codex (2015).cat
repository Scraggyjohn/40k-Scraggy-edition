          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Ghost Warrior Warhost" id="029f-b65d-7332-1004" collective="false" hidden="false" import="true" page="47" publicationId="555e-9663-pubN78255" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
