    <profile name="Ghostwalk Matrix" id="5ec4-34cd-86ab-296f" hidden="false" page="155" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
