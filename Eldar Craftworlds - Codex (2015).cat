      </modifiers>
      <rules>
        <rule name="Crossroads of Eternity" id="8a05-f819-3777-6186" hidden="false" page="141" publicationId="555e-9663-pubN70264">
          <description>The Battlehost may include 0-1 Harlequin Troupe (see Codex: Harlequins) and/or 0-1 Corsair Reaver Bands (see Corsairs). These units are treated as having the Faction: Eldar for the duration of the game.

* Battlescribe Users: Please add an Unbound force of allied Corsairs and/or Harlequins to add these units.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Crystal Sons of Asuryan" id="415f-8363-33ea-63aa" collective="false" hidden="false" import="true" page="45" publicationId="555e-9663-pubN78255" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Crystal Metamorphosis" id="7acd-659d-e750-d993" hidden="false" page="45" publicationId="555e-9663-pubN78255">
          <description>Dire Avenger models in this formation (this includes Dire Avenger Exarchs, but not Asurmen himself) have a bonus to their Strength and Toughness equal to the game turn number. This bonus is not cumulative. For example, during game turn 3, all Dire Avenger models in this formation have +3 Strength and +3 Toughness. However, at the end of each Eldar turn, each Dire Avenger unit in the formation must take a number of Toughness tests equal to the game turn number. Remove one model for each Toughness test you pass (not fail) - this represents those unfortunate few who turn to crystal. It is your choice which models in each unit are removed.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Asurmen" id="46a8-f7e0-af4d-ce6a" collective="false" defaultSelectionEntryId="cc90-7fbf-1a08-e9eb" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink name="Asurmen" id="cc90-7fbf-1a08-e9eb" collective="false" hidden="false" import="true" targetId="6ebd-a984-9a9d-6e54" type="selectionEntry"/>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Dire Avengers with Exarch - 3 or more" id="5c29-f7c1-4be2-1a4e" collective="false" defaultSelectionEntryId="f1fb-3846-fff6-4e88" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="3"/>
          </constraints>
