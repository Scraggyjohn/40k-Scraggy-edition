    <profile name="Spectre Holo-Field" id="9052-521c-402a-668d" hidden="false" page="135" publicationId="555e-9663-pubN70264" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">On any turn in which a model with a Spectre Holo-Field moves in the Movement phase, it gains a 5+ cover save until its next Movement phase. If it also makes a Thrust move in the Assault phase, this cover save increases to 4+. Note that cover saves granted by the Spectre Holo-Field do stack with cover saves provided by the Stealth or Shrouded Special Rules, but not those provided by terrain features or fortifications.</characteristic>
      </characteristics>
    </profile>
    <profile name="Spinneret Rifle" id="66e0-8a1c-9de7-ff9e" hidden="false" page="150" publicationId="555e-9663-pubN65910" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">18&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Rapid Fire, Monofilament</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Spirit Stones" id="eaff-e101-2094-e5f2" hidden="false" page="155" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with this upgrade ignores Crew Shaken results on a roll of 2+ and Crew Stunned results on a roll of 4+. Roll immediately when the result is suffered.</characteristic>
      </characteristics>
    </profile>
    <profile name="Splinter Cannon" id="c855-93cb-df38-2a1f" hidden="false" publicationId="555e-9663-pubN112644" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
