    <profile name="Ghosthelm" id="ca07-70a6-88ea-513a" hidden="false" page="153" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
