      </characteristics>
    </profile>
    <profile name="Star Lance (Melee)" id="88f7-8ae6-c8d7-1d3e" hidden="false" page="152" publicationId="555e-9663-pubN65910" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
