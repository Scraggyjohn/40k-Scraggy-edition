    <profile name="Reaper Rangefinder" id="63b1-d94e-d5e8-1b6a" hidden="false" page="154" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemies cannot take Jink saves against shots fired by a model equipped with a Reaper Rangefinder.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rune Armour" id="5ea3-45bc-4196-f789" hidden="false" page="153" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Rune Armour confers a 4+ Invulnerable Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Scatter Laser" id="20df-1398-62ba-3600" hidden="false" page="149" publicationId="555e-9663-pubN65910" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">36&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
