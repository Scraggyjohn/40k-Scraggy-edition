    <selectionEntry name="Dire Avenger Shrine" id="1ac1-ceda-dee4-00dc" collective="false" hidden="false" import="true" page="143" publicationId="555e-9663-pubN65910" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Killing Strike" id="124b-9c5d-5cc7-f680" hidden="false" page="143" publicationId="555e-9663-pubN65910">
          <description>Once per game, in the Shooting phase, this Formation can perform a Killing Strike. For the duration of that phase, all Avenger Shuriken Catapults carried by models in this Formation are Assault 3 instead of Assault 2.</description>
        </rule>
        <rule name="Rites of the Avenger" id="cffa-f956-b416-e99e" hidden="false" page="143" publicationId="555e-9663-pubN65910">
          <description>All models in this Formation add 1 to their Ballistic Skill.</description>
        </rule>
        <rule name="Shrinekeepers" id="0183-9e85-1968-2e14" hidden="false" page="143" publicationId="555e-9663-pubN65910">
          <description>Models from this Formation can re-roll failed Morale, Pinning and Fear tests.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Dire Avenger Squads - 3 required, 1 with optional Exarch" id="951e-3035-056b-68b3" collective="false" defaultSelectionEntryId="655c-4226-c5bf-b6e9" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="3"/>
            <constraint id="3f78-5df6-572a-dc54" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
