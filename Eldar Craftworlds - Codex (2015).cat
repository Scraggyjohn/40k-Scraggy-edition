          </rules>
        </selectionEntry>
        <selectionEntry name="Uldanorethi Long Rifle" id="ee0c-88c2-1016-3a6d" collective="false" hidden="false" import="true" page="156" publicationId="555e-9663-pubN116800" type="upgrade">
