        <infoLink name="Preferred Enemy" id="03d6-06ab-8be9-5cad" hidden="false" targetId="f217-b311-e5b1-c8c7" type="rule"/>
        <infoLink name="Stubborn" id="d7ec-8b5e-c9cc-74e4" hidden="false" targetId="a1e0-247a-474f-2f5a" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Desperate Times, Desperate Measures" id="8672-16a2-ebb2-142b" hidden="false" page="130" publicationId="555e-9663-pubN66004">
          <description>All units in this detachment have the Subborn and Preferred Enemy special rulesif the enemy army contains any unit from the following Factions: Chaos Space Marines, Chaos Daemons, Khorne Daemonkin, Renegade Knights.

If this Detachment contains four units, its units can roll to arrive from Deep Strike Reserve from turn 1.</description>
        </rule>
      </rules>
    </forceEntry>
