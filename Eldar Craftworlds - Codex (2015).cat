    <profile name="Tempest Launcher" id="eef4-0828-9132-c663" hidden="false" page="151" publicationId="555e-9663-pubN65910" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
