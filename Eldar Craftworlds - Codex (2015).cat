    <selectionEntry name="Pale Courts Battlehost [FW]" id="1bd4-140a-7f5c-f180" collective="true" hidden="false" import="true" page="178" publicationId="555e-9663-pubN70264" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Forgotten Remnants" id="b977-dea6-e756-95f4" hidden="false" page="178" publicationId="555e-9663-pubN70264">
          <description>A Pale Courts Battlehost may have up to two Craftworld Traits applied to it, modifying the units that may be included within it as well as the special rules it recieves. These Craftworld Traits cost no addition points. A Warhost Detachment that includes a Pale Courts Battlehost may include no other types of Core choice, but may include other Pale Courts Battlehosts as long as they have the same Craftworld Traits applied to them.</description>
        </rule>
      </rules>
