      <rules>
        <rule name="Pride of the Host" id="4354-1b38-0d62-8cd6" hidden="false" page="183" publicationId="555e-9663-pubN70264">
          <description>If all of the models in this Formation are destroyed, the opposing player gains +1 Victory Point - this counts as a Secondary Objective.</description>
        </rule>
        <rule name="Icon of Glory" id="5e76-8d89-14ca-c8d1" hidden="false" page="183" publicationId="555e-9663-pubN70264">
          <description>All models from the same army within 6&quot; of any part of a vehicle&apos;s hull from this Formation may re-roll failed Regroup tests.</description>
