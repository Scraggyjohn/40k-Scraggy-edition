    <selectionEntry name="Skyhunters Squadron [FW]" id="7357-7bba-7aec-2d23" collective="false" hidden="false" import="true" page="183" publicationId="555e-9663-pubN70264" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Skyhunters Squadron" id="35b1-1145-e508-32c4" hidden="false" page="183" publicationId="555e-9663-pubN70264">
          <description>All Lynx bought as part of this Formation form a Vehicle Squadron and must take the same upgrades.</description>
        </rule>
        <rule name="On Wings of Flame" id="2000-e723-d97d-1c42" hidden="false" page="183" publicationId="555e-9663-pubN70264">
          <description>When deployed onto the table using the Deep Strike special rule, a Skyhunter Squadron gains a 4+ cover save until the start of its controlling player&apos;s next turn.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Squadron Members - 1 to 3, with all the same upgrades" id="b8a4-33d7-91dd-879d" collective="false" defaultSelectionEntryId="269d-ea29-096f-b82b" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
          <entryLinks>
            <entryLink name="Lynx [FW]" id="269d-ea29-096f-b82b" collective="false" hidden="false" import="true" targetId="d0df-e295-d66f-9dff" type="selectionEntry"/>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Skyreaver Raiding Echelon [FW]" id="a16e-6101-9645-75a9" collective="false" hidden="false" import="true" page="184" publicationId="555e-9663-pubN70264" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Orbital Reavers" id="a771-853c-f8db-d60e" hidden="false" page="183" publicationId="555e-9663-pubN70264">
          <description>On any turn in which a unit chosen as part of this Formation disembarks from the Vampire Raider, the Vampire Raider gains the Assault Vehicle special rule.</description>
        </rule>
        <rule name="Troop Bay Refit" id="d6c9-a07d-b091-f61c" hidden="false" page="183" publicationId="555e-9663-pubN70264">
          <description>A Vampire Raider taken as part of this Formation may transport Artillery models, with crewman using up a single Transport Capacity point and each Artillery model using up 3 Transport Capacity points.</description>
        </rule>
        <rule name="Skyreaver Raiding Echelon [FW]" id="142f-96eb-5ffd-b6b9" hidden="false" page="184" publicationId="555e-9663-pubN70264">
          <description>- All non-vehicle units in this Formation must begin play embarked on the Vampire Raider.
- This Formation may not include more Vaul&apos;s Wrath Support Batteries than it does Guardian Defender units.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Vampire - 1 required" id="f09e-857d-ec82-4ff3" collective="false" defaultSelectionEntryId="a82d-ca4d-82a1-e4d1" hidden="false" import="true">
