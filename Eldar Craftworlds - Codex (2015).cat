    <profile name="Lynx Pulsar (Saturation)" id="356c-8c7b-eb33-47f1" hidden="false" page="194" publicationId="555e-9663-pubN154929" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
