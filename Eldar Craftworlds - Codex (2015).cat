        <cost name="pts" typeId="points" value="150"/>
      </costs>
      <infoLinks>
        <infoLink name="Eternal Warrior" id="5a21-da05-a9f1-2c1f" hidden="false" targetId="f172-03fe-1e9f-c363" type="rule"/>
        <infoLink name="Fleet" id="5efe-62c8-a837-2096" hidden="false" targetId="39c6-1f20-a156-47f4" type="rule"/>
