    <profile name="Mandiblasters" id="a733-49b0-1a58-c71e" hidden="false" page="154" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During the Fight sub-phase, at the start of the Initiative 10 step, roll a D6 for each model equipped with Mandiblasters. On a result of 4+, an enemy unit that is engaged with the model (attacking player&apos;s choice) suffers a single Wound (saving throws can be taken as normal). Gargantuan Creatures suffer a Wound on a result of 6+ instead of 4+. If a character equipped with Mandiblasters is fighting in a challenge, the Wound must be allocated to his opponent.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mesh Armour" id="96a8-cd3b-9e8c-c772" hidden="false" page="153" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Mesh Armour confers a 5+ Armour Save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mindshock Pod" id="be98-135e-8e71-3502" hidden="false" page="155" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemy models within 12&quot; of a model equipped with a Mindshock Pod subtract 2 from their Leadership when taking Morale, Pinning and Fear tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mirrorswords" id="9d54-df83-1a5e-ed67" hidden="false" page="152" publicationId="555e-9663-pubN65910" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
