    <profile name="Sunrifle" id="e6f0-e2b7-6465-48fd" hidden="false" page="149" publicationId="555e-9663-pubN65910" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
