            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">8</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">8</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic>
            <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">3</characteristic>
            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">3</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">8</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">4</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">6+/4++</characteristic>
          </characteristics>
        </profile>
        <profile name="Yvraine (Psyker)" id="8e5b-0125-ce0a-c292" hidden="false" publicationId="555e-9663-pubN66004" typeId="bc97-dea9-9e88-bb7d" typeName="Psyker">
          <characteristics>
            <characteristic name="Mastery Level" typeId="ca56-02c3-af4b-ea2a">2</characteristic>
            <characteristic name="Disciplines" typeId="ea53-f5c7-08e4-980c">Daemonology (Sanctic), Revenant</characteristic>
          </characteristics>
        </profile>
        <profile name="Warlord Trait: Favoured of Ynnead" id="6e1a-db95-8c8b-3948" hidden="false" publicationId="555e-9663-pubN66004" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and their unit can make a Soulburst action when they are within 14&quot; of a unit that is destroyed, rather than 7&quot;.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Gyrinx Familiar" id="6086-2f1b-bc4a-62dd" hidden="false" publicationId="555e-9663-pubN66004">
          <description>At the start of each Psychic phase, generate D3 extra Warp Charge points.  Only Yvraine can use these Warp Charge points.</description>
        </rule>
        <rule name="Herald of Ynnead" id="cb55-a275-4d61-ec64" hidden="false" publicationId="555e-9663-pubN66004">
          <description>Whenever an Aeldari model is slain within 7&quot; of Yvraine, roll a dice.  On a 4+, Yvraine immediately regains a lost Wound.  If that model was a Psyker, add 1 to Yvraine&apos;s Master Level (to a maximum of Master Level 4) and immediately generate another psychic power for her.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Runesuit" id="b8f5-8751-5018-4e17" collective="false" hidden="false" import="true" publicationId="555e-9663-pubN66004" type="upgrade">
          <constraints>
            <constraint id="276e-b3c2-b7c8-ff68" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
