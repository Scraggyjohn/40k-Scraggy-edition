    <profile name="Holo-fields" id="1ab8-31f6-2817-ceda" hidden="false" page="155" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A vehicle with Holo-fields has a 5+ invulnerable save unless it is Immobilized.</characteristic>
      </characteristics>
    </profile>
    <profile name="Improved Holo-fields" id="c749-d216-03f7-f39a" hidden="false" publicationId="555e-9663-pubN70264" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
