      <rules>
        <rule name="On Lonely Paths" id="24ba-eca4-622e-f07f" hidden="false" page="141" publicationId="555e-9663-pubN70264">
          <description>The Battlehost must include 1-3 units of Eldar Rangers. While within 12&quot; of an Eldar Rangers unit from this Battlehost, all Guardian units that are a part of the Battlehost gain the Move Through Cover special rule.</description>
        </rule>
      </rules>
