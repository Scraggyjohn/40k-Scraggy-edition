      </costs>
      <rules>
        <rule name="Khaine&apos;s Hawks Squadron [FW]" id="172b-abe3-986a-2e81" hidden="false" page="180" publicationId="555e-9663-pubN70264">
          <description>All Nightwings bought as part of this Formation form a vehicle squadron and must take the same upgrades.</description>
        </rule>
        <rule name="Aerial Predators" id="5d9e-d441-84a2-a240" hidden="false" page="180" publicationId="555e-9663-pubN70264">
          <description>When targeting a Zooming enemy Flyer, each Nightwing from this Formation may choose to add the Ignores Cover special rule to any one weapon attack per turn.</description>
        </rule>
        <rule name="Orbital Interceptors" id="1253-3506-b338-d1f2" hidden="false" page="180" publicationId="555e-9663-pubN70264">
          <description>If a Khaine&apos;s Hawks Squadron is in Reserves during a game in which an enemy flyer is brought into play from Reserves, then the Khaine&apos;s Hawks Squadron&apos;s controlling player may re-roll all attempts to bring the Khaine&apos;s Hawks Squadron into play in their next turn.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="2 - 3 Nightwings, all with the same upgrades" id="7fcc-4bc7-82be-5135" collective="false" defaultSelectionEntryId="e5cd-05dc-85e1-37dd" hidden="false" import="true">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="2"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
          <entryLinks>
