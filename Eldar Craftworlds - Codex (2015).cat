      </characteristics>
    </profile>
    <profile name="Vectored Engines" id="b266-e82f-7269-81a1" hidden="false" page="155" publicationId="555e-9663-pubN65910" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Unless it is Immobilised, a vehicle with this upgrade can pivot to face any direction immediately after resolving its shooting attack (in the Shooting phase).</characteristic>
      </characteristics>
    </profile>
    <profile name="Venom Blade" id="ac6e-9757-f843-eb68" hidden="false" publicationId="555e-9663-pubN112644" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
