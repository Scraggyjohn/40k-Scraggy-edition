    <selectionEntry name="Gemini Revenant Squad" id="52bf-8451-c54a-5e3c" collective="false" hidden="false" import="true" page="46" publicationId="555e-9663-pubN78255" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Mindlink" id="9035-b628-d8f8-7151" hidden="false" page="46" publicationId="555e-9663-pubN78255">
          <description>The psychic link between the Revenants in the Gemini Squad has two effects:

- If one of the Revenants scores a hit on a target during the Shooting phase, the other Revenant treats its weapons as Twin-linked if it targets that same unit that phase.

- If an enemy unit&apos;s shooting attack hits a Revenant Titan&apos;s holo-field, place a Forewarned Counter next to the other member of the Gemini Squad (a small coin will do). All subsequent shooting attacks that target a Revenant with a Forewarned Counter can only be made as Snap Shots. Remove all Forewarned Counters at the end of each phase.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Revenant Titans - 2 required" id="8943-450c-e196-f3a4" collective="false" defaultSelectionEntryId="5fb3-0cf5-8ae9-ebd1" hidden="false" import="true">
