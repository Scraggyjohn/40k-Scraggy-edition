        <rule name="Khaine Awakened" id="6ab7-a415-3d7a-c82d" hidden="false" page="137" publicationId="555e-9663-pubN65910">
          <description>The Avatar, and all friendly units with the Eldar faction within 12&quot; of the Avatar, have the Fearless, Furious Charge and Rage special rules.</description>
        </rule>
        <rule name="Molten Body" id="8514-4e5d-69d4-e7e5" hidden="false" page="137" publicationId="555e-9663-pubN65910">
          <description>The Avatar is unaffected by all Pyromancy psychic powers, all flamer weapons as defined in the 40k Rulebook, and all attacks that have the Melta and/or Soul Blaze special rules.</description>
        </rule>
      </rules>
      <selectionEntries>
