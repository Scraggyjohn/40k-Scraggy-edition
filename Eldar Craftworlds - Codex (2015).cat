              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A runesuit confers a 4+ invulnerable save.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Kha-vir, the Sword of Sorrows" id="3136-1c4a-3afe-eaf3" collective="false" hidden="false" import="true" publicationId="555e-9663-pubN66004" type="upgrade">
