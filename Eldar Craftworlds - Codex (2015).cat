    <profile name="Shadowwave Grenade" id="3f36-4f02-f6f0-de12" hidden="false" page="155" publicationId="555e-9663-pubN154929" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Shadowwave grenades are counted as Defensive Grenades.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shimmershield" id="b430-7cdb-f215-9a64" hidden="false" page="154" publicationId="555e-9663-pubN116800" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer and his unit have a 5+ Invulnerable save.</characteristic>
      </characteristics>
    </profile>
