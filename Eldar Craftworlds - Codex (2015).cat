    <selectionEntry name="Shroud of Kurnous" id="45f2-33b4-0390-d32f" collective="false" hidden="false" import="true" publicationId="555e-9663-pubN78013" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Wing Leader (Eldar)" id="b4bb-3221-44f0-b47f" hidden="false" targetId="0afa-6d7d-3afb-0f01" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Psychic Shield" id="880d-e37e-b47f-2d29" hidden="false" publicationId="555e-9663-pubN78013">
          <description>Any Crimson Hunter from this Wing that is within 8&quot; of the Wing&apos;s Hemlock Wraithfighter adds 2 to any Deny the Witch rolls. In addition, the pilot of the Hemlock Wraithfighter has the Shrouding psychic power from the Telepathy discipline, in addition to the other psychic powers it normally has.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Hemlocks - 1 required" id="51e0-cde3-a0af-c139" collective="false" defaultSelectionEntryId="467d-db17-3315-0ed5" hidden="false" import="true">
