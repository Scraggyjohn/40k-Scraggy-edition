    <selectionEntry name="Shadow Spectres Shrine [FW]" id="a034-42ae-8fc7-74c3" collective="false" hidden="false" import="true" page="180" publicationId="555e-9663-pubN70264" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Shadow Spectre Shrine" id="e3df-b12a-d426-d0e4" hidden="false" page="180" publicationId="555e-9663-pubN70264">
          <description>Only one unit in this Formation may include an Exarch.</description>
        </rule>
        <rule name="Rites of the Twilight" id="ace0-d914-5107-1ed5" hidden="false" page="180" publicationId="555e-9663-pubN70264">
          <description>All models in this Formation roll an additional D6 for all Thrust moves and select the two highest dice to determine the distance they may move.</description>
        </rule>
        <rule name="Shrinekeepers" id="07e6-9d4c-d71f-d790" hidden="false" page="180" publicationId="555e-9663-pubN70264">
          <description>Models from this Formation can re-roll failed Morale checks, Pinning tests and Fear tests.</description>
        </rule>
        <rule name="Spectral Blade" id="8b7f-6a9f-184d-eff9" hidden="false" page="180" publicationId="555e-9663-pubN70264">
          <description>All enemy models within 12&quot; of an Exarch that is part of this Formation must re-roll all successful Fear tests.</description>
        </rule>
      </rules>
