        <rule name="Warlord Trait: Mark of the Incomparable Hunter" id="5697-71b5-841b-545e" hidden="false" page="148" publicationId="555e-9663-pubN65910"/>
        <rule name="Whirlwind of Death" id="c814-1b98-18d5-e0c3" hidden="false" page="107" publicationId="555e-9663-pubN65910">
          <description>Maugan Ra can fire the Maugetar twice in each Shooting Phase, either at the same target or at two different targets.</description>
