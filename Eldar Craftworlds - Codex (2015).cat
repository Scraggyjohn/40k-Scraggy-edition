    <selectionEntry name="Hornet Swarm [FW]" id="4161-e029-1703-1556" collective="false" hidden="false" import="true" page="182" publicationId="555e-9663-pubN70264" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Acute Senses" id="6258-b581-2da7-c28b" hidden="false" targetId="e15d-1437-cfb2-b8dd" type="rule"/>
        <infoLink name="Scout" id="b359-b54e-f0d9-2fb9" hidden="false" targetId="1794-e0e0-bedf-e46b" type="rule"/>
        <infoLink name="Skimmer Assault" id="dbfa-92c8-62ed-457d" hidden="false" targetId="4193-5515-9c29-945e" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Swift Assault" id="73bc-2458-3574-29a3" hidden="false" page="182" publicationId="555e-9663-pubN70264">
          <description>On the turn in which this squadron enters play from Reserves, it may use the Jink special rule and fire all weapons at full BS (as long as the squadron does not also move Flat Out, in which case the restrictions of the Skimmer Assault special rule apply).</description>
        </rule>
        <rule name="Death Knell" id="5327-a53e-d349-8777" hidden="false" page="182" publicationId="555e-9663-pubN70264">
          <description>When rolling to bring a Hornet Swarm squadron into play from Reserves, the score require to bring them into play is 2+, as long as the controlling player achieved at least one Primary or Secondary objective in their previous turn.</description>
        </rule>
        <rule name="Hornet Swarm" id="a565-8144-25b5-cd92" hidden="false" page="182" publicationId="555e-9663-pubN70264">
          <description>All Hornets bought as part of this Formation form a Vehicle Squadron and must take the same upgrades.</description>
        </rule>
      </rules>
