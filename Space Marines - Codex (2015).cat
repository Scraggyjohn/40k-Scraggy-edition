          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Raven&apos;s Fury is a jump pack.  When a model equipped with Raven&apos;s Fury makes Hammer of Wrath attacks, they are resolved at +2 Strength and have the Strikedown special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Chapter Relic (RG): The Armour of Shadows" id="8643-25ad-ebf7-7d26" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="f91e-eb05-8116-7d9c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
