            <profile name="Xiphon Rotary Missile Launcher" id="b337-7488-9267-5525" hidden="false" publicationId="7ab0-ceb9-pubN174565" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60&quot;</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2, Cluster Warhead, Terminal Tracking</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Cluster Warhead" id="72cf-da64-4ebb-3471" hidden="false" publicationId="7ab0-ceb9-pubN174565">
              <description>If the weapon successfully scores a Penetrating hit on a target with an Armour value, roll D3 times on the Vehicle Damage table and select the highest result to apply.</description>
            </rule>
            <rule name="Terminal Tracking" id="79c7-fd21-6f66-f774" hidden="false" publicationId="7ab0-ceb9-pubN174565">
              <description>Successful Jink and Cover saves against this weapon must be re-rolled.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
