                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Ordnance 1, Barrage, Massive Blast, One Use Only, Orbital</characteristic>
                        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
                      </characteristics>
