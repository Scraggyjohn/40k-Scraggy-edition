        <profile name="Augmented Atomantic Shielding" id="571e-3145-ac81-c55c" hidden="false" publicationId="7ab0-ceb9-pubN211261" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Hecaton Aiakos has a 4+ invulnerable save against shooting attacks and explosions, and a 5+ invulnerable save against attacks suffered in close comabt. In addition, if Aiakos suffers a vehicle explodes damage result, add +2&quot; to the radius of the blast.</characteristic>
