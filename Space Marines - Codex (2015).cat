        </profile>
      </profiles>
      <rules>
        <rule name="Incandescent" id="5f57-4b09-5007-0897" hidden="false" publicationId="7ab0-ceb9-pubN65751">
          <description>At the end of an Assault phase in which the bearer made one or more To Hit rolls with the Burning Blade, roll a D6.  On a roll of 2+, nothing happens.  On a roll of a 1, the bearer takes a Strength 4 AP2 hit.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Chapter Relic: The Armour Indomitus" id="3099-4a51-d032-e9d2" collective="false" hidden="false" import="true" type="upgrade">
