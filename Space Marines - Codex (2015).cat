    <profile name="Warlord Trait: Champion of Humanity" id="b718-b82d-98a1-0ea3" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord, and all friendly units within 12&quot; of your Warlord with a Faction that is part of the Armies of the Imperium must re-roll failed Morale checks, Pinning tests, and fear tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Centurion Sergeant" id="9008-9845-c718-888e" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic>
        <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">4</characteristic>
        <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
        <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">5</characteristic>
        <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">5</characteristic>
