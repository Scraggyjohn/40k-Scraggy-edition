        <infoLink name="Master-crafted" id="4c92-5301-183b-a244" hidden="false" targetId="609e-1ee4-78c1-0ba1" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Chapter Relic (IH): The Axe of Medusa" id="ebad-bbea-03d5-2210" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+2</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Master-crafted, Severing Strike, Unwieldy</characteristic>
            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Severing Strike" id="3794-df0b-40f3-1989" hidden="false" publicationId="7ab0-ceb9-pubN65665">
          <description>Each time the bearer of the Axe of MEdusa rolls a 6 to Hit, resolve that attack at +4 Strength instead.  Any other hits are resolved at 2+ Strength as normal.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Chapter Relic (IH): The Tempered Helm" id="c00d-9ee7-8e27-dc95" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="5127-d659-1e46-2df4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
