      <profiles>
        <profile name="Mars Warlord Battle Titan" id="1133-f9b2-a1df-b0ba" hidden="false" publicationId="7ab0-ceb9-pubN209104" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413" typeName="Walker">
          <characteristics>
