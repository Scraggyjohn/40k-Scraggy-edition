        <rule name="Swift Strike" id="31d3-cefc-8d44-96af" hidden="false" publicationId="7ab0-ceb9-pubN210790">
          <description>Korvydae and an Jump Pack equipped squad he is leading gain the Hit and Run special rule.</description>
        </rule>
        <rule name="Raiding Tactics" id="2813-bb34-a456-f2a5" hidden="false" page="112" publicationId="7ab0-ceb9-pubN210717">
          <description>Korvydae usually leads a fast moving raiding force. If your army is led by Korvydae then it must include at least one Space Marine Scout squad. It may also take any Assault squads as a Troops choice instead of a Fast Attack choice.</description>
        </rule>
      </rules>
    </selectionEntry>
