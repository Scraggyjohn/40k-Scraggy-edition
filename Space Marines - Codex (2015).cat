      </costs>
      <infoLinks>
        <infoLink name="Shred" id="78df-f650-0efa-d446" hidden="false" targetId="5770-35c6-7341-5527" type="rule"/>
        <infoLink name="Specialist Weapon" id="5050-240b-bee6-3225" hidden="false" targetId="6981-e5a9-c7d1-9332" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Chapter Relic (RG): Swiftstrike and Murder (Details)" id="b76a-7b6c-d364-7d08" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Swiftstrike and Murder replace both a model&apos;s bolt pistol and Melee weapon. Each can be used as a Melee weapon with the following profile.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chapter Relic (RG): Swiftstrike and Murder" id="8f40-6237-bbe7-0b6c" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Flurry, Shred, Specialist Weapon</characteristic>
            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Flurry" id="c162-1aa9-0596-4179" hidden="false" publicationId="7ab0-ceb9-pubN65665">
          <description>After a model attacking with this weapon has rolled to hit, it makes a number of bonus attacks equal to the number of hits that have been scored.  Further hits do not cause futher bonus attacks.</description>
        </rule>
      </rules>
    </selectionEntry>
