      <rules>
        <rule name="Veteran Doctrine" id="ce31-7b58-3ecf-163c" hidden="false" publicationId="7ab0-ceb9-pubN162620">
          <description>When activating either the Devastator, Assault or Tactical Doctrine as part of the Ultramarines Chapter Tactics, units from this Formation instaed re-roll all failed to Hit rolls in the Shooting and Assault phases of that turn.</description>
        </rule>
        <rule name="Paragons of the Imperium" id="6d32-5f6b-2fe7-a7e1" hidden="false" publicationId="7ab0-ceb9-pubN162620">
          <description>Friendly units from the Armies of the Imperium within 6&quot; of any units from this Formation have the Stubborn special rule.</description>
        </rule>
      </rules>
