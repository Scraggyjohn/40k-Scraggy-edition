      <rules>
        <rule name="Targeted Strike" id="5178-5c3b-5a11-07b4" hidden="false" publicationId="7ab0-ceb9-pubN65665">
          <description>When the first unit from this Formation is deployed or arrives from Reserve, nominate a unit in the enemy army to be the Assault Group&apos;s starget.  Units from this Formation re-roll failed To Hit rolls against that unit for the duration of the battle.</description>
        </rule>
        <rule name="Vertical Insertion" id="73dc-3501-5c31-be0e" hidden="false" publicationId="7ab0-ceb9-pubN65665">
          <description>The Stormraven Gunship from this Formation has the Deep Strike special rule.  If it arrives from Deep Strike, it must Hover on the turn it arrives.</description>
        </rule>
      </rules>
