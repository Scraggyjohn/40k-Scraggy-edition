      <profiles>
        <profile name="Chapter Relic: The Armour Indomitus" id="b661-d192-e4ec-02a6" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Armour Indomitus confers a 2+ Armour Save and a 6+ invulnerable save. Once per game, at the beginning of any phase, the wearer can choose to temporarily push the armour&apos;s force field to its limit. For the duration of that phase, the Armour Indomitus confers a 2+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
