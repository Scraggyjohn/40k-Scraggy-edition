    <selectionEntry name="Chapter Relic (IF): The Angel of Sacrifice" id="3115-3d92-ac62-43d6" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="b36d-6bb4-81cd-18b8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
