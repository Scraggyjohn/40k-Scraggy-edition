          </costs>
          <profiles>
            <profile name="Siege Melta Array" id="4208-cefc-3167-1984" hidden="false" page="2" publicationId="7ab0-ceb9-pubN218282" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
