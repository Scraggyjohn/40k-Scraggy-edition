    <selectionEntry name="Combi-Melta" id="62a2-9d6d-f287-cb31" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="10"/>
      </costs>
      <infoLinks>
        <infoLink name="Boltgun" id="0db7-1a31-1fbe-8d70" hidden="false" targetId="3d4b-95ea-f860-dd22" type="profile"/>
        <infoLink name="Meltagun" id="0e18-aca0-f157-f9fb" hidden="false" targetId="ec4c-1132-ddaf-db8e" type="profile">
          <modifiers>
            <modifier field="077c342f-d7b9-45c6-b8af-88e97cafd3a2" type="append" value=", One Use Only"/>
