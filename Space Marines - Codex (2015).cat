          <infoLinks>
            <infoLink name="Strikedown" id="18af-f28e-cf31-aec2" hidden="false" targetId="b500-e499-9f9b-43f4" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Groundstrike" id="f1df-0cfd-4e2f-2ffa" hidden="false" publicationId="7ab0-ceb9-pubN211261" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Instead of making his usual attacks in close combat, Hecaton Aiakos may instead make a special groundstrike attack, smashing the earth before him and discharging his atomantic field. sending violent shockwaves through the ground. This attack is carried ouit at initiative step 1 of the fight sub-phase, and automatically inflicts 1 hit against each enemy unit engaged with Aiakos for each model in that unit in base contact.                           Range      Strength     AP       Type Groundstrike        -                 6            4         Melee, Strikedown</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
