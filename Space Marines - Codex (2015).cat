          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Twin-Linked" id="ffde-daa8-760c-cc03" hidden="false" targetId="3002-de38-7230-fbc6" type="rule"/>
            <infoLink name="Melta" id="d9fe-530c-7331-bd8e" hidden="false" targetId="bc4c-234f-0293-98a7" type="rule"/>
