          <rules>
            <rule name="Prey&apos;s Bane" id="781a-4076-6f7d-53a4" hidden="false" publicationId="7ab0-ceb9-pubN65751">
              <description>When attacking with a weapon that has this special rule, a To Wound roll of 6 causes a Wound regardless of the target&apos;s Toughness.  This Wound is resolved with the Instant Death special rule.</description>
            </rule>
          </rules>
        </selectionEntry>
