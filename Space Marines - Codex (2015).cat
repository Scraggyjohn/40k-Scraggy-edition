      </costs>
      <infoLinks>
        <infoLink name="Adamantium Will" id="2489-2424-0949-a7ab" hidden="false" targetId="8714-46ad-62c0-ce35" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Chapter Relic (WS): Mantle of the Stormseer" id="eb3a-d736-6703-3587" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with the Mantle of the Stormseer has the Adamantium Will special rule and knows the Psychic Maelstrom power from the Telekinesis discipline in addition to any others he knows.  This is not considered when determining if he has Psychic Focus.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
