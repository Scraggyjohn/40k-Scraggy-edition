        </profile>
      </profiles>
      <rules>
        <rule name="Master of the Devastator Company" id="5083-62ea-eda5-ec95" hidden="false" publicationId="7ab0-ceb9-pubN146351">
          <description>If Zhrukhal Androcles is present in a detachment, then Devastator squads may be taken as Elites choices for the detachment as well as Heavy Support choices.</description>
