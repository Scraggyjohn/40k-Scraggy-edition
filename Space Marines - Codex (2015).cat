            <profile name="Neutron Laser Battery" id="5e41-bea3-813b-26c8" hidden="false" publicationId="7ab0-ceb9-pubN192504" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">72&quot;</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">10</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Primary Weapon D3, Concussive, Feedback, Shock Pulse</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Feedback" id="dd80-fff2-8d17-1582" hidden="false" publicationId="7ab0-ceb9-pubN192504">
              <description>If a weapon with this type fail it Penetration roll against a target vehicle&apos;s armour or fails a To Wound roll against a target model roll a D6. If the result is a 1, dangerous energy feedback along the beam causes the firing model to lose 1 Hull Point or Wound.</description>
            </rule>
            <rule name="Shock Pulse" id="30cc-f45f-1735-0cae" hidden="false" publicationId="7ab0-ceb9-pubN192504">
              <description>Any vehicle (including super-heavy vehicles) that suffers a Penterating hit from a weapon with this type may only fire Snap Shots in the following game turn.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
