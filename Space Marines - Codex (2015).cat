      <profiles>
        <profile name="Chapter Relic (IH): The Tempered Helm" id="28ff-00f6-1344-015b" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When taking Morale tests, all friendly units within 24&quot; of the bearer can use his Leadership characteristic instead of their own.  Furthermore, nominate a single friendly unit within 12&quot; of the bearer at the start of each of his Shooting phases.  That unit can re-roll all To Hit rolls of 1 in that Shooting phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Chapter Relic (IH): The Gorgon&apos;s Chain" id="93d1-148b-bf4e-223e" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="1d70-40a2-27c8-e1df" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="45"/>
      </costs>
      <profiles>
        <profile name="Chapter Relic (IH): The Gorgon&apos;s Chain" id="d546-fef4-952e-40bb" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Bearer of the Gorgon&apos;s Chain has the following special rules, depending on how many unsaved Wounds he has suffered during the battle.  0: The bearer has a 3+ invulnerable save, +1 to his Feel No Pain rolls, and the Eternal Warrior special rule. 1: The bearer has a 3+ invulnerable save, and the Eternal Warrior special rule. 2: The bearer has a 3+ invulnerable save. 3+: The bearer has a 4+ invulnerable save.  Each time the bearer suffers an unsaved Wound, or recovers a Wound as a reuslt of the It Will Not Die rule, the effects of the Gorgon&apos;s Chain change immediately; you should roll the bearer&apos;s saves individually.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
