            <constraint id="596a-9578-9656-b10c" field="selections" includeChildForces="true" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Auxiliary" id="1efa-5fec-3ec7-ae5b-ef2b-83bd-1bad-5742" hidden="false" primary="false" targetId="ef2b-83bd-1bad-5742">
          <constraints>
