        <cost name="pts" typeId="points" value="10"/>
      </costs>
      <infoLinks>
        <infoLink name="Concussive" id="003a-63eb-0001-c1fb" hidden="false" targetId="d0ea-e2a6-032d-8754" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Chapter Relic (IF): The Angel of Sacrifice" id="b337-305d-1971-64ee" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+2</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Concussive, Only in Death</characteristic>
            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Only in Death" id="5da2-ac82-0cc0-922c" hidden="false" publicationId="7ab0-ceb9-pubN65665">
          <description>If the bearer of the Angel of Sacrifice loses his last Wound in the Assault phase, he is not removed as a casualty until after all close combat attack have been resolved, and can thus still attack if he is slain either by Overwatch or by a close combat attack made at a higher Initiative step.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Chapter Relic (IF): The Bones of Osrak" id="c1d3-185d-1e3b-4145" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="5f7f-75ed-f28f-8fba" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
