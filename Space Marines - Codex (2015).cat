          <characteristics>
            <characteristic name="Capacity" typeId="15aa-1916-a38b-d223">1 Dreadnought of any type.</characteristic>
            <characteristic name="Fire Points" typeId="fe20-e124-2c11-86ee">Open-Topped.</characteristic>
            <characteristic name="Access Points" typeId="21e5-4518-a31c-7e56">Open-Topped.</characteristic>
          </characteristics>
