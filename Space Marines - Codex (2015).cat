          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Hood of Hellfire is a psychic hood.  Furthermore, it enables Tigurius to re-roll failed Psychic tests.</characteristic>
          </characteristics>
        </profile>
        <profile name="Chief Librarian Tigurius" id="11dd-710c-faa8-fab2" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
          <characteristics>
