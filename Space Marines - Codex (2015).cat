    <selectionEntry name="Chapter Relic (WS): The Hunter&apos;s Eye" id="b9fb-fe5e-fa95-3411" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="acfa-b6db-7a35-9d40" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="20"/>
      </costs>
      <infoLinks>
        <infoLink name="Ignores Cover" id="5db8-b66f-0c5c-680c" hidden="false" targetId="52f9-9dcb-b6ed-0562" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Chapter Relic (WS): The Hunter&apos;s Eye" id="f329-aae6-e151-3c6c" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with the Hunter&apos;s Eye adds one to his Ballistic Skill and all his ranged weapons have the Ignores Cover special rule.  Whilst a model equipped with the Hunter&apos;s Eye is part of a unit, all other ranged weapons carried by models in that unit also have the Ignores Cover special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Chapter Relic (WS): Mantle of the Stormseer" id="9b63-6d51-91ed-4ced" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="b36b-cc14-a328-b883" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
