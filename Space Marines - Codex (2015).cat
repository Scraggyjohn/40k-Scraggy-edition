    <selectionEntry name="Chapter Relic (UM): The Standard of Macragge Involate" id="e8da-4376-f352-15a4" collective="false" hidden="false" import="true" publicationId="7ab0-ceb9-pubN67599" type="upgrade">
      <constraints>
        <constraint id="a187-1926-d5ec-815e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="60"/>
      </costs>
      <profiles>
        <profile name="The Standard of Macragge Involate" id="65c0-a56a-5485-aec1" hidden="false" publicationId="7ab0-ceb9-pubN67599" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly Ultramarines units within 12&quot; of the bearer of this standard add 1 to their Leadership characteristic.  In addition, the bearer and his unit have +1 attack while the bearer is alive.  Finally, roll a dice each time a friendly Ultramarines Infantry model is killed within 6&quot; of this standard, before removing the model as a casualty; on a 6+ that Space Marine can make an out-of-sequence shooting attack if it is the Movement, Psychic or Shooting phase, or pile in and make its attacks if it is the Fight sub-phase (at the normal Initiative step).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Special Issue Ammunition" id="979b-7bd3-f75f-7837" collective="false" hidden="false" import="true" publicationId="7ab0-ceb9-pubN65751" type="upgrade">
