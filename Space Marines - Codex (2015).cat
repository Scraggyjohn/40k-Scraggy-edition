    <selectionEntry name="Formation: Suppression Force" id="fe6c-f459-7cb6-e3b8" collective="false" hidden="false" import="true" publicationId="7ab0-ceb9-pubN113504" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
