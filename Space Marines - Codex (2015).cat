      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <selectionEntryGroups>
        <selectionEntryGroup name="Warlord Traits" id="0430-71ec-d077-30a2" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="7480-c314-dd73-67ef" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="784c-836b-3f40-84eb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink name="BRB: Command Traits" id="66dd-242d-1801-ed81" collective="false" hidden="false" import="true" targetId="0b55-7df5-6a9b-5bb5" type="selectionEntry"/>
            <entryLink name="BRB: Tactical Traits" id="aad6-4c6c-b926-238f" collective="false" hidden="false" import="true" targetId="0f45-5929-8943-b671" type="selectionEntry"/>
            <entryLink name="BRB: Strategic Traits" id="0a09-f489-f624-7346" collective="false" hidden="false" import="true" targetId="73c8-d406-de8b-c737" type="selectionEntry"/>
            <entryLink name="BRB: Personal Traits" id="a7af-1be4-ab84-e4e2" collective="false" hidden="false" import="true" targetId="8e36-5536-b939-49d4" type="selectionEntry"/>
          </entryLinks>
          <selectionEntries>
            <selectionEntry name="Black Templars" id="87dd-3be4-d67f-ea8d" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="276a-f653-dc2c-9f1a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Warlord Trait: Abhor the Witch" id="ad20-faa8-92e7-2ece" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Hatred (Psykers) and Preferred Enemy (Psykers) special rules.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Furious Indignation" id="984b-dfc7-5128-12e3" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your Warlord&apos;s unit fails a Morale check in the Psychic or Shooting phase, then instead of Falling Back they will immediately move 2D6&quot; towards the nearest enemy unit (but must end this move 1&quot; away from other units as normal).</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Honour Demands Combat" id="91ab-1a1d-2a78-b2c7" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll failed charge rolls for your Warlord and his unit.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Master Swordsman" id="6ecb-814f-e428-4fbe" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to your Warlord&apos;s Weapon Skill and Attacks characteristics.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Unyielding Determination" id="b8dd-f01f-fad5-52a6" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and all friendly units within 12&quot; of him re-roll all failed Morale, Pinning, and Fear tests.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Oathkeeper" id="ecda-2396-6cb0-d544" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Fearless special rule.  In addition, he re-rolls failed To Hit rolls when fighting in a challenge.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Crimson Fists" id="a0f6-04e3-352d-5cb8" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="819d-ff65-9d7a-a84b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Warlord Trait: Refuse to Die" id="14b7-e259-3c62-6a12" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Eternal Warrior special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Pain is for Lesser Warriors" id="ae3a-db18-f069-f260" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Feel No Pain special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Expert Instructor" id="d33d-782c-fe8c-7759" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your Warlord does not make a Shooting attack or Run in the Shooting phase, you can nominate one friendly model within 12&quot; of him.  That model can use your Warlord&apos;s Ballistic Skill this phase.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Rynn&apos;s World Veteran" id="985b-2826-f635-7983" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and his unit have the Hatred (Orks) and Preferred Enemy (Orks) special rules.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Scion of Dorn" id="e069-8f2e-b762-0651" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and all friendly Crimson Fists within 12&quot; of him have the Fearless special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Tenacious Defender" id="b166-8fe5-bbd1-bd10" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and his unit have the Counter-attack and Stubborn special rules whilst they are within 3&quot; of an Objective Marker</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Space Marines" id="f83f-c102-c344-65cb" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <profiles>
                <profile name="Warlord Trait: Angel of Death" id="70ff-0b3a-8abc-0b18" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Fear special rule. Furthermore, enemy units locked in combat with the Warlord must take Fear tests on 3D6</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Champion of Humanity" id="7202-3a16-ba4b-f41b" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord, and all friendly units within 12&quot; of your Warlord with a Faction that is part of the Armies of the Imperium must re-roll failed Morale checks, Pinning tests, and fear tests.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Iron Resolve" id="7701-e440-7f9f-3427" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Feel No Pain special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Rites of War" id="47f1-ab89-a2a1-3291" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All models in your Warlord&apos;s Detachment can use his Leadership value in place of their own.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Storm of Fire" id="c8d2-1dea-b023-4cf3" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each of your Shooting phases, nominate on friendly unit within 12&quot; of your Warlord that is drawn from the same Chapter as your Warlord.  That unit&apos;s ranged weapons have the Rending special rule until the end of the phase.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: The Imperium&apos;s Sword" id="f5f4-9635-ea5f-d931" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord, and his unit, have the Furious Charge special rule.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Imperial Fists" id="6500-3047-7a82-7876" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <entryLinks>
                <entryLink name="Orbital Strike" id="fa1b-d3b2-6201-5a59" collective="false" hidden="false" import="true" targetId="518a-26f7-f60b-b5e3" type="selectionEntry"/>
              </entryLinks>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="9dc7-a061-d8cc-5b1b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Warlord Trait: Indomitable" id="31fe-00a7-3808-1a85" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If your Warlord and his unit do not move in their Movement phase, then he and his unit have the Fearless and Counter-attack special rules until the start of their next turn.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Architect of War" id="68f4-3dd0-bc0b-ce0c" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Whilst your Warlord is embarked inside a building, all damage rolls against that building suffer a -1 penalty, to a minimum of 1.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Fleet Commander" id="64fa-590f-3ec5-a88e" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per game, your Warlord can call down an orbital strike in his Shooting phase.  This counts as firing a ranged weapon with Orbital Strike profile.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Siege Lord" id="ecd2-496e-6de5-a445" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and his unit add 1 to the result when rolling on the Building Damage table.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Tenacious Opponent" id="f78f-9b73-69fd-554b" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the It will Not Die special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Wise Commander" id="69d8-801f-f1c5-2659" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Whilst your Warlord is alive, you can choose to add or subtract 1 from any of your Reserve Rolls (state which before the dice is rolled)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="White Scars" id="f7c6-5c64-2a71-1f89" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="9704-1526-9b73-d370" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Warlord Trait: Deadly Ambush" id="6ba6-ba1a-21c6-6c8e" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can add or subtract 1 from the result of any Reserve Rolls you make while your Warlord is on the battlefield or in Reserve</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Hammer of the Khan" id="ee2f-44e5-562a-54e5" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Hammer of Wrath special rule.  If he already has this special rule, he makes D3 additional attacks instead of 1.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Master Rider" id="67ac-789f-9408-c1ad" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the result of any Jink saves you make for your Warlord if he is equipped with a Space Marine bike.  If he is not, treat this result as Deadly Ambush instead.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Hunter&apos;s Insticts" id="7eb7-4aed-8377-9b1e" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Monster Hunter and Tank Hunters special rules.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Unrivalled Hunter" id="cf07-9e01-7433-1788" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to your Warlord&apos;s Strength and Attacks characteristics while he is fighting in a challenge.  If he is fighting in a challenge against an enemy Warlord, he can also re-roll failed To Hit rolls.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Merciless Warrior" id="ad99-d8ba-62d2-137e" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When your Warlord or a friendly White Scars unit within 12&quot; makes a Sweeping Advance, you can re-roll the dice.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Iron Hands" id="9456-e360-7dfb-9d2d" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="5aca-640d-4e58-9f54" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Warlord Trait: Adept of the Omnissiah" id="a602-72ae-2a39-a020" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Blessing of the Omnissiah special rule.  If the Warlord already has this special rule, he may re-roll any failed attempts to repair a vehicle.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: All Flesh is Weakness" id="b0a2-b016-cc88-57ee" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has +1 on any Feel No Pain rolls he makes</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Will of Iron" id="c817-29eb-39af-acf6" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Fearless special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Student of History" id="e927-36d5-a883-3f75" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and any Iron Hands unit he joins can choose to automatically fail any Morale check they are required to make.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Target Protocols" id="f6b4-01ee-3219-e055" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and any Iron Hands unit he joins re-roll To Hit rolls of 1 in the Shooting phase.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Merciless Resolve" id="fb7f-9e58-ea8f-d520" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and all friendly Iron Hands units within 12&quot; of him have the Crusader special rule.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Salamanders" id="9b3d-5616-3a14-22f3" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="983e-4995-e88b-3806" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Warlord Trait: Anvil of Strength" id="799a-e733-85d6-6c58" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord adds 1 to his Strength</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Forge Master" id="8e06-3f4e-3ead-b4aa" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord can re-roll all failed To Hit rolls with any Master-crafted weapons he is equipped with, instead of only re-rolling one failed to Hit roll per turn.  This includes any Chapter Relics and Relics of Nocturne that have the Master-crafted special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Lord of Fire" id="9b32-278c-c4cf-b2b4" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Feel No Pain (2+) special rule against wounds caused by flamer weapons.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Never Give Up" id="9234-1534-1814-b05a" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and any Salamanders units within 12&quot; of him have the Stubborn special rule and can re-roll failed Leadership tests.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Miraculous Constitution" id="8eb2-44bb-405b-47f7" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the It Will Not Die special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Patient and Determined" id="5c1a-6970-9cb5-76c6" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the mission uses Variable Game Length, you can always choose to add 3 to any D6 roll that determines if the game ends or continues.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Raven Guard" id="5fcb-8a32-9fdd-5f5b" collective="false" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="b2f7-ca3e-dadc-94af" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Warlord Trait: Vanish into the Gloom" id="2973-4722-d750-f548" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When your Warlord&apos;s unit is chosen as the target of a shooting attack, it can immediately Vanish into the Gloom, moving up to D6&quot;.  Models from your Warlord&apos;s unit that are in cover at the end of this move receive +1 to their cover saving throws against that shooting attack.  The firing unit cannot choose a different target, even if your Warlord&apos;s unit is now out of range or line of sight.  Your Warlord&apos;s unit can only Vanish into the Gloom once per turn and cannot do so at all if Falling Back or charging.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Silent Stalker" id="5e0c-5c1f-bef2-74a8" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Enemy units wishing to fire Overwatch at your Warlord or his unit must first pass a Leadership test.  If your Warlord charged through dificult terrain, subtract 2 from the enemy unit&apos;s Leadership when they take this test.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Concentrated Attack" id="cafa-1394-c6f8-a2ae" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of your Charge phase, pick an enemy unit within your Warlord&apos;s line of sight.  Until the end of the phase, Raven Guard units can re-roll charge rolls against that unit.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Exit Strategy" id="0a56-cba4-ebde-190b" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When rolling for Variable Game Length, you can add or subtract 1 from the result if your Warlord is on the battlefield.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Master of Shadows" id="9f44-2896-4a1f-59a5" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per game, as long as your Warlord is on the battlefield, you can declare in your Movement phase that Night Fighting rules are in effect until the start of your next turn.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Swift and Deadly" id="f5fc-01a2-8fe8-bcb2" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, your Warlord, and any unit he has joined, can charge even if they Ran in the preceding Shooting phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Ultramarines" id="8318-cf5a-df3f-1973" collective="false" hidden="false" import="true" publicationId="7ab0-ceb9-pubN67599" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="bed2-6bd4-f664-9cdf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="lessThan" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Warlord Trait: Paragon of War" id="791f-ddf9-c117-f6c8" hidden="false" publicationId="7ab0-ceb9-pubN67599" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Preferred Enemy special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Master of Tactics" id="76db-8020-88cf-933f" hidden="false" publicationId="7ab0-ceb9-pubN67599" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">As long as your Warlord is alive, at the beginning of each of your turns, you can discard an active Tactical Objective.  If you do so, you can generate a new Tactical Objective.  Re-roll this result if you are not playing a mission with the Tactical Objectives special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Adept of the Codex" id="e004-2bc6-d643-4fae" hidden="false" publicationId="7ab0-ceb9-pubN67599" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord and all friendly units within 6&quot; of him have the Split Fire special rule.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Noble Visage" id="a9f5-781e-9522-b72d" hidden="false" publicationId="7ab0-ceb9-pubN67599" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord, and all friendly units within 12&quot; of your Warlord with a Faction that is part of the Armies of the Imperium, must re-roll failed Morale checks, Pinning Tests, and Fear tests.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Master of Strategy" id="9c02-e06b-cdfa-20c9" hidden="false" publicationId="7ab0-ceb9-pubN67599" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can add 4 to any roll to Seize the Initiative.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warlord Trait: Warden of Ultramar" id="469b-45a2-ec4e-a3d1" hidden="false" publicationId="7ab0-ceb9-pubN67599" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Your Warlord has the Counter-attack special rule</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
