      <rules>
        <rule name="Unstoppable Advance" id="088d-055b-fd58-ebcc" hidden="false" publicationId="7ab0-ceb9-pubN179327">
          <description>All Rhinos, Razorbacks and Land Raiders in a primary detachment commanded by Tarnus Vale gain an Invulnerable save of 5+ against glancing hits.</description>
        </rule>
        <rule name="Master Gunner" id="ff33-ab9e-5418-e8bd" hidden="false" publicationId="7ab0-ceb9-pubN179327">
          <description>Any friendly vehicle with the sub-type (Tank) chosen from Codex: Space Marines or the Space Marine Siege Assault Vanguard army list in which Captain Vale is being transported gains the benefit of his Ballistic Skill and the Tank Hunters special rule.</description>
        </rule>
      </rules>
