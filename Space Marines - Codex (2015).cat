    <profile name="Hurricane Bolter" id="d8a7-b6a2-5688-d59d" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
