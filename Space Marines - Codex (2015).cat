      <rules>
        <rule name="Reactor Blast" id="4a28-212d-86d5-48f0" hidden="false" publicationId="7ab0-ceb9-pubN192504">
          <description>Should the Cerberus lose its last Hull Point, it rolls on the Catastrophic Damage table with a +1 modifier, The vehicle is then removed.</description>
