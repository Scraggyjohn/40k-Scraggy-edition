      <profiles>
        <profile name="Chapter Relic (SAL): The Tome of Vel&apos;Cona" id="7930-85ce-d77b-6f3b" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model equipped with the Tome of Vel&apos;cona knows the Molten Beam power from the Pyromancy discipline in addition to any others he knows.  This is not considered when determining if he has Psychic Focus.  In addition, the bearer of the Tome of Vel&apos;cona can add 1 to the Strength of all Pyromancy witchfire powers he uses.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
