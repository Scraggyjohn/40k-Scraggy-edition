    <selectionEntry name="Formation: Centurion Siegebreaker Cohort" id="7283-b32e-d6f4-cbbc" collective="false" hidden="false" import="true" publicationId="7ab0-ceb9-pubN113504" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Castraferrum-Ironclad Dreadnoughts" id="20c1-fcd5-c889-4151" collective="false" hidden="false" import="true" targetId="fb1b-d00b-3c7b-605e" type="selectionEntry">
          <constraints>
