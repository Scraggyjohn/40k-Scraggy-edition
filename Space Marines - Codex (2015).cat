                <profile name="Heavy Conversion Beamer (Details)" id="0fc9-8c76-6dc0-e79d" hidden="false" publicationId="7ab0-ceb9-pubN192504" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When firing the heavy conversion beamer, place the blast marker over a target within 72&quot; and then roll for scatter.  Once the final location of the blast marker has been determined, measure the distance from the firer to the center of the blast marker and consult the chart below to determine the effect.  If this distance is greater than 72&quot;, the shot mises.  If it is not clear which of the profiles to use, the controlling player can choose.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Firing Calibration" id="ebf7-6c78-ade9-722c" hidden="false" publicationId="7ab0-ceb9-pubN192504">
                  <description>This weapon may not be fired if the model carrying it has moved in the same turn, regardless of the Relentless special rule or if the carrying model is a vehicle, etc.</description>
                </rule>
              </rules>
