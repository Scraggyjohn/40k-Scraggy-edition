    <selectionEntry name="Chapter Relic (IH): Betrayer&apos;s Bane" id="bb74-6a98-5a8d-add0" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="c71b-386d-2d0c-5d17" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
