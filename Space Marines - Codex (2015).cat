      <profiles>
        <profile name="Chapter Relic (IH): The Ironstone" id="8f22-d444-cc12-d88e" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly Iron Hands Tanks and Walkers within 6&quot; of the bearer pass their It Will Not Die rolls on a 4+ If this roll is a 6, the Ironstone also repairs a Weapon Destroyed or Immobilised result that the vehicle suffered earlier in the battle (Controlling Player&apos;s choice).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
