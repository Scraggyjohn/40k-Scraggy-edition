          </infoLinks>
          <profiles>
            <profile name="Dreadfire Heavy Flamer (Heavy Flamer)" id="b07e-a549-5d8d-e2c7" hidden="false" publicationId="7ab0-ceb9-pubN146351" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Template</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 1</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
            <profile name="Dreadfire Heavy Flamer" id="e6df-113c-13f7-dace" hidden="false" publicationId="7ab0-ceb9-pubN146351" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">These weapons may either be fired as two individual heavy flamers, or as a single twin-linked meltagun. This choice must be made at the beginning of the Shooting phase, before any dice are rolled for their attacks. If one of the heavy flamers is destroyed, then the remaining heavy flamer cannot use this rule.</characteristic>
              </characteristics>
            </profile>
            <profile name="Dreadfire Heavy Flamer (Twin-linked Meltagun)" id="6a1a-c75a-350b-ba2f" hidden="false" publicationId="7ab0-ceb9-pubN146351" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12&quot;</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 1, Melta</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
