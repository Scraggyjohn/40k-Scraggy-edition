            <characteristic name="Disciplines" typeId="ea53-f5c7-08e4-980c">Librarius, Technomancy, Fulmination, Geokinesis, Biomancy, Divination, Daemonology, Pyromancy, Telekinesis, and Telepathy</characteristic>
          </characteristics>
