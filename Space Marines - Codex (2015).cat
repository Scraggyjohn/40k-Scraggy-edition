        <profile name="Chapter Relic (WS): The Banner of the Eagle" id="ad28-fbd0-73a1-044d" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly White Scars units within 12&quot; of a model with the Banner of the Eagle have the Fleet and Furious Charge special rules.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
