        <profile name="Company Standard" id="b085-5a26-09b5-9335" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units within 12&quot; of a model equipped with the company standard, and drawn from the same Chapter Tactics, re-roll failed Morale checks, Pinning tests and Fear tests.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Chapter Banner" id="236e-afd3-34eb-369f" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="0a3b-ef08-4cbd-b008" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
