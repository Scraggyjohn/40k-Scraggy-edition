      </profiles>
      <rules>
        <rule name="Shadow-shot" id="9ef4-5f14-6060-7863" hidden="false" publicationId="7ab0-ceb9-pubN65665">
          <description>A model equipped with Nihilus can shoot at a different target than the rest of his unit.  When fired at a vehicle, this weapon counts as Strength 6</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Chapter Relic (RG): The Raven Skull of Korvaad" id="181a-33e3-3f9d-f574" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="1b12-150a-7b6f-0d33" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
