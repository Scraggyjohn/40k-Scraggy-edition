        <infoLink name="Objective Secured" id="bcb7-dadf-bcb7-4ce0" hidden="false" targetId="4764-48d9-da41-afaa" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Locate and Secure" id="22fb-3127-2922-c405" hidden="false" publicationId="7ab0-ceb9-pubN109967">
          <description>Scout Squads from this Formation (bot not their Land Speeder Storms) have the Objective Secured special rule.</description>
        </rule>
        <rule name="Outrider Support" id="8d52-3d37-b713-be88" hidden="false" publicationId="7ab0-ceb9-pubN109967">
          <description>Land Speeder Storms from this Formation receive a +1 bonus to any Jink saves if they are within 6&quot; of a Land Speeder from this formation.</description>
        </rule>
        <rule name="Rapid Deployment" id="d7ed-daf3-795a-76c5" hidden="false" publicationId="7ab0-ceb9-pubN109967">
          <description>Scout Squads from this Formation can disembark from their Land Speeder Storm after it has moved, so long as it has not moved more than 12&quot;.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Formation: Raptor Wing" id="df9c-3444-6254-dd0a" collective="false" hidden="false" import="true" page="69" publicationId="7ab0-ceb9-pubN158942" type="unit">
