      <profiles>
        <profile name="Chapter Relic: The Burning Blade" id="1de8-eb25-a38c-a239" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
