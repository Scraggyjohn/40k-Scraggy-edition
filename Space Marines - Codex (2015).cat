    <selectionEntry name="Chapter Relic (IH): The Ironstone" id="4e54-06c1-32f3-3713" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="9300-4e50-5b76-6cbb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
