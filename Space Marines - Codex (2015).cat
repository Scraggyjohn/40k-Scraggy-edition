      <rules>
        <rule name="On Time..." id="36e4-fc22-3c24-3b5f" hidden="false" publicationId="7ab0-ceb9-pubN65665">
          <description>Instead of rolling to see whether a unit of Vanguarg Veterans from this Formation arrives from Reserve, you can choose whether to pass or fail that roll.</description>
        </rule>
        <rule name="...On Target" id="228b-3ca2-0b8b-279e" hidden="false" publicationId="7ab0-ceb9-pubN65665">
          <description>Vanguard Veteran Squads from this Formation can charge on the turn they arrive from Deep Strike if the first model is placed within 9&quot; of at least two Scout Squads from this Formation.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Formation: Bladewing Assault Brotherhood" id="ef5c-91eb-e807-c0c3" collective="false" hidden="false" import="true" page="64" publicationId="7ab0-ceb9-pubN158942" type="unit">
