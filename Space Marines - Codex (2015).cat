    <profile name="Special Ammunition: Dragonfire bolt" id="97df-e579-bc82-b201" hidden="false" publicationId="7ab0-ceb9-pubN65751" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
