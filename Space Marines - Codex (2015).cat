        <infoLink name="Counter-attack" id="5f4f-7129-aff3-702d" hidden="false" targetId="41fe-9e25-f4a8-095b" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Chapter Relic (IF): The Banner of Staganda" id="2645-9acd-3b83-3280" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer has the Counter-Attack and Crusader special rules. In addition, friendly units with 12&quot; of the bearer, and with the same Chapter Tactics, re-roll failed Morale checks and Pinning tests.</characteristic>
