    </selectionEntry>
    <selectionEntry name="Legacy: Battle of Keylek" id="091a-b3ee-7054-fdc2" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="2658-7ca6-b1f8-3184" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
