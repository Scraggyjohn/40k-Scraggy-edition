          </infoLinks>
          <profiles>
            <profile name="The Hellslayer" id="fcd8-f675-18f5-f115" hidden="false" publicationId="7ab0-ceb9-pubN146351" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">x2</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Unwieldy, Two-handed, Master-crafted, Concussive, Slayer (Daemon &amp; Psyker)</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Slayer (Daemon &amp; Psyker)" id="892e-6e02-3726-7c8e" hidden="false" publicationId="7ab0-ceb9-pubN146351">
              <description>A weapon or model with the Slayer special rule will wound on any target of the type specified by the special rule on a 2+, regardless of the model&apos;s Toughness value, if it hits them.  The target takes any saves normally.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
