      <entryLinks>
        <entryLink name="Chapter Relic: Standard of the Emporer Ascendant" id="ea7d-fcc5-6562-81c8" collective="false" hidden="false" import="true" targetId="c585-cf41-910e-56cc" type="selectionEntry">
          <modifiers>
