        <profile name="Caestus Assault Ram" id="19f6-6c11-bf3f-bad9" hidden="false" publicationId="7ab0-ceb9-pubN170041" typeId="3a08-ea03-a598-8615" typeName="Flyer">
          <characteristics>
            <characteristic name="BS" typeId="9878-e3f6-b7b4-7225">4</characteristic>
            <characteristic name="Front" typeId="3a4e-bc1d-4a12-7176">13</characteristic>
