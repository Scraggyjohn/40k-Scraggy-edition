      <rules>
        <rule name="Battle-forged Heroes" id="597f-6cf2-c5ad-c72c" hidden="false" publicationId="7ab0-ceb9-pubN65751">
          <description>During deployment, choose one friendly Ultramarines Tactical Squad.  It gains one of the following special rules for the duration of the battle: Counter-attack, Infiltrate, Scout, or Tank Hunters.</description>
        </rule>
        <rule name="Surprise Attack" id="35e6-f845-1260-f27a" hidden="false" publicationId="7ab0-ceb9-pubN65751">
          <description>If Captain Sicarius is alive and on the battlefield, you gain +1 to your Reserve Rolls</description>
        </rule>
      </rules>
      <selectionEntries>
