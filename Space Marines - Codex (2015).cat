        <infoLink name="Shrouded" id="e11d-63e3-4b87-33de" hidden="false" targetId="7182-6dce-dc98-9f7c" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Chapter Relic (RG): The Armour of Shadows" id="4723-5d81-c489-7771" hidden="false" publicationId="7ab0-ceb9-pubN65665" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Armour of Shadows confers a 2+ Armour Save.  A model equipped with the Armour of Shadows has the Stealth special rule, or the Shrouded special rule if it did not Move, Run, or Charge in its previous turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Chapter Relic (RG): Swiftstrike and Murder" id="1fc9-29da-af29-e5a4" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="1cd9-55d2-257d-a573" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
