                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the
                                                            Monster Hunter special rule. In
                                                            addition, friendly Space Marine units
                                                            within 6&quot; of the vehicle gain the
                                                            Fearless special rule.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Battle of Sarosh" id="2315-97c5-f4cc-e5e5" collective="false" hidden="false" import="true" type="upgrade">
