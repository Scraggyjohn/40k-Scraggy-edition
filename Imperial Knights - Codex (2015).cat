                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has the
                                                            Preferred Enemy (Chaos Space Marines)
                                                            special rule. In addition, it
                                                            automatically passes Dangerous Terrain
