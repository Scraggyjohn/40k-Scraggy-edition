                        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic>
                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Large Blast, Armourbane,
                                                    Concussive, Collapsing Singularity</characteristic>
                        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Collapsing Singularity" id="c1a2-022a-f4b6-17f8" hidden="false">
                      <description>Before firing the weapon, roll a D6. On a
                                                result of a 1, the firing Knight-Atrapos suffers a
                                                single Hull Point of damage with no saves of any
                                                kind before the attack is carried out. On a result
                                                of a 6, the attack is carried out with the Vortex
                                                special rule.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
