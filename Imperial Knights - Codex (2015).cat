    <selectionEntry name="Imperial Knight Household Spearhead" id="5ac8b178-7286-30c8-e878-ac95723841bf" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Battle Formation" id="5ac8b178-7286-30c8-e878-ac95723841bf-8dbf948c-125b-4886-b21e-3ccabc1e1188" hidden="false" primary="true" targetId="8dbf948c-125b-4886-b21e-3ccabc1e1188"/>
      </categoryLinks>
