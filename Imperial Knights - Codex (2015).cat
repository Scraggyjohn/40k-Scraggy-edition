                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per game, one of
                                                            the vehicles weapons gains the Skyfire,
                                                            Interceptor, Tank Hunters and Night
                                                            Vision special rules. The use of this
                                                            rule should be declared before any to</characteristic>
                          </characteristics>
