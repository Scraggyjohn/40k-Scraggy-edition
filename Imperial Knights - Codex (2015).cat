                          <characteristics>
                            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Adreadnought with the
                                                            Ullanor Crusade gains the Hatred (Orks)
                                                            Special Rule Enemy models charging a
                                                            vehicle with the Ullanor Crusade Legacy
                                                            of Glory must re-roll successful To Hit
                                                            rolls in the first round of each combat.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="War of Murder" id="da64-96ef-f4d9-04e7" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="maxInRoster" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
