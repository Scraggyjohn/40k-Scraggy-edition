    <selectionEntry name="Ravenwing Attack Squadron" id="f86b-d8f1-11fb-ff76" collective="false" hidden="false" import="true" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Scout" id="4cf2-a582-df98-36c5" hidden="false" targetId="1794-e0e0-bedf-e46b" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Attack Squadron" id="70d3-3cd2-845f-ee84" hidden="false">
          <description>If the Ravenwing Land Speeder or Vengeance from this formation scores one or more hits in the shooting phase against an enemy unit, all models from this formation&apos;s Ravenwing Bike Squad or Ravenwing Attack Bike Squad add 1 to their BS when shooting at the same target for the rest of the phase.</description>
        </rule>
        <rule name="Summon the Deathwing" id="7cda-1aee-ed76-9cc6" hidden="false" page="142" publicationId="578f-d512-pubN101686">
          <description>Friendly units composed entirely of models with the Deathwing special rule do not scatter when they Deep Strike, so long as the first model is placed within 12&quot; of a model from this Ravenwing Attack Squadron Formation. For this to work, the model from this Formation must have been on the battlefield at the start of the turn.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Ravenwing Attack Force" id="a0b4-6615-a09b-51a1" collective="false" hidden="false" import="true">
