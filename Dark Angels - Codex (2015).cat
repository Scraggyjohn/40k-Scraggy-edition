          <profiles>
            <profile name="Blessed Autosimulacra" id="bc37-4656-47c4-b811" hidden="false" page="0" publicationId="578f-d512-pubN86915" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a vehicle has suffered Hull Point damage at the end of the controlling player&apos;s turn, roll a D6. On a 6, one lost Hull Point is restored.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
