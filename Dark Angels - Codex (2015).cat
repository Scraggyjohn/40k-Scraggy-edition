      </entryLinks>
      <infoLinks>
        <infoLink name="Vindicator" id="2fe4-24b0-1200-45f4" hidden="false" targetId="261b-5bb5-42b6-a0ef" type="profile"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditionGroups>
            <conditionGroup type="or">
              <conditions>
                <condition childId="61a02f94-5e73-0bcc-48f0-22910b91bb1c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
                <condition childId="ad010b15-b158-8a7a-bc3d-3479991735db" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </conditionGroup>
          </conditionGroups>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Laser Destroyer Array" id="7a87-05c6-5887-2f68" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">9</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Ordnance 1, Twin-linked</characteristic>
            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Power Capacitator" id="5d75-cc3e-62a9-0f84" hidden="false">
          <description>The vehicle&apos;s internal volume, which is normally taken up with a munitions store for the more common Vindicator&apos;s demolisher cannon, is instead occupied by a bulky reactor-charged power capacitor whose energy stores can be used to greatly increase 
the laser destroyer&apos;s rate of fire. Stability is required for this overcharged firing however, and it is possible for the capacitor to overload the vehicle&apos;s energy grid with disastrous consequences.</description>
        </rule>
        <rule name="Capacitator Fire" id="ea93-11e2-6cb6-7230" hidden="false">
          <description>If the Vindicator Tank Destroyer has not moved this turn, the laser destroyer array becomes an Ordnance 2, Twin-linked weapon</description>
        </rule>
        <rule name="Overcharged Fire" id="07f5-064c-8950-9703" hidden="false">
          <description>The owning player may declare an overcharged volley if the vehicle has not moved this turn, in which case the laser destroyer array becomes Ordnance 3, Twin-linked. However, after the weapon is fired in this mode, roll a D6. On a roll of a 1, the Vindicator suffers a single Hull Point of damage.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="May take" id="8421-382d-0eda-52a5" collective="false" hidden="false" import="true">
          <entryLinks>
            <entryLink name="Vehicle Options" id="1bc7-279e-28dc-f9d3" collective="false" hidden="false" import="true" targetId="d51fa210-5086-0ef7-b11c-cd30499454f7" type="selectionEntryGroup"/>
