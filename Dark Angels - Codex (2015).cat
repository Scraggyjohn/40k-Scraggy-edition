          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Transport Capacity - 10" id="7904-7f9d-86af-4081" hidden="false"/>
        <rule name="Supersonic" id="6621-5ff0-54b9-c2f5" hidden="false"/>
        <rule name="Misericorde" id="9392-d111-167b-cf10" hidden="false"/>
        <rule name="Caestus Ram" id="f570-7ccf-c0ee-dde6" hidden="false"/>
      </rules>
      <selectionEntries>
        <selectionEntry name="Twin-linked Magna-Melta" id="0d8f-6b10-dc83-25bb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
