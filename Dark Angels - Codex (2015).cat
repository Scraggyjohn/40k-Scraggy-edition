    <profile name="Jump Pack" id="ba230067-2ac2-845a-e30e-fe500478b27f" hidden="false" page="152" publicationId="578f-d512-pubN101686" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
