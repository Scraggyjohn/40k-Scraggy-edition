    <forceEntry name="DA Deathwing Strike Force" id="b595-25cb-8651-bc05" hidden="false">
      <categoryLinks>
        <categoryLink name="HQ" id="b595-25cb-8651-bc05-848a6ff2-0def-4c72-8433-ff7da70e6bc7" hidden="false" primary="false" targetId="848a6ff2-0def-4c72-8433-ff7da70e6bc7">
          <constraints>
            <constraint id="e803-f49c-d2d3-0f69" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="f815-e605-fed5-d3c7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Elites" id="b595-25cb-8651-bc05-638d74c6-bd97-4de5-b65a-6aaa24e9f4b2" hidden="false" primary="false" targetId="638d74c6-bd97-4de5-b65a-6aaa24e9f4b2">
          <constraints>
            <constraint id="dd1a-580f-7c25-92c9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="2"/>
            <constraint id="c9bf-c8a6-af5c-c27e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="12"/>
          </constraints>
        </categoryLink>
      </categoryLinks>
      <rules>
        <rule name="Bring the Fight to the Enemy" id="da58-3c29-1fec-1616" hidden="false">
          <description>Units from this Detachment can either run and shoot or shoot and run on the turn they arrive from Deep Strike.</description>
        </rule>
        <rule name="First Knight of Caliban" id="c31d-985a-a4b4-d196" hidden="false">
          <description>If this is your primary detachment, you may reroll your result on the warlord traits table.</description>
        </rule>
        <rule name="Summoned to war" id="f19b-9f7a-464c-8f36" hidden="false">
          <description>All units in this detachment must begin the game in Deep Strike Reserves if able. Everything else must start in reserves.
If your force contains either a Ravenwing Support Squadron or a Ravenwing Strike Force, you can choose to automatically fail or succeed on reserce rolls for units in this detachment.</description>
        </rule>
      </rules>
    </forceEntry>
    <forceEntry name="DA Ravenwing Strike Force" id="704f-0fb9-d225-e9a4" hidden="false">
