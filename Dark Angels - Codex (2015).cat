    <profile name="Auspex" id="befb0d51-72a9-2411-cf15-1ed53106896e" hidden="false" page="151" publicationId="578f-d512-pubN101686" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Forgo shooting to make an enemy unit within 12&quot; reduce it&apos;s cover save by 1 until the end of the phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Blade of Caliban" id="8f47c3bc-19f7-318c-42e7-86a9b513cb7e" hidden="false" page="150" publicationId="578f-d512-pubN101686" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
