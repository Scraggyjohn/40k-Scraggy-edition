    <selectionEntry name="&quot;Ice Storm Assault Pack&quot;" id="d408-e002-ff9b-7c2c" collective="false" hidden="false" import="true" page="126" publicationId="21e36b7e--pubN74238" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Wing Leader (Space Wolves)" id="cff4-b7ca-72be-fb05" hidden="false" targetId="eb48-0c21-ebfb-bd70" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Hailstorm Assault" id="9a26-c5cc-dc5f-cd02" hidden="false" page="126" publicationId="21e36b7e--pubN74238">
          <description>Units that disembark from Flyers in this Wing have the Fleet rule on the turn they disembark, as long as the Wing was in an Attack Pattern when the unit disembarked.</description>
        </rule>
        <rule name="Ice Storm" id="7c49-2486-66fd-47c4" hidden="false" page="126" publicationId="21e36b7e--pubN74238">
          <description>If an enemy unit suffers unsaved Wounds from any dispersed helfrost attacks made by two or more models from this Wing, it is frozen until the start of your next turn. A frozen unit cannot voluntarily move in any way and has its Weapon Skill charactersitic reduced to 1.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Stormwolves" id="6aef-49ea-1ccf-999b" collective="false" defaultSelectionEntryId="199a-450b-2cb3-f2d9" hidden="false" import="true">
