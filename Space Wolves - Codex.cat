            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228"/>
          </characteristics>
        </profile>
        <profile name="Frag Grenades" id="e249-963e-d278-e0a3" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Reinforced Atomantic Shielding" id="de92-047b-9759-74fa" hidden="false">
          <description>4+ invulnerable save. In addition, if the model suffers a Vehicle Explodes damage result, add +D3 Str and +D3&quot; to the radius of the blast.</description>
        </rule>
        <rule name="Crushing Charge" id="8904-d1c5-0470-bc15" hidden="false">
          <description>When charging, the model inflicts 2 Hammer of Wrath attacks and gains +1 Initiative in the Assault phase of any turn in which it has charged.</description>
        </rule>
        <rule name="Relic of Darkness" id="3589-af8d-cf69-a31d" hidden="false">
          <description>Counts as a Relic of the Armoury, but may not take a Legacy of Glory upgrade. In addition, a model with this special rule is immune to Malediction psychic powers, can never be a scoring unit and must always make charges and Sweeping Advances if they are able. A model with this special rule may not benefit from any rules or bonuses usually conferred by  being part of a detachment or formation.</description>
        </rule>
        <rule name="Move Through Cover" id="c994-3aa2-1811-8281" hidden="false"/>
      </rules>
