      <rules>
        <rule name="Duty or Death" id="fbb0-cc5b-774b-bec5" hidden="false" page="32" publicationId="21e36b7e--pubN75180">
          <description>Krom can re-roll all failed saving throws when he is within 3&quot; of an Objective Marker.</description>
        </rule>
        <rule name="The Fierce-eye" id="39b5-3c6b-8034-6934" hidden="false" page="32" publicationId="21e36b7e--pubN75180">
          <description>Krom can re-roll failed To Wound rolls in close combat.</description>
        </rule>
      </rules>
