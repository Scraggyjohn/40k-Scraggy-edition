    <profile name="Runic Terminator Armour" id="d234c789-ac69-28c8-5117-e8af0eee2ec3" hidden="false" page="53" publicationId="21e36b7e--pubN70777" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, 4+ Invul Sv. Relentless, cannot perform a Sweeping Advance or pursue a more lightly armoured foe when they flee (this affects both Terminators &amp; any unit they join). Count as 2 models for transport purposes, cannot embark a Rhino or Razorback.</characteristic>
      </characteristics>
    </profile>
    <profile name="Runic Weapon" id="880d4f4a-38e9-2ea4-df96-e2f59dc740e2" hidden="false" page="0" publicationId="21e36b7e--pubN200102" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Force Weapon. Furthermore, a model with a runic weapon adds 1 to Deny the Witch rolls. Always wounds Daemon models on a 2+. This ability has no effect on vehicles.</characteristic>
      </characteristics>
    </profile>
    <profile name="Scorpius Multi-launcher" id="bddeb75c-afe3-6e50-d4aa-7ad3233465fb" hidden="false" page="93" publicationId="21e36b7e--pubN79165" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
