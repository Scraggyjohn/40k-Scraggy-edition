    <profile name="Psychic - Storm Caller" id="f5d0b8f7-5488-ae37-8069-9827f1bcb757" hidden="false" page="0" publicationId="21e36b7e--pubN70777" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Blessing, Warp Charge 1, targets the Psyker and his unit. Whilst the power is in effect, the target unit has the Shrouded special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Psychic - Tempest&apos;s Wrath" id="6b0a37df-7289-98c9-9f7c-fee95cca781e" hidden="false" page="0" publicationId="21e36b7e--pubN70777" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Malediction, Warp Charge 1, targets a single unit within 18&quot;. Whilst the power is in effect, models in the target unit suffer -1BS (to a minimum of 1) and treat all terrain, even open ground, as difficult terrain. In addition, unless they are Immobilised, all models in the target unit that have the Jump, Jet Pack, Jetbike, Flying Monstrous Creature, Flyer or Skimmer unit type must immediately take a Dangerous Test.</characteristic>
      </characteristics>
    </profile>
    <profile name="Psychic - Thunderclap" id="ff9430d2-fd00-7c7a-5ef4-edcd2e7b4ee1" hidden="false" page="0" publicationId="21e36b7e--pubN70777" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">3</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Nova , Warp Charge 1, Assault 2D6</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Psychic Hood" id="f7db025a-18cf-7403-3c97-a7c384c6fe2c" hidden="false" page="68" publicationId="21e36b7e--pubN126853" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Each time a unit/model is targeted by an enemy psychic power and is within 6&quot; of a friendly model with a psychic hood, the wearer may attempt to Deny the Witch as if he were in the unit.</characteristic>
      </characteristics>
    </profile>
