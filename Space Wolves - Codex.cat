    <profile name="Locator Beacon" id="0c142e14-ec36-27fb-0ce2-45fb4afefcd3" hidden="false" page="99" publicationId="21e36b7e--pubN70777" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units do not scatter when they Deep Strike, so long as the first model is placed within 6&quot; of a model with a locator beacon. The locator beacon must have been on the battlefield at the start of the turn in order for it to be used.</characteristic>
      </characteristics>
    </profile>
