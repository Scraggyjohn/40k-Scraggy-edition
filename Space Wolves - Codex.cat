    <profile name="Chooser of the Slain" id="65628817-28ff-f337-5c81-118a5b0a0865" hidden="false" page="0" publicationId="21e36b7e--pubN70777" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">An army that includes a Chooser (must be smaller than the Rune Priest. Cannot be destroyed) may place it anywhere on the battlefield before the enemy has deployed. Enemy units may not use Infiltrate to deploy within 18&quot; of the Chooser. Rune Priest gains +1BS for any Shooting attack at an enemy that has Line of Sight to the Chooser. Doesn&apos;t modify the BS1 of a Snap Shot</characteristic>
      </characteristics>
    </profile>
    <profile name="Combi-Weapons" id="b9acf151-1b3a-6d61-fc07-074c4ed705f2" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Bolter may be fired every turn, secondary weapon may be fired once. (Combi-plasma does have Rapid Fire). Cannot fire both in same turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Command Vox Relay" id="a95ace0e-b272-e2f5-5bbf-6a0ceeef9705" hidden="false" page="186" publicationId="21e36b7e--pubN79165" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
