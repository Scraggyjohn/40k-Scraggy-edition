    <profile name="Armour of Asvald Stormwrack" id="97e36767-02b8-1a05-9140-e8ba096e3c29" hidden="false" publicationId="21e36b7e--pubN70615" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, 4+ Invul Sv, Bulky, Deep Strike, It Will Not Die, Relentless, may not make Sweeping Advances.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armoured Cockpit" id="f672f65a-522d-9ad2-0ec9-b3304385dbe9" hidden="false" page="6" publicationId="21e36b7e--pubN108746" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Ignore Crew Shaken or Crew Stunned on a 4+</characteristic>
      </characteristics>
    </profile>
    <profile name="Assault Drill" id="6370155d-69ef-fd4a-a94b-4957e3c9dde1" hidden="false" page="171" publicationId="21e36b7e--pubN79165" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">DCCW; +D6 to pen. bunkers, fortifications, bastions, other buildings &amp; any vehicle classed as stationary that turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Assault Drill In-built Heavy Flamer" id="7ea5e1f0-19de-ebb7-69f7-7a7faed89eb4" hidden="false" page="171" publicationId="21e36b7e--pubN79165" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In addition to normal use, if the DCCW inflicts a pen. hit against a building/vehicle that is occupied, but the target is not destroyed outright, then all models inside suffer a single Heavy Flamer hit automatically after the Dreadnought&apos;s other attacks have been resolved (Str 5, Ap 4, distributed as per wounds from a shooting attack). This flamer hit only occurs once per Combat phase, not once per hit.</characteristic>
      </characteristics>
    </profile>
    <profile name="Atomantic Shielding" id="ea1b2ee9-dd66-d035-b8fa-aef8719f33c1" hidden="false" page="6" publicationId="21e36b7e--pubN108746" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Invul Sv against shooting/explosions; 6+ Invul Sv against close combat. If the Contemptor suffers a &apos;Vehicle Explodes&apos; damage result, add +1&quot; to blast radius.</characteristic>
      </characteristics>
    </profile>
    <profile name="Avenger Bolt Cannon" id="69781626-a109-0c47-0c2a-eb30a475e2d5" hidden="false" page="139" publicationId="21e36b7e--pubN79165" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">36&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 7</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Banner of the Great Wolf" id="f9ce82b5-d8ff-da15-3048-ae5b0737f69e" hidden="false" publicationId="21e36b7e--pubN147945" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All friendly units chosen from Codex: Space Wolves within 24&quot; of the Banner of the Great Wolf have the Furious Charge special rule.</characteristic>
      </characteristics>
    </profile>
    <profile name="Battle Auspex" id="6043708a-7eff-0e9f-6a37-1dcc762050c5" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">-1 to Cover Saves of enemy targets fired on by the Promotheus.</characteristic>
      </characteristics>
    </profile>
