      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, 5+ Invul Sv, Relentless, Bulky, Deep Strike, may not make Sweeping Advances.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Armour of Russ" id="54499d02-5c6c-4ba2-831c-7b6be78574fa" hidden="false" publicationId="21e36b7e--pubN70777" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ Armour Sv, 4+ Invul Sv. Furthermore, when fighting in a challenge, the wearer&apos;s opponent suffers a -5I (to a minimum of 1).</characteristic>
      </characteristics>
    </profile>
    <profile name="The Axe Langnvast" id="794e1a0c-a688-9e15-7548-5a3935b3c36b" hidden="false" page="126" publicationId="21e36b7e--pubN78095" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2-handed Power Weapon, Adds +1 to its user&apos;s Strength and allows them to re-roll any assault Hits which fail to Wound.</characteristic>
      </characteristics>
    </profile>
    <profile name="The Axe Morkai" id="6ec50cc6-f4ff-6618-f66f-fafb9928dcab" hidden="false" page="0" publicationId="21e36b7e--pubN201554" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
