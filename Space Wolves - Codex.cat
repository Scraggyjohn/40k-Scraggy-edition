      <entryLinks>
        <entryLink name="Armoured Ceramite" id="cecc-f314-7dbf-8730" collective="false" hidden="false" import="true" targetId="8bb528ac-f996-7c60-68ce-394f932a961a" type="selectionEntry"/>
