    <profile name="Wolf Standard" id="28f2e6a3-fa58-f06d-3128-d5047027c925" hidden="false" page="0" publicationId="21e36b7e--pubN70777" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Any friendly units with the Space Wolves Faction within 12&quot; of the model bearing this banner re-roll failed Morale checks and Pinning tests. In addition, all models in friendly units with the Space Wolves Faction within 6&quot; of the bearer gain +1 Attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Wolf Tail Talisman" id="54f11d4d-0b4f-2b56-fbaa-84078f164193" hidden="false" page="0" publicationId="21e36b7e--pubN204059" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the bearer or his unit is affected by an enemy Psychic power, that power is nullified by rolling 5+ on a D6</characteristic>
      </characteristics>
    </profile>
    <profile name="Wolftooth Necklace" id="6ef616e4-a297-8f77-7b23-b584599c2654" hidden="false" page="0" publicationId="21e36b7e--pubN204084" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Against models with a WS, bearer always Hits in close combat on a 3+</characteristic>
