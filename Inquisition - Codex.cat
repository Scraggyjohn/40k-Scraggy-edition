                <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">2</characteristic>
                <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">3</characteristic>
