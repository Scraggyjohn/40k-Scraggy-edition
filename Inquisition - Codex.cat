      <rules>
        <rule name="I&apos;ve Been Expecting You" id="5ff6-4484-bcc0-9b7d" hidden="false" page="0">
          <description>If an enemy unit arrives from reserves within 12&quot; of Coteaz and within his line of sight, Coteaz and his unit can immediately make an out-of-sequence shooting attack against it. There is no limit on how many times the ability can be used in a turn.</description>
        </rule>
        <rule name="Spy Network" id="0dbb-18b8-c5b9-a13f" hidden="false" page="0">
          <description>Coteaz allows you to re-roll the dice to Seize the Initiative, or force your opponent to re-roll his.</description>
        </rule>
      </rules>
