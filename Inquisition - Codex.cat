      <selectionEntries>
        <selectionEntry name="Bio-Sample Extractor" id="5543-1d05-617f-064d" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="adb3-fc34-7592-213c" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="f218-4603-e7bd-5eaa" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Bio-Sample Extractor" id="d056-94f5-2fe7-817a" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the end of any phase in which the Malocator&apos;s unit caused one or more unsaved Wounds to an enemy unit, the Malocator may attempt to collect a biological sample.


Roll a D6:


1–2: The sample is unusable.
3–5: The sample is successfully collected. Until the end of the game, the Malocator&apos;s unit has Preferred Enemy against that enemy unit.
6: The sample reveals a critical weakness. Until the end of the game, all Adeptus Arbites units have Preferred Enemy against that enemy unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
