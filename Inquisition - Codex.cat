              <rules>
                <rule name="Awaken the Machine" id="359c-43d6-e8d1-6caf" hidden="false" page="0" publicationId="6e6c7c90--pubN90002">
                  <description>May give a single friendly Astra Militarium vehicle within 12&quot; Power of the Machine Spirit until end of turn.</description>
                </rule>
                <rule name="Blessings of the Omnissiah" id="6296-357e-7a6d-fd60" hidden="false" page="0" publicationId="6e6c7c90--pubN90002">
                  <description>Instead of shooting, may repair a friendly vehicle embarked or in base contact.  Need 5+, adding +1 for each Servitor with servo-arm in unit. Success restores hull point, or repairs destroyed weapon, or repairs Immobilised.</description>
                </rule>
              </rules>
