      <rules>
        <rule name="Orbital Strike Relay" id="e42b5b40-dcd8-909b-bf5b-a91c4bc4aa6a" hidden="false" page="0">
          <description>The bearer can call down an orbital strike in his Shooting phase. This counts as firing a
ranged weapon with one of the profiles below. This does not prevent the Warlord and his
unit from declaring a charge against the target unit that turn.</description>
        </rule>
        <rule name="Psi-shock" id="3e05b8b1-3224-6b34-943a-f02f3f15c481" hidden="false" page="0">
          <description>Psi-shock: Any Psyker that suffers an unsaved Wound from a psyk-out bomb suffers the
Perils of the Warp in addition to any other effects.</description>
        </rule>
      </rules>
    </selectionEntry>
