    <profile name="Webway portal" id="9d9016c4-edc2-cffc-9683-aa288f67b682" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a  model with a webway portal is in Reserves or Ongoing Reserves, then the model and any unit it has joined or is embarked upon has the Deep Strike special rule. This model, and his unit, will not scatter if arriving from Deep Strike Reserve.</characteristic>
      </characteristics>
    </profile>
