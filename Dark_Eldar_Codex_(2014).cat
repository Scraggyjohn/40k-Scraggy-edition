      <rules>
        <rule name="Evasive" id="9d72-4a80-1699-9dc0" hidden="false" page="???" publicationId="635e04e0--pubN82286">
          <description>(Editor&apos;s note: Possibly &quot;Agile&quot; but no clue if that&apos;s an actual error or what.)</description>
        </rule>
        <rule name="Sky Assassin" id="588a-a1df-5679-3327" hidden="false" page="69" publicationId="635e04e0--pubN82207">
          <description>When entering play via Deep Strike, if it does so within 12&quot; of an enemy Flyer or Skimmer, its controlling player may re-roll the Scatter dice to determine where it arrives.</description>
        </rule>
        <rule name="Strike-fighter Skyfire mode" id="2b02-b842-8565-80c7" hidden="false" publicationId="635e04e0--pubN82324">
          <description>Zooming Flyers with the Strike-fighter Combat Role may choose to enter Skyfire mode at the beginning of each Shooting phase. If they enter Skyfire mode then all weapons fired from that Flyer in that Shooting phase gain the Skyfire special rule.</description>
        </rule>
      </rules>
