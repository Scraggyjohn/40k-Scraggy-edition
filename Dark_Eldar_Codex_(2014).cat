    <selectionEntry name="Battle Formation: Dark Olympaid" id="42fe-1008-fd38-e8f9" collective="false" hidden="false" import="true" publicationId="635e04e0--pubN95745" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Wyches" id="3aa8-a3dd-8679-729f" collective="false" hidden="false" import="true" targetId="0a07206d-7a1e-42bc-231b-1293710a8f8e" type="selectionEntry">
          <constraints>
