      <selectionEntries>
        <selectionEntry name="Storm vortex projector" id="560f8c5e-f9c7-45f2-f191-1e4755e9c471" collective="false" hidden="false" import="true" page="104" publicationId="635e04e0--pubN66402" type="upgrade">
