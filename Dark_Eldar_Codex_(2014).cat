    <profile name="Vexator Mask" id="3d4855c9-f43b-5abe-e702-07c12b680556" hidden="false" page="62" publicationId="635e04e0--pubN71438" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">&quot;Enemy units locked in close combat with the bearer must pass a Leadership test at the beginning of the Fight sub-phase after challenges have been issued and accepted or declined.  If they fail they may not Attack the bearer in this Fight sub-phase, though they may attack other models as normal providing they are not involved in a challenge with the bearer.&quot; (FAQ 1.0)</characteristic>
      </characteristics>
    </profile>
