          </costs>
          <profiles>
            <profile name="Storm vortex projector (Beam)" id="a3680d83-55da-365a-3016-3f4b54a54e31" hidden="false" page="104" publicationId="635e04e0--pubN66402" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">36&quot;</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Haywire, Kill Shock, Concussive</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
            <profile name="Storm vortex projector (Blast)" id="e2adfe4d-6805-c236-0888-6c9e35d5eb2c" hidden="false" page="104" publicationId="635e04e0--pubN66402" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">5</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy1, Haywire, Pinning, Large Blast, Concussive</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
