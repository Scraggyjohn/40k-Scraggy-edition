    <profile name="Reaver Jetbike" id="a8ccf766-8913-2381-205a-526530621a69" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Models on Reaver jetbikes have the Eldar Jetbike unit type, and have their Armour Save increased to 5+ if it is normally lower. Reaver jetbikes are armed with a splinter rifle.</characteristic>
      </characteristics>
    </profile>
