    <selectionEntry name="Battle Formation: Carnival of Pain" id="23d0-041d-6c56-5e1e" collective="false" hidden="false" import="true" publicationId="635e04e0--pubN95745" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Haemonculus" id="2bdb-33ba-a61a-b20e" collective="false" hidden="false" import="true" targetId="18bec4ba-3aa3-640e-b32b-30cb095be41f" type="selectionEntry"/>
        <entryLink name="Wracks" id="3706-428f-01a7-b473" collective="false" hidden="false" import="true" targetId="dd7557e4-07da-0796-4d73-44cc898531dc" type="selectionEntry"/>
        <entryLink name="Grotesques" id="6a4a-e239-5389-7287" collective="false" hidden="false" import="true" targetId="e4869455-eda2-cb43-57eb-4bd8df1c914b" type="selectionEntry"/>
      </entryLinks>
      <rules>
        <rule name="Pain Amplifiers" id="9dc1-8625-a4eb-fe9a" hidden="false" publicationId="635e04e0--pubN95745">
          <description>All non-vehicle enemy units within 12&quot; of a Talos Pain Engine or a Cronos Parasite Engine from the Carnival of Pain have their Toughness characteristic reduced by one.
In addition, friendly units chosen from Codex: Dark Eldar that are within 12&quot; of at least one model in this formation and have one or more pain tokens have their Feel No Pain special rule improved by one - usually to Feel No Pain (4+). A Dark Eldar unit with four or more pain tokens instead has its Feel No Pain special rule improved by two - usually to Feel No Pain (3+).</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Leader" id="f27e-1068-7b4c-744e" collective="false" defaultSelectionEntryId="5d7b-a24d-73ac-a043" hidden="false" import="true">
          <constraints>
