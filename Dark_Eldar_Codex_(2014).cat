      <rules>
        <rule name="Quicksilver Dodge" id="3893e84b-3ad3-9d83-4dc7-967ab49a4864" hidden="false" page="0">
          <description>Lelith Hesperax has a 4+ invulnerable save. This is increaded to a 3+ invulnerable save against all wounds inflicted in the Fight sub-phase.</description>
        </rule>
        <rule name="The Penetrating Blade" id="cf478bd9-a182-df7e-6a5a-f9eed10f1bcb" hidden="false" page="0">
          <description>Armour saves cannot be taken against Wounds inflicted by Lelith Hesperax&apos;s Melee weapons.</description>
        </rule>
        <rule name="A League Apart" id="99a38eb5-c532-be1e-366f-b0d308854209" hidden="false" page="0">
          <description>Lelith Hesperax re-rolls all failed To Hit and To Wound rolls whilst fighting a challenge.</description>
        </rule>
      </rules>
