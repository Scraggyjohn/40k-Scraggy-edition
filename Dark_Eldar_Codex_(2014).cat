        </entryLink>
        <entryLink name="Bloodbrides" id="791e-6071-f6e0-1bb1" collective="false" hidden="false" import="true" targetId="cf2b35c4-d0d7-a558-a6c8-51bf3f43a5db" type="selectionEntry"/>
        <entryLink name="Beastmasters" id="c0a2-7be3-3112-525b" collective="false" hidden="false" import="true" targetId="06bf7507-1e32-7ef4-c192-c62b16759fe1" type="selectionEntry"/>
        <entryLink name="Reavers" id="6642-d724-4ba8-3de2" collective="false" hidden="false" import="true" targetId="5f906016-1d30-7424-444b-c347f752e913" type="selectionEntry">
          <constraints>
            <constraint id="547a-69d2-d549-978f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <rules>
        <rule name="Frenzied Beasts" id="cea0-9aa8-810b-70a0" hidden="false" publicationId="635e04e0--pubN95745">
          <description>Beastmasters, Donorian Clawed Fiends, Khymerae and Razorwing Flocks in a Dark Olympiad all have combat drugs in addition to their other wargear.</description>
        </rule>
        <rule name="The Grand Finale" id="5851-daeb-92f7-afe7" hidden="false" publicationId="635e04e0--pubN95745">
          <description>An army that includes a Dark Olympiad rolls an extra dice on the chart when determining which combat drugs are available, and applies two of the results generated instead of the usual one. Note that an army that includes a both a Dark Olympiad and Duke Sliscus could roll three dice and choose two results.</description>
        </rule>
        <rule name="Orgy of Scarlet" id="579e-6c99-8ed8-8a7a" hidden="false" publicationId="635e04e0--pubN95745">
          <description>Once the game has begun, whenever a unit from the Dark Olympiad gains a pain token for destroying an enemy unit, choose a Dark Eldar unit within 24&quot; and within line of sight; that unit also gains a pain token.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Leader" id="573a-a78c-32a5-9b9f" collective="false" defaultSelectionEntryId="0fa0-fa50-2962-c1c6" hidden="false" import="true">
          <constraints>
            <constraint id="3752-d954-39af-3516" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="ba8b-d091-d99b-e2cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink name="Succubus" id="0fa0-fa50-2962-c1c6" collective="false" hidden="false" import="true" targetId="ae6fb802-062f-fb53-dce7-d7be879c9c7e" type="selectionEntry"/>
            <entryLink name="Lelith Hesperax" id="410d-d089-b9c0-f785" collective="false" hidden="false" import="true" targetId="be6eeaa7-1b22-3afe-b5e6-8fe2914008ed" type="selectionEntry"/>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Battle Formation: Kabalite Web Strike" id="4303-d016-2308-c84b" collective="false" hidden="false" import="true" publicationId="635e04e0--pubN95745" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Kabalite Warriors" id="dc5e-f628-41af-ddbd" collective="false" hidden="false" import="true" targetId="775786c3-a7e0-95c5-996b-96a0cc7c8408" type="selectionEntry">
          <constraints>
            <constraint id="1628-ea6c-d2c6-a85f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="2"/>
