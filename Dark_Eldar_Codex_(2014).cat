        <selectionEntry name="The Archangel of Pain" id="3670598e-c00c-5f85-608c-bc8533d62714" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="maxInForce" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
            <constraint id="maxInRoster" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
          </costs>
          <profiles>
            <profile name="The Archangel of Pain" id="0964c21d-9d70-2a87-247c-bc1136fb1a7d" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per game, the bearer can open the Archangel of Pain instead of firing a weapon in the Shooting phase. When he does so, each enemy unit within 9&quot; of him must take a Leadership test with a -2 penalty; a unit suffers a single Wound, with no armour or cover saves allowed, for each poin this test is failed by. Hits cannot be allocated to models with the Fearless or And They Shall Know No Fear special rules (any excess Wounds are lost).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Helm of Spite" id="8234e19b-943d-cea4-5d5f-855bf746ca5f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="maxInForce" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="force" shared="true" type="max" value="1"/>
            <constraint id="maxInRoster" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
          </costs>
          <profiles>
            <profile name="The Helm of Spite" id="e537a2c4-4294-e3d8-502e-04ddcc7b4744" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer of the Helm of Spite, and all friendly units with the Dark Eldar Faction within 12&quot; of the bearer, have the Adamantium Will special rule. In addition, enemy Psykers that are within 12&quot; of the bearer suffer Perils of the Warp when they roll any double when making any Psychic test.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
