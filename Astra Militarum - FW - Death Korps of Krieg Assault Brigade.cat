    <profile name="Icon of Righteous Spite" id="0edf1da7-620d-16dc-37ab-a1009b402ee7" hidden="false" page="177" publicationId="a03f3b3e--pubN67511" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All Death Korps units within 12&quot; gain Hatred (Chaos Space Marines, Chaos Daemons, Psykers, Renegades &amp; Heretics)</characteristic>
      </characteristics>
    </profile>
    <profile name="Illum Flare" id="5432a591-fd7c-6c71-0e92-cc376dea1774" hidden="false" page="6" publicationId="a03f3b3e--pubN90191" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During each friendly Movement phase, a model equipped with illum flares may drop one as though it were a weapon with the Bomb 1 type, placing a marker where the flare lands. All units within 12&quot; of the Flare marker may be targeted as though Night Fight was not in effect. Illum flares have no effect if the Night Fight rules are not in play. At the end of each Game Turn, remove all Flare markers currently on the battlefield.</characteristic>
      </characteristics>
    </profile>
    <profile name="Illum Shells" id="e0f5422b-f5c8-6a49-1595-a892a850bc3e" hidden="false" page="0" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
