    <profile name="Inferno Gun (Titan)" id="92604412-9084-2792-95ec-c04f3ba5f567" hidden="false" page="136" publicationId="a03f3b3e--pubN92710" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
