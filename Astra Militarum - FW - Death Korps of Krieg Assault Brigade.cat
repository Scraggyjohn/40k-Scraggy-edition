    <profile name="Skystrike Missile (Type D)" id="469b-8d41-56e5-93f9" hidden="false" page="4" publicationId="a03f3b3e--pubN90191" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
