        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Nova, Warp Charge 1, Assault D6+1, Poisoned (4+)</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Psychic - Unnatural Vigour" id="58a663f0-4a0f-9787-abb4-0685e80f0e1d" hidden="false" page="241" publicationId="ca4c-9142-pubN73886" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Blessing, Warp Charge 1, may target any friendly unit within 12&quot;. Unit affected gains Fleet and Crusader for the duration.</characteristic>
      </characteristics>
    </profile>
