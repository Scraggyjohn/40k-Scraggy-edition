    <profile name="Flak Armour" id="f76238a6-eacb-a9cf-ddbb-8e37d171e1bd" hidden="false" page="71" publicationId="ca4c-9142-pubN167518" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Sv</characteristic>
      </characteristics>
    </profile>
    <profile name="Flare or Chaff Launcher" id="8b60fc27-ff30-70ab-a1ad-2a50855c9938" hidden="false" page="6" publicationId="ca4c-9142-pubN166734" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Single use. If used during the opposing player&apos;s Shooting phase, they grant the equipped vehicle a 4+ Invul Sv against all weapons with the Missile type or with the word &apos;Missile&apos; in their name. The use of flare or chaff launchers in an opponent&apos;s Shooting phase must be declared after the opposing player has made a To Hit roll, but before any Armour Penetration rolls are made. Flare or chaff launchers may also be used during the Dogfight phase. They are only used during the Attack sub-phase and only if the equipped vehicle has already declared it will Jink. When used in the Dogfight phase, they increase the equipped vehicle&apos;s Jink save by one step and make that save an Invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Frag Assault Launchers" id="b4c45124-1886-d664-4b14-a6ac7a7710a1" hidden="false" page="126" publicationId="ca4c-9142-pubN169973" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit charging into close combat, on the same turn it disembarks from a vehicle equipped with this upgrade, counts as being equipped with frag grenades.</characteristic>
      </characteristics>
    </profile>
    <profile name="Gatling Blaster" id="a06443a6-d100-8e76-544e-90f810abfd14" hidden="false" page="0" publicationId="ca4c-9142-pubN166554" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
