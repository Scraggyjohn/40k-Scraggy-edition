    <profile name="Leman Russ Punisher" id="c0294544-b160-cd4a-070c-61c9625a194e" hidden="false" page="257" publicationId="ca4c-9142-pubN73886" typeId="725a358c-765b-498c-8de5-399fc0c0725f" typeName="Vehicle">
      <characteristics>
