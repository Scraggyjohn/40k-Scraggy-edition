        <profile name="Creeping Terror" id="7c60-54ba-9cda-362a" hidden="false" page="241" publicationId="ca4c-9142-pubN73886" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
          <characteristics>
            <characteristic name="Warp Charge" typeId="5ffd-b800-c317-532a">1</characteristic>
            <characteristic name="Power Category" typeId="f04c-a782-d794-ddad">Malediction</characteristic>
            <characteristic name="Range" typeId="fd64-cbc4-94de-24cc">12&quot;</characteristic>
            <characteristic name="Details" typeId="ad96-dfa4-b4ed-656d">The target unit reduceds its Initiative value to 1 and may only fire snap shots until the end that units next turn. Units with the Fearless special rule are unaffected by this power, and units with the And They Shall Know No Fear special rule or Stubborn special rule may attempt a leadership test, which if passed allows them to ignore the effects of this power.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unnatural Vigour" id="028f-8b9a-7c0b-ff03" hidden="false" page="241" publicationId="ca4c-9142-pubN73886" typeId="ae70-4738-0161-bec0" typeName="Psychic Power">
