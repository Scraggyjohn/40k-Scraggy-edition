    </profile>
    <profile name="Infrared Targeting" id="fb1f6c9a-5446-7579-7255-317e7b4f5037" hidden="false" page="6" publicationId="ca4c-9142-pubN166734" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gains Night Vision. During the Dogfight phase, a vehicle equipped with this upgrade may re-roll all To Hit rolls of a &apos;1&apos; made during the Attack sub-phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Khorne Lord of Skulls" id="609ae1f4-c5a9-bf7e-2f20-56cc614c8b09" hidden="false" page="83" publicationId="ca4c-9142-pubN94403" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413" typeName="Walker">
