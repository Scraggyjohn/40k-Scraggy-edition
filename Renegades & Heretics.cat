        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Ordnance 1, Barrage, Large Blast, Pinning, No Cover Sv, Indirect Fire only</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Combat Drug Injectors" id="1046f01a-893a-107b-a38e-5df4124d3836" hidden="false" page="236" publicationId="ca4c-9142-pubN73886" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">May be activated on any turn in which the unit it is included in declares a charge. Unit gains Rage for the remainder of the turn. At the end of the Assault phase, the unit must pass a Toughness test (using the unit&apos;s majority T) or remove D3 models chosen at random by the controlling player, with no saves of any kind allowed.</characteristic>
      </characteristics>
    </profile>
    <profile name="Combi-Weapons" id="04f48936-58c1-8b7b-a273-e5ad9110bc6b" hidden="false" page="0" publicationId="ca4c-9142-pubN81820" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Bolter may be fired every turn, secondary weapon may be fired once. (Combi-plasma does have Rapid Fire). Cannot fire both in same turn.</characteristic>
      </characteristics>
    </profile>
    <profile name="Command Net Vox" id="a5b4a6f8-284b-02c2-2337-c93751d7b3a5" hidden="false" page="236" publicationId="ca4c-9142-pubN73886" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If the unit is equipped with a vox-caster, may re-roll to determine their Ld value. The second result must be used. Any other friendly unit within 12&quot; may use the Ld of this unit when taking a Morale check.</characteristic>
      </characteristics>
    </profile>
    <profile name="Conqueror Battle Cannon" id="8c3dc96e-50d3-a284-24f9-88419d4c7bd0" hidden="false" page="272" publicationId="ca4c-9142-pubN73886" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
