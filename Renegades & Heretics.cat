    <profile name="Laser Destroyer Array" id="2907b3ee-065f-0498-ef8d-68290f517602" hidden="false" page="272" publicationId="ca4c-9142-pubN73886" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
