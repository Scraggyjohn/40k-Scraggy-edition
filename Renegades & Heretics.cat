    <profile name="Banner of Hate" id="ec53580e-820d-05be-b588-688c256f99b4" hidden="false" page="236" publicationId="ca4c-9142-pubN73886" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All infantry units from same Primary detachment with one or more models within 12&quot; of the unit with the Banner of Hate roll 3D6 for Pinning and Morale, choosing the two lowest results.</characteristic>
      </characteristics>
    </profile>
    <profile name="Banner of the Apostate" id="ef03a2a3-287f-96e9-f9b6-570fb184cd1f" hidden="false" page="236" publicationId="ca4c-9142-pubN73886" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Infantry unit carrying the Banner of the Apostate adds +1 to their score to determine which side wins an assault. The effects of multiple banners are not cumulative.</characteristic>
      </characteristics>
    </profile>
