    <profile name="Colossus Siege Bombard" id="07939d5d-d9c2-3598-8689-9837084ef95b" hidden="false" page="272" publicationId="ca4c-9142-pubN73886" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
