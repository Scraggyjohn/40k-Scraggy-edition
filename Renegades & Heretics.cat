    <profile name="Giant Chaos Spawn" id="95d3683d-b805-5610-ec80-7ef91987b845" hidden="false" page="201" publicationId="ca4c-9142-pubN71990" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Monstrous Creature</characteristic>
