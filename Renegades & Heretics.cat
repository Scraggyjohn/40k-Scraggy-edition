    <profile name="Neural Goad" id="e238-cd62-e4b3-17df" hidden="false" page="238" publicationId="ca4c-9142-pubN73886" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">+1WS. Controlling player may, at start of their Movement phase, choose to inflict D3 Wounds that cannot be saved by any means onto any one unit of friendly Renegade Ogryn Brutes within 12&quot; of model with Neural Goad. These units gain Fleet and Furious Charge until the beginning of the controlling player&apos;s next turn.</characteristic>
      </characteristics>
    </profile>
