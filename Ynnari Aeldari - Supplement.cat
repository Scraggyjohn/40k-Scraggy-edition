      <rules>
        <rule name="Cloudstrike" id="cd6f-6689-62c2-0ea5" hidden="false" publicationId="d744-5cc5-pubN69600">
          <description>If a Falcon squadron contains three models, all models in the squadron gain the Deep Strike special rule.  When the squadron arrives by Deep Strike, the first Falcon placed does not scatter and the second and third Falcons can be placed anywhere within 4&quot; of the first Falcon</description>
        </rule>
