      <infoLinks>
        <infoLink name="Emmisary of Cegorach" id="7d58-b484-8152-58ef" hidden="false" targetId="5815-e23e-4ed8-db36" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="The Skystride" id="2886-b2e1-fbd9-4f67" hidden="false" publicationId="d744-5cc5-pubN69860">
          <description>A Troup from this Formation can use its Hit and Run special rule to embark upon an unoccupied Starweaver from this Formation.  As long as the distance rolled for the Hit and Run move, in inches, is sufficient to allow all models in the unit, including any characters that have joined it, to move to within 2&quot; of an unoccupied Starweaver from this Formation, then the unit can immediately embark.  Furthermore, if all models in the unit can Consolidate to within 2&quot; of an unoccupied Starweaver from this Formation, then the unit can immediately embark.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Skyweavers" id="f2bf-5700-e37c-916b" collective="false" defaultSelectionEntryId="1ce2-6544-09af-9538" hidden="false" import="true" publicationId="d744-5cc5-pubN69860">
