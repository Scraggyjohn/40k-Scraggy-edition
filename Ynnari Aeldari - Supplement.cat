    </selectionEntry>
    <selectionEntry name="Artefact (H): The Starmist Raiment" id="8758-be21-8d9b-f280" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN69860" type="upgrade">
      <constraints>
        <constraint id="32d0-ba0c-d002-f621" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
