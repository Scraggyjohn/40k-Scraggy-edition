        </entryLink>
        <entryLink name="(DE) Reavers" id="7a78-9cc7-0064-a978" collective="false" hidden="false" import="true" targetId="2169-2106-a859-1d04" type="selectionEntry">
          <constraints>
            <constraint id="aa38-e2a5-b1ee-3041" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="fba7-9307-3667-70be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <rules>
        <rule name="Acolytes of Ynnead" id="b48c-4109-fc63-8ffe" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>Whenever a unit from this Formation destroys an enemy unit, or is itself destroyed, put a dice to one side until your next Psychic phase.  In your next Psychic phase, the Warlock Conclave generates an additional Warp Charge point for each dice set aside in this way.</description>
        </rule>
        <rule name="The Net is Cast" id="38f3-ab6b-5e2f-5559" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>All units in this Formation must be set up in Reserve.  Make a single Reserve roll for the Formation in each of your turns from the second, which you can choose to re-roll.  When this Formation arrives from Reserve, each unit moves onto the table as described for Reserves, except that each unit must move on from a different table edge (including your opponents).</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Artefact (Y): Corag Hai&apos;s Locket" id="d4ac-718e-028c-b687" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN65537" type="upgrade">
