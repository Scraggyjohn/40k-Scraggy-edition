    </selectionEntry>
    <selectionEntry name="Mindshock Pods" id="a903-84e7-1bf6-50eb" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN69600" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
