    <selectionEntry name="Flip Belt" id="68c5-c721-87f6-b7a3" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN69860" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="Flip Belt" id="a5d8-a428-7b2d-529a" hidden="false" publicationId="d744-5cc5-pubN69860" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with a flip belt is not slowed by difficult terrain and does not suffer the penalty to its Initiative for charging through difficult terrain.  In addition, a character with a flip belt always passes Look Out, Sir rolls on a 2+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Mirage Launchers" id="6d7f-4680-c26a-c5b3" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN108414" type="upgrade">
