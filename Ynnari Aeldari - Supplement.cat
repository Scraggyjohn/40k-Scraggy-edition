            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">6+/4++</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="A League Apart" id="5ec4-4363-c306-a347" hidden="false" publicationId="d744-5cc5-pubN69730">
          <description>Lelith Hesperax re-rolls all failed To Hit and To Wound rolls whilst fighting in a challenge.</description>
        </rule>
        <rule name="The Penetrating Blade" id="5c96-d332-bd70-7081" hidden="false" publicationId="d744-5cc5-pubN69730">
          <description>Armour Saves cannot be taken against Wounds inflicted by Lelith Hesperax&apos;s Melee weapons.</description>
        </rule>
        <rule name="Quicksilver Dodge" id="df14-e29a-0134-0467" hidden="false" publicationId="d744-5cc5-pubN69730">
          <description>Lelith Hesperax has a 4+ invulnerable save.  This is increased to a 3+ invulnerable save against all Wounds inflicted in the Fight sub-phase.</description>
        </rule>
      </rules>
