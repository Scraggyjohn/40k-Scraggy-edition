          <constraints>
            <constraint id="5b4e-5aad-1ee6-b5d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="fcea-44a5-20c5-0a0e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
        </entryLink>
        <entryLink name="(Y) The Visarch, Sword of Ynnead" id="9451-a79b-c425-e7d3" collective="false" hidden="false" import="true" targetId="724c-e2d4-93d7-7b9e" type="selectionEntry">
          <constraints>
            <constraint id="1f3d-50ac-fb01-6726" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="e02e-acd5-3839-e97f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <rules>
        <rule name="Heralds of Rebirth" id="3ec1-5e2d-9ad6-2fe2" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>Friendly non-vehicle units from an Ynnari Formation or Detachment that are within 12&quot; of two models from the Triumvirate of Ynnead have the Fearless special rule. Whilst all three models from this Formation are on the battlefield, all friendly models with the Ynnari Faction have the Fearless special rule.</description>
        </rule>
        <rule name="Ynnead&apos;s Chosen" id="391c-7dcc-ed52-d9d2" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>If all three models from this Formation are on the battlefield, you can add 1 to any rolls made for the Avatar of Ynnead, Champion of Yynead, and Herald of Ynnead special rules.</description>
        </rule>
      </rules>
    </selectionEntry>
