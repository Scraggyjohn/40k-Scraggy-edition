      <rules>
        <rule name="Crack Shot" id="8952-355b-3762-3400" hidden="false" publicationId="d744-5cc5-pubN69600">
          <description>A model with this special rule can re-roll one failed To Hit or To Wound roll, or armour penetration roll, per turn.</description>
        </rule>
        <rule name="Unquenchable Resolve" id="d60e-d812-1a70-8009" hidden="false" publicationId="d744-5cc5-pubN69600">
          <description>At the end of any phase in which Fuegan suffers one or more unsaved Wounds, his Strength and Attacks increase by 1 for each unsaved Wound suffered.  These characteristic bonuses last for the rest of the game.</description>
        </rule>
      </rules>
