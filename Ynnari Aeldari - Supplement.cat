            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the Wing Leader&apos;s Agility value.  Add an additional 1 to the Wing Leader&apos;s Agitility value during the Dogfight phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wing Leader (3-4): Supremely Graceful" id="c041-f1eb-f7fd-630d" hidden="false" publicationId="d744-5cc5-pubN139400" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">This Wing Leader has a 5+ invulnerable save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wing Leader (5-6): Blessed of Khaine" id="8e03-95ad-bf16-5a2e" hidden="false" publicationId="d744-5cc5-pubN139400" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll To Hit rolls of 1 for the Wing Leader and all of the other models in their Flyer Wing.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Dark Eldar Wing Leader Traits" id="5836-355d-5d3b-6fa1" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN139400" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <profiles>
        <profile name="Wing Leader (1-2): Bloodthirsty Hunter" id="3a14-2684-90b2-b4d9" hidden="false" publicationId="d744-5cc5-pubN139400" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the Wing Leader&apos;s Pursuit value.  Add an additional 1 when making Enagagement rolls for the Wing Leader in a Dogfight.</characteristic>
          </characteristics>
        </profile>
        <profile name="Wing Leader (5-6): Selfish Leader" id="ce34-6123-9623-6288" hidden="false" publicationId="d744-5cc5-pubN139400" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can add 1 to this Wing Leader&apos;s Ballistic Skill if they attack before the other Flyers in their Wing (there must still be at least one other Flyer from the Flyer Wing on the battlefield).</characteristic>
          </characteristics>
        </profile>
        <profile name="Wing Leader (3-4): Arrogant Perfectionist" id="156e-e8c1-631c-d2a9" hidden="false" publicationId="d744-5cc5-pubN139400" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll one dice roll for the Wing Leader each turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
