      </costs>
      <profiles>
        <profile name="Corag Hai&apos;s Locket" id="52e9-6318-0893-b667" hidden="false" publicationId="d744-5cc5-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When the bearer destroys one or more enemy models in the Fight sub-phase, roll a dice before removing any casualties.  On a 4 or more, the bearer regains a lost Wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
