      <infoLinks>
        <infoLink name="Fearless" id="b9d5-a692-3551-abc3" hidden="false" targetId="8d37-2e47-4a04-58f7" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="The Mask of Secrets" id="5fef-ae1c-f94a-8504" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A model with the Mask of Secrets has the Fearless special rule. In addition, enemy models within 12&quot; of the bearer suffer -2 to their Leadership.</characteristic>
          </characteristics>
