      <infoLinks>
        <infoLink name="Furious Charge" id="972b-9867-c3fb-38ec" hidden="false" targetId="b6da-cce3-2346-9c27" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Chosen Warriors" id="bb04-c8c9-943f-e7a4" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>While a unit from this Formation is Joined by the Visarch and/or Yvraine, add 1 to the Weapon Skill and Ballistic Skill characteristics of the models in that unit.  This bonus does not increase the characteristics of the Visarch or Yvraine.</description>
        </rule>
        <rule name="The Vigour of Old" id="e53c-382a-6122-8f8f" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>While a unit from this Formation is within 7&quot; of another unit from this Formation, it has the Furious Charge special rule.</description>
        </rule>
        <rule name="First of the Reborn" id="45cf-9b8e-4d1e-d82a" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>Units from this Formation can make a Soulburst action if they are within 14&quot; of a unit that is destroyed, rather than 7&quot;.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Wyches/Bloodbrides" id="3893-811b-6cd9-ca5c" collective="false" hidden="false" import="true">
