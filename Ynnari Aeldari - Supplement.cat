          <infoLinks>
            <infoLink name="Two-Handed" id="ac56-fa17-bddd-6f0a" hidden="false" targetId="b11c-0ef4-af6b-d96f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Asu-var, the Sword of Silent Screams" id="8f15-f8c4-a6a5-fc95" hidden="false" publicationId="d744-5cc5-pubN65537" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+2</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Silence, Two-Handed</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Silence" id="a2c0-6f43-02bb-9e59" hidden="false" publicationId="d744-5cc5-pubN65537">
              <description>Enemy units within 3&quot; of the Visarch use the lowest Leadership characteristic in their unit, rather than the highest.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
