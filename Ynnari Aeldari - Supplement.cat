      <rules>
        <rule name="Impale" id="09a8-e02b-1d72-706a" hidden="false" publicationId="d744-5cc5-pubN69730">
          <description>A model fighting with an Impaler re-rolls all To Wound rolls of a 1 when fighting in close combat.</description>
