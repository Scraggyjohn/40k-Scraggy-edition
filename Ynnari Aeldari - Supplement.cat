      <rules>
        <rule name="Sharpshot" id="58f6-54c6-6d54-e1af" hidden="false" publicationId="d744-5cc5-pubN69600">
          <description>Shots fired by models with this special rule (excluding Snap Shots) are always Precision Shots as described in the Precision Shot special rule (see Warhammer 40,000: The Rules).</description>
        </rule>
        <rule name="Master of Pathfinders" id="2b59-94e7-f96d-541d" hidden="false" publicationId="d744-5cc5-pubN69600">
          <description>If Illic Nightspear joins a unit of Rangers, all Rangers in that unit gain the Sharpshot special rule whilst he is a part of that unit.</description>
        </rule>
        <rule name="Walker of the Hidden Path" id="dd6e-3e06-cb5b-9632" hidden="false" publicationId="d744-5cc5-pubN69600">
          <description>If Illic Nightspear deploys using the Infiltrate special rule, he can be deployed anywhere on the battlefield that is outside of impassable terrain, regardless of enemy proximity.  If he begins the game with a unit of Rangers, all Rangers in that unit benefit from this rule.</description>
        </rule>
      </rules>
