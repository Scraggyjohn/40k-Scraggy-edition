    <profile name="Bright Lance" id="ea87-d278-0b1e-ffe1" hidden="false" publicationId="d744-5cc5-pubN69600" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
