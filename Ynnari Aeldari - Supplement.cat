    <selectionEntry name="Formation (Y): Triumvirate of the Ynnead" id="f465-6e2a-6597-e771" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN65537" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="(Y) The Yncarne, Avatar of Ynnead" id="cb9e-cc4e-0737-2b64" collective="false" hidden="false" import="true" targetId="22b0-3a0a-0ef1-e17d" type="selectionEntry">
          <constraints>
