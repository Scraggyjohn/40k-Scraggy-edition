          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model with a webway portal is in Reserves or Ongoing Reserves, then the model and any unit it has joined or is embarked upon has the Deek Strike special rule.  This model, and his unit, will not scatter if arriving from Deep Strike Reserve.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Shadow Field" id="b63d-bcb6-c450-034f" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN69730" type="upgrade">
