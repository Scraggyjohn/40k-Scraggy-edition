        <cost name="pts" typeId="points" value="25"/>
      </costs>
      <profiles>
        <profile name="The Starmist Raiment" id="f1f9-c671-f75b-978b" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a model with the Starmist Raiment Runs in its Shooting phase, it has a 3+ invulnerable save until the start of its next Shooting phase.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Artefact (H): The Storied Sword" id="ae14-e36c-db09-aaf0" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN69860" type="upgrade">
      <constraints>
        <constraint id="2077-0c39-705e-43db" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
