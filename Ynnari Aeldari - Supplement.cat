          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Artefact (H): Crescendo" id="bd4d-fa35-882e-e027" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN69860" type="upgrade">
      <constraints>
