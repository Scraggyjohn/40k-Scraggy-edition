      </costs>
      <infoLinks>
        <infoLink name="Blind" id="de5d-537c-8d3a-5183" hidden="false" targetId="8fad-693f-88b4-bac6" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Scattershield" id="e0d9-3a37-4fc2-eac2" hidden="false" publicationId="d744-5cc5-pubN69600" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The bearer has a 5+ invulnerable save.  Whenever the bearer passes one or more saving throws using its scattershield, all enemy units within 6&quot; must test as if they had just been hit by a weapon with the Blind special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Shimmershield" id="5ed0-ceb6-57dc-1622" collective="false" hidden="false" import="true" publicationId="d744-5cc5-pubN69600" type="upgrade">
