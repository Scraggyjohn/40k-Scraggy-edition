        <categoryLink name="Lord of War" id="c673-f6cf-adc1-5a18-c888f08a-6cea-4a01-8126-d374a9231554" hidden="false" primary="false" targetId="c888f08a-6cea-4a01-8126-d374a9231554">
          <constraints>
            <constraint id="e4ea-58eb-2196-d7c1" field="selections" includeChildForces="true" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Formation" id="c673-f6cf-adc1-5a18-28b94f51-e66b-4096-aa59-0c9df620a77d" hidden="false" primary="false" targetId="28b94f51-e66b-4096-aa59-0c9df620a77d"/>
      </categoryLinks>
      <rules>
        <rule name="Leader of the Reborn" id="6739-f682-ddea-9237" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>If this Detachment is chosen as your Primary Detachment, you can choose to re-roll the result on the Ynnari Warlord Traits table.</description>
        </rule>
        <rule name="Our Souls We Entrust" id="be95-af47-6394-ea33" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>Units from this Detachment have the Stubborn special rule.  In addition, if a unit from this Detachment is within 7&quot; of another unit from this Detachment, it does not have to take a Morale check when it loses 25&quot; or more of its current models during a single phase (measure the distance at the end of the phase).</description>
        </rule>
        <rule name="Warhost of Ynnead" id="37c5-8cf3-c3db-2a39" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>If this Detachment includes 7 or more units, you can select one additional unit to make a Soulburst action each time a unit is destroyed.</description>
        </rule>
      </rules>
    </forceEntry>
  </forceEntries>
  <publications>
    <publication name="Gathering Storm: Fracture of Biel-Tan" id="d744-5cc5-pubN65537"/>
    <publication name="Gathering Storm: Fracture of Biel Tan" id="d744-5cc5-pubN69303"/>
