      <infoLinks>
        <infoLink name="Bladestorm" id="36a4-6e8e-c89d-7805" hidden="false" targetId="4a28-f6ab-4b54-d700" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Crescendo" id="4ee7-6ddf-3389-97a9" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
