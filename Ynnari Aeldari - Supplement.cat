        <infoLink name="Fear" id="daee-9df2-9cc6-a76f" hidden="false" targetId="280d-1a0c-5916-3012" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Reborn Souls" id="c60d-1316-9bc7-ccaf" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>Non-character models in this Formation can re-roll To Hit rolls of 1 that target enemy units within 12&quot; of a character from this Formation</description>
        </rule>
        <rule name="Spirit Whispers" id="2182-0f21-b767-6813" hidden="false" publicationId="d744-5cc5-pubN65537">
          <description>Enemy units locked in combat with any units from this Formation suffer a -2 penalty to their Leadership when taking Fear tests.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
