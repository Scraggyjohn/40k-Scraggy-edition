      </profiles>
      <rules>
        <rule name="Hallucinogenic" id="035e-0a9c-00a9-7e57" hidden="false" publicationId="d744-5cc5-pubN69860">
          <description>At the end of the Shooting phase, a unit that has suffered one or more hits from a weapon with this special rule in that phase must make a Pinnint test.  If that test is failed, then in addition to being Pinned the unit suffers a single Wound with no armour or cover saves allowed.  This Wound is Randomly Allocated.</description>
        </rule>
      </rules>
    </selectionEntry>
