        <infoLink name="Pinning" id="4ad8-4813-3afc-0580" hidden="false" targetId="8918-d7ce-5edb-3b70" type="rule"/>
        <infoLink name="Poisoned" id="1cec-e429-d1eb-2c18" hidden="false" targetId="a5ff-1cb1-bee4-d809" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(2+)"/>
          </modifiers>
