      <profiles>
        <profile name="Hallucinogen Grenade Launcher" id="09b6-7877-498e-329c" hidden="false" publicationId="d744-5cc5-pubN69860" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
