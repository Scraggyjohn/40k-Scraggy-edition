          <description>You can re-roll one saving throw each turn for each model from this Formation.</description>
        </rule>
        <rule name="Inspiring Presence" id="1712-8bcd-325e-62c2" hidden="false" page="130" publicationId="b3f5-5360-pubN65537">
          <description>Whilst Grand Master Voldus and Rouboute Guilliman are on the battlefield, all friendly units with the Armies of the Imperium Faction have the Stubborn special rule.</description>
        </rule>
      </rules>
