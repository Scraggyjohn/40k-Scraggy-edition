          <rules>
            <rule name="Spiritlink" id="8b05-0bef-a7d4-1ada" hidden="false">
              <description>Whenever Eldrad Ulthran successfully passes a Psychic test, roll a D6. On a score of 5 or 6 he immediately generates a Warp Charge point.</description>
