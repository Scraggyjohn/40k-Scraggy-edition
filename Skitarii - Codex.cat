        <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic>
        <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">9</characteristic>
        <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+/5++</characteristic>
      </characteristics>
    </profile>
    <profile name="The Scryerskull Perspicatus" id="12db-4fbf-617f-6bb0" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">At the start of each of your turns, a model with the Scryerskull Perspicatus can choose either to identify a single Mysterious Objective or to scry an enemy vehicle anywhere on the battlefield. If you choose to scry a vehicle, any friendly units with the Cult Mechanicus or Skitarii Faction re-roll failed armour penetration rolls against that vehicle, and can choose to re-roll glancing hits scored on it in an attempt to instead get a penetrating hit, until the start of your next turn.</characteristic>
      </characteristics>
    </profile>
