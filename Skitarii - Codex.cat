        <categoryLink name="Primary Detachment" id="2086-3a89-9082-e522-41a4-c4a9-7790-4259" hidden="false" primary="false" targetId="41a4-c4a9-7790-4259">
          <constraints>
            <constraint id="491e-8183-b43b-4136" field="selections" includeChildForces="true" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2806-3748-0613-2126" field="points" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="0"/>
