      <rules>
        <rule name="Ident Confirmed" id="c17a-335e-b299-5893" hidden="false" page="67" publicationId="2301-1cab-pubN65537">
          <description>At first game turn&apos;s start, select an enemy character. This formation re-rolls Wounds against that character and her or his unit.</description>
        </rule>
        <rule name="Mindlnked Hunters" id="c664-3d4e-a937-3901" hidden="false" page="67" publicationId="2301-1cab-pubN65537">
          <description>This formation&apos;s targets are never obscured by this formation&apos;s intervening models.</description>
        </rule>
        <rule name="The Noose Tightens" id="095c-bb56-b6d2-581d" hidden="false" page="67" publicationId="2301-1cab-pubN65537">
          <description>Must reserve all this formation&apos;s units. Roll for all units to arrive simultaneously, beginning your first turn.</description>
        </rule>
      </rules>
