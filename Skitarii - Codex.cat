    <selectionEntry name="How to create AdMech formations" id="6be5-d88d-153a-b105" collective="false" hidden="false" import="true" type="model">
      <categoryLinks>
        <categoryLink name="Instructions" id="6be5-d88d-153a-b105-ffe4-2701-10c2-462e" hidden="false" primary="true" targetId="ffe4-2701-10c2-462e"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Instructions" id="d3cf-b48c-a150-91c3" hidden="false">
          <description>For every combined formation exists a separate detachment in each codex. They are named appropriately. When building a list, add each detachment with the required units/formations to create the super formation.</description>
        </rule>
      </rules>
    </selectionEntry>
