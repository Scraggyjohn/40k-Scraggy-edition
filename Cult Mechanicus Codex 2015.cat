      <rules>
        <rule name="Awaken the Machine" id="b4a5-983d-f8fc-7dbf" hidden="false">
          <description>In each of your shooting phases, instead of firing his weapons, the Enginseer may choose a single friendly Astra Militarum vehicle within 12&quot;. That vehicle gains the Power of the Machine Spirit SR until the end of the turn.</description>
        </rule>
