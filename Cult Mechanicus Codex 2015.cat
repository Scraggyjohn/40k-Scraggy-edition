    <selectionEntry name="Cohort Cybernetica" id="1323-f065-796d-fd19" collective="false" hidden="false" import="true" publicationId="4fe1-8588-pubN65537" type="unit">
      <categoryLinks>
        <categoryLink name="Formation" id="1323-f065-796d-fd19-28b94f51-e66b-4096-aa59-0c9df620a77d" hidden="false" primary="true" targetId="28b94f51-e66b-4096-aa59-0c9df620a77d"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Kastelan Robot Maniple" id="7d51-483c-3239-0188" collective="false" hidden="false" import="true" targetId="99eb-e6d9-d466-8d5e" type="selectionEntry">
          <constraints>
            <constraint id="9ac5-612e-cb25-88d7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="2"/>
            <constraint id="db59-f56c-94ea-8731" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="2"/>
          </constraints>
        </entryLink>
        <entryLink name="Dominus" id="1655-64c9-fefa-a3c5" collective="false" hidden="false" import="true" targetId="af47-061e-5bed-7396" type="selectionEntryGroup"/>
      </entryLinks>
      <rules>
        <rule name="Adept of the Cybernetica" id="6ff3-a0eb-7aee-7bf4" hidden="false" page="66" publicationId="4fe1-8588-pubN65537">
          <description>The Tech-Priest Dominus of this Cohort Cybernetica Formation counts as a Cybernetica Datasmith for the purposes of the Battle Protocols special rule. As long as the Tech-Priest Dominus is alive, the Battle Protocols are activated instantly.</description>
        </rule>
        <rule name="Targeting Override" id="57c8-6adf-f56d-e488" hidden="false" page="66" publicationId="4fe1-8588-pubN65537">
          <description>In the Shooting phase, any number of this Cohort Cybernetica Formation&apos;s Cybernetica Datasmiths and/or Tech-Priest Dominus can direct the fire of the Kastelan Robots, instead of shooting. For each model that does so, one Kastelan Robot can shoot at a different target to the rest of the unit.</description>
        </rule>
        <rule name="Cohort Cybernetica" id="03c7-dc3a-3d64-4132" hidden="false" page="66" publicationId="4fe1-8588-pubN65537">
          <description>All models in this Formation must be fielded as a single unit, even though this is not normally allowed. The Formation&apos;s Tech-Priest Dominus cannot leave this unit.

This Formation counts as three units for the purposes of Canticles of the Omnissiah until it is completely destroyed, and counts as three units for the purposes of Victory Points when it is completely destroyed.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Numinous Conclave" id="788f-112f-c63a-9226" collective="false" hidden="false" import="true" publicationId="4fe1-8588-pubN65537" type="unit">
      <categoryLinks>
        <categoryLink name="Formation" id="788f-112f-c63a-9226-28b94f51-e66b-4096-aa59-0c9df620a77d" hidden="false" primary="true" targetId="28b94f51-e66b-4096-aa59-0c9df620a77d"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="The Corpuscarii Giveth" id="3cda-8ef1-7b73-aa5b" hidden="false" page="68" publicationId="4fe1-8588-pubN65537">
          <description>If there is any Fulgurite unit of the same Numinous Concalve Formation at 6&quot; or less, the Corpuscarii Gauntlets are Assault 3. If the Corpuscarii causes any unsaved Wound, the enemy unit is considered &quot;Electrified&quot; until the end of the Assault phase.</description>
        </rule>
        <rule name="The Fulgurites Taketh Away" id="7b51-2f92-2e28-8a74" hidden="false" page="68" publicationId="4fe1-8588-pubN65537">
          <description>Fulgurite Electro-priests in this Numinous Conclave Formation re-roll to Wound using their electroleech staves if there is any &quot;Electrified&quot; unit locked in close combat.</description>
        </rule>
        <rule name="Crusader" id="b712-2ffb-7a36-b0f5" hidden="false" page="163" publicationId="4fe1-8588-pubN75687">
          <description>A unit that contains at least one model with this special rule rolls an extra dice when making Run moves, and uses the highest result rolled. In addition, a unit that contains at least one model with this special rule adds D3 to its Sweeping Advance totals (roll each time).</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Fulgurite Electro-Priests" id="af43-cb01-a4ad-fab9" collective="false" defaultSelectionEntryId="72f0-5fda-3034-8cc3" hidden="false" import="true">
          <constraints>
            <constraint id="dad1-e3c2-6052-95aa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="2"/>
            <constraint id="8654-94bf-60a9-a158" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
