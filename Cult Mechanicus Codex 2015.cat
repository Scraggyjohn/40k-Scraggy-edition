      <selectionEntries>
        <selectionEntry name="The Scryerskull Perspicatus" id="d62f-a958-4f38-3178" collective="false" hidden="false" import="true" page="78" publicationId="4fe1-8588-pubN65537" type="upgrade">
          <constraints>
