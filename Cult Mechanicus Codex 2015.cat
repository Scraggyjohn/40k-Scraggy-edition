        <profile name="Mechanicus Shield Generator" id="13f5-9baa-59de-7d42" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per battle, at the start of any phase, this model can use this wargear. If it does, until the end of the phase, all models in the model&apos;s unit have a 4+ Invulnerable save.</characteristic>
