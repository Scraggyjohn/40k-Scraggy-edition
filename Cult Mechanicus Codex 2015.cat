          </modifiers>
          <profiles>
            <profile name="Raiment of Technomartyr" id="ee6d-acf7-63b2-05ec" hidden="false" page="78" publicationId="4fe1-8588-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">2+ armour save. All ranged weapons carried by models with the Cult Mechanicus or Skitarii Faction in the bearer&apos;s unit have the Cognis Weapons special rule.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Cognis" id="4455-0a65-ac00-58bf" hidden="false" page="78" publicationId="4fe1-8588-pubN65537">
              <description>Snap shots at BS 2 instead of 1. If a Flamer weapon fires Overwatch using the Wall of Death rule (BRB 2014, page 173), it automatically inflicts 3 hits rather than D3.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Mask of the Alpha Dominus" id="932a-388f-9787-320a" collective="false" hidden="false" import="true" page="78" publicationId="4fe1-8588-pubN65537" type="upgrade">
          <constraints>
            <constraint id="maxInRoster" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="4f47-f3bd-4450-54c4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
