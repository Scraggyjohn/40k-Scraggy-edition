    <selectionEntry name="Corpuscarii Electro-Priests" id="931d-007d-20f7-5f4b" collective="false" hidden="false" import="true" publicationId="4fe1-8588-pubN65537" type="unit">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Corpuscarii Electro-Priest" id="3ae9-991e-ea38-8bfa" collective="false" hidden="false" import="true" targetId="9a62-e7bc-7869-ad26" type="selectionEntry"/>
