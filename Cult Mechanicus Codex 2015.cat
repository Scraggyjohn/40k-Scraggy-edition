    <profile name="Stasis Field" id="01c6-c42c-349e-3dfa" hidden="false" page="77" publicationId="4fe1-8588-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
