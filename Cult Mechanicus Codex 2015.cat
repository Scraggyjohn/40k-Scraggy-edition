    <selectionEntry name="Kastelan Robot" id="f7ae-70d3-4d11-abf8" collective="false" hidden="false" import="true" publicationId="4fe1-8588-pubN65537" type="model">
      <constraints>
        <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="2"/>
        <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="6"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="120"/>
      </costs>
      <entryLinks>
        <entryLink name="Kastelan battlehide" id="3501-2885-779a-7122" collective="false" hidden="false" import="true" targetId="6bf6-6a42-2421-bb4b" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Canticles of the Omnissiah (CotO)" id="7613-2765-e8ab-79bd" hidden="false" targetId="ebd3-71c4-e554-1948" type="rule"/>
        <infoLink name="Fearless" id="03ef-4c04-34b9-f046" hidden="false" targetId="8d37-2e47-4a04-58f7" type="rule"/>
        <infoLink name="Kastelan Robot" id="c291-0c04-89b1-0a18" hidden="false" targetId="9421-039f-e206-4830" type="profile"/>
      </infoLinks>
      <rules>
        <rule name="Repulsor Grid" id="8474-c8de-7f3c-4e91" hidden="false" page="65" publicationId="4fe1-8588-pubN65537">
          <description>Kastelan Robots have a 5+ invulnerable save against shooting attacks. Furthermore, each time a Kastelan Robot is targeted by a shooting attack and passes a saving throw of any kind on the roll a 6, the shot is deflected. If a shot is deflected, the unit that fired it suffers an inmediate hit resolved with the Strength, AP value and special rules of the hit that was originally allocated to the Kastelan Robot, as if it had just been shot at by that Kastelan Robot. A repulsor grid cannot deflect Blast or Template weapons or psychic shooting attacks.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Carapace-mounted" id="c44a-242e-eeb1-b9a1" collective="false" defaultSelectionEntryId="d3a4-0256-8166-756b" hidden="false" import="true">
