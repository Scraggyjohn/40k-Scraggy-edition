      </entryLinks>
      <infoLinks>
        <infoLink name="Zealot" id="0cb0-0ec9-4338-fa02" hidden="false" targetId="6fc0-ebe5-6c64-7c9f" type="rule"/>
        <infoLink name="Counter-attack" id="7590-107f-999a-bc1c" hidden="false" targetId="41fe-9e25-f4a8-095b" type="rule"/>
        <infoLink name="Deep Strike" id="9b7b-d10e-dfa3-5fa7" hidden="false" targetId="243a-b08c-3c8c-c363" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Apparition Extremis" id="b287-d2af-c7c4-8988" hidden="false" page="69" publicationId="4fe1-8588-pubN65537">
          <description>All units in this Formation must be placed in Deep Strike Reserve. Make one unique roll for Reserve for the entire Formation (with the option to re-roll if you want). If the roll is successful, all units in the Formation arrive from Reserve. First, place the Tech-Priest Dominus, he doesn&apos;t scatter if it&apos;s located at 6&quot; or less of an Objective Marker. Breachers units don&apos;t scatter if they&apos;re situated at 6&quot; or less of the Tech-Priest Dominus.</description>
        </rule>
        <rule name="Inhuman Avarice" id="2bf5-e374-1e76-f7ad" hidden="false" page="69" publicationId="4fe1-8588-pubN65537">
          <description>If any Breachers units in this Holy Requisitioner Formation are at 6&quot; or less of any Objective Marker, they gain Counter-attack and Zealot.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Kataphron Breachers" id="7012-e9a9-1677-d303" collective="false" defaultSelectionEntryId="7015-b326-ed02-e560" hidden="false" import="true">
