          <profiles>
            <profile name="Anzion&apos;s Pseudogenetor" id="0fed-9fe3-2dc8-8316" hidden="false" page="78" publicationId="4fe1-8588-pubN65537" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
