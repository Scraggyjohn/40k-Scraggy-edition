      </entryLinks>
      <rules>
        <rule name="Mindlock" id="ab27-52d5-947c-9704" hidden="false" page="109" publicationId="4fe1-8588-pubN77626">
          <description>Unless it includes a Techmarine, an unengaged unit that contains at least one model with this special rule must roll a D6 at the start of its turn.  
On a 4+ there is no effect this turn.  On a roll of 1,2 or 3, the unit is mindlocked until the start of its following turn.  
A mindlocked unit may not voluntarily move, shoot or charge. A mindlocked unit must still make compulsory moves, such as Pile In and Fall Back moves.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Weapons" id="6b69-9965-136e-448b" collective="false" defaultSelectionEntryId="892e-42bd-4249-2610" hidden="false" import="true">
