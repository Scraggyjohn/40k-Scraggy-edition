      <rules>
        <rule name="Agents of the Adeptus Mechanicus" id="e464-c71b-b586-2ae5" hidden="false">
          <description>All vehicles in this detachment have the It will not Die USR. In addition, all vehicles that are within 6&quot; of an HQ from this detachment at the start of the turn have the Power of the Machine Spirit USR until the start of your next turn.</description>
        </rule>
        <rule name="Chosen of the Omnissiah" id="9c8d-aab4-e2df-9cf1" hidden="false">
          <description>If this detachment is your primary, you can re-roll the result on the Warlord Trait table.</description>
        </rule>
        <rule name="Noospheric Choir" id="cca3-8dc6-192f-19dc" hidden="false">
          <description>If this detachment contains the maximum number of units (excluding troops), all units of this detachment have the Canticles of the Omnissiah USR.</description>
        </rule>
