            <profile name="Anzion&apos;s Pseudogenetor" id="753b-7e68-b893-aff1" hidden="false" page="79" publicationId="4fe1-8588-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When fighting in close combat, a model equipped with this relic makes D6 additional attacks using the Anzion&apos;s Pseudorgenetor profile, in addition to any close combat attacls it makes.</characteristic>
              </characteristics>
            </profile>
          </profiles>
