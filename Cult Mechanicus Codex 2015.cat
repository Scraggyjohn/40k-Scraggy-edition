    <selectionEntry name="Holy Requisitioner" id="9543-4c8e-0c7c-8a2a" collective="false" hidden="false" import="true" publicationId="4fe1-8588-pubN65537" type="unit">
      <categoryLinks>
        <categoryLink name="Formation" id="9543-4c8e-0c7c-8a2a-28b94f51-e66b-4096-aa59-0c9df620a77d" hidden="false" primary="true" targetId="28b94f51-e66b-4096-aa59-0c9df620a77d"/>
