              </constraints>
              <selectionEntries>
                <selectionEntry name="Guardian Spear" id="efb1-7cfa-cb03-08ba" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                  </costs>
                  <infoLinks>
