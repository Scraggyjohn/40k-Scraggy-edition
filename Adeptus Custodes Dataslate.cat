                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Storm Shield" id="9381-426d-b23e-a529" hidden="false" publicationId="34df-c088-pubN66249" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A storm shield confers a 3+ invulnerable save. In addition, a model equipped with a storm shield can never claim the +1 Attack for being armed with two Melee weapons in an assault.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup name="Weapon" id="3152-d103-00b1-36b0" collective="false" defaultSelectionEntryId="efb1-7cfa-cb03-08ba" hidden="false" import="true">
              <constraints>
