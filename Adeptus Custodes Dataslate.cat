              </costs>
              <profiles>
                <profile name="Power Knife" id="8cae-8569-23ec-04ba" hidden="false" publicationId="34df-c088-pubN66249" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
