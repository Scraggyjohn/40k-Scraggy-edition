                    <infoLink name="Boltgun" id="cc0b-090c-17db-c5e6" hidden="false" targetId="3d4b-95ea-f860-dd22" type="profile"/>
                  </infoLinks>
                  <profiles>
                    <profile name="Guardian Spear (melee)" id="6624-916a-fd0b-e406" hidden="false" publicationId="34df-c088-pubN66249" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
                        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+1</characteristic>
                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Block, Two-Handed</characteristic>
                        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Block" id="8a93-a1d4-bfdf-ca1a" hidden="false" publicationId="34df-c088-pubN66249">
                      <description>Once per turn, in the Assault Phase, each model equipped with a guardian spear can attempt to block a single Attack that targets its unit. After the To Hit roll has been made, roll a dice for each model attempting to block. If the result is higher than the To Hit roll, the attack is blocked and has no effect. Attacks that do not have a To Hit roll cannot be blocked.</description>
                    </rule>
                    <rule name="Guardian Spear" id="27e3-1cc3-8caf-0d32" hidden="false">
                      <description>A model equipped with a Guardian Spear can fire it as a boltgun. It can also attack with it in the Assault phase using the melee profile. It can do both in the same turn.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Custodes Vexilla" id="acf1-46de-122c-5594" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="3f0e-9e98-577c-d33d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ca9b-e195-defb-380a" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="30"/>
                  </costs>
                  <profiles>
                    <profile name="Custodes Vexilla" id="0ef7-1e68-841a-63e3" hidden="false" publicationId="34df-c088-pubN66249" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units from the Armies of the Imperium within 12&quot; of the bearer have the Fearless special rule. In addition, all friendly models from the Armies of the Imperium in the same unit as the bearer have +1 Attack whilst the bearer is alive.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Sentinel Blade" id="00b6-4540-1e66-5a2b" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Sentinel Blade (Melee)" id="3d3f-64ed-0403-5070" hidden="false" publicationId="34df-c088-pubN66249" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
