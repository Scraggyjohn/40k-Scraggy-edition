                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
                    <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
                    <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee</characteristic>
                    <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Storm Shield" id="3de0-2887-d103-8c8a" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e0db-633d-22aa-66fa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="ce64-2c86-15d7-5261" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Storm Shield" id="5215-abf9-6a93-cd29" hidden="false" publicationId="34df-c088-pubN66249" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A storm shield confers a 3+ invulnerable save. In addition, a model equipped with a storm shield can never claim the +1 Attack for being armed with two Melee weapons in an assault.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup name="Weapon" id="e2f4-0b49-83e2-ede1" collective="false" defaultSelectionEntryId="ce64-2c86-15d7-5261" hidden="false" import="true">
              <constraints>
                <constraint id="15aa-d987-71a9-0427" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="00a8-fe36-849e-c46f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
              </constraints>
              <selectionEntries>
                <selectionEntry name="Guardian Spear" id="ce64-2c86-15d7-5261" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                  </costs>
                  <infoLinks>
                    <infoLink name="Two-Handed" id="ee59-f35e-b04c-aa3f" hidden="false" targetId="b11c-0ef4-af6b-d96f" type="rule"/>
                    <infoLink name="Boltgun" id="3979-172b-9ad7-2661" hidden="false" targetId="3d4b-95ea-f860-dd22" type="profile"/>
                  </infoLinks>
                  <profiles>
                    <profile name="Guardian Spear (Melee)" id="ea94-8e8a-1ab7-0597" hidden="false" publicationId="34df-c088-pubN66249" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
                        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">+1</characteristic>
                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Block, Two-Handed</characteristic>
                        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Block" id="5b97-1cf3-5f99-f2c2" hidden="false" publicationId="34df-c088-pubN66249">
                      <description>Once per turn, in the Assault Phase, each model equipped with a guardian spear can attempt to block a single Attack that targets its unit. After the To Hit roll has been made, roll a dice for each model attempting to block. If the result is higher than the To Hit roll, the attack is blocked and has no effect. Attacks that do not have a To Hit roll cannot be blocked.</description>
                    </rule>
                    <rule name="Guardian Spear" id="3237-e0f2-2bd4-d29d" hidden="false" publicationId="34df-c088-pubN66249">
                      <description>A model equipped with a Guardian Spear can fire it as a boltgun. It can also attack with it in the Assault phase using the melee profile. It can do both in the same turn.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Custodes Vexilla" id="115d-db95-983c-8d2c" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="115c-0fc0-6960-be0d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="30"/>
                  </costs>
                  <profiles>
                    <profile name="Custodes Vexilla" id="7154-b35e-0733-555c" hidden="false" publicationId="34df-c088-pubN66249" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                      <characteristics>
                        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Friendly units from the Armies of the Imperium within 12&quot; of the bearer have the Fearless special rule. In addition, all friendly models from the Armies of the Imperium in the same unit as the bearer have +1 Attack whilst the bearer is alive.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Sentinel Blade" id="6cbe-6336-85c0-525b" collective="false" hidden="false" import="true" type="upgrade">
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Sentinel Blade (Melee)" id="4e36-538b-a577-a600" hidden="false" publicationId="34df-c088-pubN66249" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
                        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee</characteristic>
                        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
                      </characteristics>
                    </profile>
                    <profile name="Sentinel Blade (Ranged)" id="33a8-0d0b-4d6f-fca4" hidden="false" publicationId="34df-c088-pubN66249" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                      <characteristics>
                        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12&quot;</characteristic>
                        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
                        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
                        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Assault 2, Hail of Fire, Bolt Caster</characteristic>
                        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
                      </characteristics>
                    </profile>
                  </profiles>
                  <rules>
                    <rule name="Bolt Caster" id="f2d2-84e2-e1cd-2eec" hidden="false" publicationId="34df-c088-pubN66249">
