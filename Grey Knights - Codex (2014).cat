              <profiles>
                <profile name="Isstvan III" id="714f-076f-71a4-95f6" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has the Preferred Enemy (Chaos Space Marines) special rule. In addition, it automatically passes Dangerous Terrain tests incurred for passing through ruins and similar terrain.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Burning of Prospero" id="1d22-d0a9-4a36-0e70" collective="false" hidden="false" import="true" type="upgrade">
