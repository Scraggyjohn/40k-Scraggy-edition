      </infoLinks>
      <rules>
        <rule name="The Strands of Fate" id="a3f2e5db-bc77-52e9-7699-ee91818b03d4" hidden="false" page="61" publicationId="987d0372--pubN65537">
          <description>May re-roll one to hit, to wound or saving throw each phase.
However, for every dice re-rolled using this rule, your opponent can re-roll one to hit, to wound or saving throw at any point later in the game.</description>
        </rule>
        <rule name="Zone of Banishment" id="beba5b32-6419-f217-cd2b-89390dcc9124" hidden="false" page="61" publicationId="987d0372--pubN65537">
          <description>If he succesfully manifests the Banishment psychic power, it targets all enemy units with the Daemon rule that are within 12&quot; instead of a single unit within 24&quot;</description>
        </rule>
      </rules>
