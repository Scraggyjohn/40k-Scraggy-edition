    <profile name="Warlord Trait: Daemon-slayer" id="4b6b3dd8-85db-3d65-4192-8653d4686908" hidden="false" page="86" publicationId="987d0372--pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Warlord gains Hatred: Daemons and succesfully harnesses Warp Charges on a 2+ when trying to manifest &apos;Banishment&apos;.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warlord Trait: First to the Fray" id="f2685b65-fe71-d41f-17aa-cebcfbe2ba6b" hidden="false" page="86" publicationId="987d0372--pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If placed in Deep Strike Reserve, the Warlord and his unit automatically arrive in your first turn and can re-roll the scatter dice.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warlord Trait: Hammer of Righteousness" id="2770a0e1-3dea-9842-4276-34d4f65cf719" hidden="false" page="86" publicationId="987d0372--pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Warlord and his unit have Hammer of Wrath</characteristic>
      </characteristics>
    </profile>
    <profile name="Warlord Trait: Lore Master" id="84ef5ab3-cf8e-87c9-09d1-efae032098b7" hidden="false" page="86" publicationId="987d0372--pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Warlord knows one more Psychic power from Daemonology (Sanctic)</characteristic>
      </characteristics>
    </profile>
    <profile name="Warlord Trait: Perfect Timing" id="4f85e448-3e93-bfbf-6781-96d6237c094d" hidden="false" page="86" publicationId="987d0372--pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Warlord and his unit have Counter-attack.</characteristic>
      </characteristics>
    </profile>
    <profile name="Warlord Trait: Unyielding Anvil" id="b31bca15-962b-1e82-ab62-d53833073e9c" hidden="false" page="86" publicationId="987d0372--pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Warlord an all friendly Grey Knight-units within 12&quot; have Stubborn.</characteristic>
      </characteristics>
    </profile>
