                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Adamantium Will special rule. The bonus granted by this special rule is increased to +2 against Witchfire type psychic powers.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Battle of Calth" id="13c8-2693-9269-3603" collective="false" hidden="false" import="true" type="upgrade">
