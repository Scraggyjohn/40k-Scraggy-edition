              <profiles>
                <profile name="Battle of Signus Prime" id="87c9-f1ca-0393-1222" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has the Preferred Enemy (Chaos Demons) special rule. In addition, friendly Space Marines who begin the turn within 6&quot; of the vehicle gain the Furious Charge special rule until the end of that turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
