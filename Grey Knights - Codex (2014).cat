                <cost name="pts" typeId="points" value="100"/>
              </costs>
              <profiles>
                <profile name="Icon of Glory" id="e21b-a15d-2854-8137" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle has either +1 BS or +1 WS (declared before the game begins. Should the army&apos;s warlord be within 2&quot; of the vehicle, the range of any Command Trait he has rolled on the warlord traits table is increased by +6&quot;  In missions that use Objectives and Victory points to determine the winner, the destruction of the vehicle counts as an additional Secondary Objective, earning the opposing player an extra +1 Victory point.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Shrouded Provenance" id="efd3-3308-e5da-9a97" collective="false" hidden="false" import="true" type="upgrade">
