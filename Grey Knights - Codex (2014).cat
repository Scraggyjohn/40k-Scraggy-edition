      </rules>
      <selectionEntries>
        <selectionEntry name="Twin-linked Castigator pattern Bolt cannon" id="b2bd84d6-772c-855d-6fee-4b1d8a70c0d5" collective="false" hidden="false" import="true" type="upgrade">
