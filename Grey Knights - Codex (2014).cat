                <profile name="Battle of Calth" id="d6bc-172e-4083-6e65" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
                  <characteristics>
                    <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The vehicle gains the Preferred Enemy (Chaos Space Marines) special rule. In addition, enemy Warlords within 12&quot; suffer -1 to their leadership characteristic.</characteristic>
                  </characteristics>
