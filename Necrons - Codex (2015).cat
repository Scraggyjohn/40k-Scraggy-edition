                <condition childId="3b4f-faec-3104-33da" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                <condition childId="25e5f37f-a63f-32aa-a64c-f6a321c78358" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
