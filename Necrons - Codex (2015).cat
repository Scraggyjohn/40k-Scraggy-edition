        <profile name="Night Scythe" id="ccf08a95-2d3e-983d-6b7c-a982978ec20b" hidden="false" publicationId="026a-37f6-pubN68514" typeId="3a08-ea03-a598-8615" typeName="Flyer">
          <characteristics>
            <characteristic name="BS" typeId="9878-e3f6-b7b4-7225">4</characteristic>
            <characteristic name="Front" typeId="3a4e-bc1d-4a12-7176">11</characteristic>
            <characteristic name="Side" typeId="d12e-7bdb-191c-4849">11</characteristic>
