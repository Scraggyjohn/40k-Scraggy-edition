            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">5</characteristic>
            <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">5</characteristic>
            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">3</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+/4++</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Adaptive Tactics" id="af67-427c-cfcf-2410" hidden="false" publicationId="026a-37f6-pubN68514">
          <description>If Nemesor Zahndrekh is your Warlord, you may select a different Warlord Trait for him (no D6 roll is necessary) at the start of each friendly turn after the first - this replaces his existing Warlord Trait. This can be from the table in the Appendix, or any of the Warlord Traits tables in Warhammer 40,000: The Rules. Zahndrekh cannot choose the same Warlord Trait more than once per game.</description>
        </rule>
        <rule name="Counter Tactics" id="d30e-90ea-0c2a-0242" hidden="false" publicationId="026a-37f6-pubN68514">
          <description>Whilst Nemesor Zahndrekh is within 24&quot; of any enemy unit(s) with any of the following special rules - Counter-attack, Furious Charge, Hit &amp; Run, Split Fire, Stealth, Tank Hunters - then Zahndrekh and his unit also have the same special rule(s).</description>
        </rule>
      </rules>
    </selectionEntry>
