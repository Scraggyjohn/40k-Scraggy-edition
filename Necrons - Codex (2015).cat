      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Wing Leader" id="79da-ff13-11d0-259a" hidden="false" targetId="c394-6f30-fec2-5bce" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="1-2: Offensive Subroutines" id="d5d8-e73e-3167-f4f0" hidden="false" publicationId="026a-37f6-pubN89437" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Add 1 to the Wing Leader&apos;s Ballistic Skill for one weapon in each Shooting phase.  Add 1 to the Ballistic Skill of all other Flyers in the Wing that are firing the same weapon if the Wing is in an Attack Pattern.</characteristic>
          </characteristics>
        </profile>
        <profile name="5-6: Living Craft" id="e55c-c4ce-278b-1550" hidden="false" publicationId="026a-37f6-pubN89437" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The Wing Leader has the It Will Not Die special rule.</characteristic>
          </characteristics>
        </profile>
        <profile name="3-4: Defensive Subroutines" id="4ca0-5b96-33e9-d6dc" hidden="false" publicationId="026a-37f6-pubN89437" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">You can re-roll one saving throw for this Wing Leader each turn.  You can re-roll one saivng throw for each other Flyer in the Wing if it is in an Attack Pattern.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Canoptek Doomstalker" id="0340-1112-79d6-00ba" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Heavy Support" id="729d-0bad-a50b-ba2c" hidden="false" primary="true" targetId="abf5fd55-9ac7-4263-8bc1-a9fb0a8fa6a6"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="150"/>
      </costs>
      <infoLinks>
        <infoLink name="Living Metal" id="b8c0-a282-bcd9-1155" hidden="false" targetId="461bbe4e-d707-b924-e36c-3506a4b46feb" type="rule"/>
        <infoLink name="Ever-living" id="6a90-340b-dab3-7e39" hidden="false" targetId="500e-9af0-8415-1b9d" type="rule"/>
        <infoLink name="Move Through Cover" id="3b27-de49-e450-ea65" hidden="false" targetId="7ecc-bc3d-6e22-63dc" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Canoptek Doomstalker" id="f06a-bc5d-b40a-e234" hidden="false" typeId="3dadd2ff-33f1-41dd-85c7-bee5a7dfa413" typeName="Walker">
          <characteristics>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">5</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">3</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">6</characteristic>
            <characteristic name="Front" typeId="8cdd4fef-d1ba-4007-992c-b6f93e86d43f">11</characteristic>
            <characteristic name="Side" typeId="5f9a3780-eecb-4c70-be1d-e5bd06b06e9e">11</characteristic>
            <characteristic name="Rear" typeId="0a9f33cb-0412-420a-89d2-20707c360bd2">10</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="HP" typeId="ae95a1af-719f-4365-b951-33cd3ca9148a">3</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Vehicle (Walker)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Sentinel Construct" id="8d99-4388-2451-27bc" hidden="false">
          <description>When a friendly Necron Unit within 6” of this model is the target of a Charge, this model may perform Overwatch as if it were also a target of the charge (this is in addition to any other units firing overwatch), and this Overwatch uses the High Power of the Doomsday Blaster. A model may only overwatch once per turn.</description>
        </rule>
        <rule name="Contaiment Field" id="d0f0-7b13-cb79-52d7" hidden="false">
          <description>The Doomstalker has a Containment Field. Each Ranged Attack hit against the Doomstalker will instead hit the Containment Field. The Containment Field has an Armour Value of 10. A glancing or Penetrating hit against the Containment Field causes it to collapse. After the Containment Field collapses, any further hits are resolved against the Doomstalker. At the end of each of the Doomstalkers Turns, roll a D6, on a 5+ the Containment Field restores itself. On a roll of a 1, the Containment Field may not be used again this game.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Weapons" id="5d41-90ff-0b42-5316" hidden="false">
          <selectionEntries>
            <selectionEntry name="Doomsday Blaster" id="8c2d-ac61-61fb-68b0" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3df2-c76a-bfc4-1895" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="5ee8-7579-4fc6-3d98" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Gets Hot" id="b890-dde3-860c-1afc" hidden="false" targetId="4e9f-4f6f-6fbc-6418" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Doomsday Blaster - Low Power" id="bf28-b0ff-79e4-3117" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
                    <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">8</characteristic>
                    <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">4</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy D3, Blast</characteristic>
                  </characteristics>
                </profile>
                <profile name="Doomsday Blaster - High Power" id="2a1c-bd8b-2814-53e8" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic>
                    <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">10</characteristic>
                    <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">1</characteristic>
                    <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 1, Large Blast, Gets Hot, Ponderous</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Ponderous" id="3d2b-56b3-c6e1-1686" hidden="false">
                  <description>The bearer can only make attacks with this weapon if it did not move during the Movement Phase this turn.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Close Combat Weapon" id="e5af-a141-1466-80f0" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1abd-ecd0-4811-c011" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
