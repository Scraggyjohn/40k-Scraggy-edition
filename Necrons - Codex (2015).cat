            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">6</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">4</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">5</characteristic>
            <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">5</characteristic>
            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">2</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">2+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Cleaving Counterblow" id="4160-25ed-5025-97b9" hidden="false" publicationId="026a-37f6-pubN68514">
          <description>When fighting in a challenge, Vargard Obyron gains a bonus Attack for each Attack made by an enemy character against him that fails To Hit. These Attacks are made at the Initiative 1 step (this does not grant an additional Pile In move).</description>
        </rule>
        <rule name="The Vargard&apos;s Duty" id="baa4-97a3-8567-d4eb" hidden="false" publicationId="026a-37f6-pubN68514">
          <description>Vargard Obyron automatically passes the Initiative test required to make a Glorious Intervention.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Artefact: Ghostwalk Mantle" id="e2f9-0254-dc70-ae49" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="minSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="maxSelections" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
          </costs>
          <profiles>
            <profile name="Artefact: Ghostwalk Mantle" id="a959-6980-8ce9-891e" hidden="false" publicationId="026a-37f6-pubN68514" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Once per game, at the start of any friendly Movement phase, Vargard Obyron can use the Ghostwalk Mantle to remove himself and his unit from the table if they are not locked in combat. They then immediately arrive anywhere on the board using the rules for Deep Strike. They will not scatter if attempting to Deep Strike within 12&quot; of Nemesor Zahndrekh (this has no effect if Zahndrekh and Obyron are part of the same unit).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
