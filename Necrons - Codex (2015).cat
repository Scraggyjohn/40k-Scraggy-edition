      <rules>
        <rule name="The Bound Coalescent" id="759d-0eef-5afb-0ffb" hidden="false" publicationId="026a-37f6-pubN68514">
          <description>When a Tesseract Vault uses Powers of the C&apos;tan, measure line of sight and distance from the C&apos;tan itself and resolve the attack at Ballistic Skill 5.</description>
        </rule>
        <rule name="Vengeance of the Enchained" id="b982-3f4c-f351-ed38" hidden="false" publicationId="026a-37f6-pubN68514">
          <description>When a Tesseract Vault loses its last Hull Point, it always suffers a Titanic Explosion! - there is no need to roll on the Catastrophic Damage table.</description>
        </rule>
      </rules>
    </selectionEntry>
