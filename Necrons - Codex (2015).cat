        <profile name="Canoptek Spyder" id="c690-fb33-efdc-ca2d" hidden="false" publicationId="026a-37f6-pubN68514" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
          <characteristics>
