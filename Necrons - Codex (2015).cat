        </entryLink>
        <entryLink name="Obelisk" id="a169-8257-a21d-78a8" collective="false" hidden="false" import="true" targetId="36feb13e-e031-f58c-456a-5cc8bc5ab037" type="selectionEntry">
          <constraints>
