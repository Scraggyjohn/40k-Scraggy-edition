      <profiles>
        <profile name="Necron Monolith" id="9e01a6ed-0437-847c-5332-4c39e428520e" hidden="false" publicationId="026a-37f6-pubN68514" typeId="725a358c-765b-498c-8de5-399fc0c0725f" typeName="Vehicle">
