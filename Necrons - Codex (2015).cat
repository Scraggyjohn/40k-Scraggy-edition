    </profile>
    <profile name="Heavy Gauss Cannon" id="56ce-81b1-4242-7a3e" hidden="false" publicationId="026a-37f6-pubN68514" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
