          <profiles>
            <profile name="Canoptek Wraith" id="0b819258-470e-1f0f-551c-dbcef1d56c10" hidden="false" publicationId="026a-37f6-pubN68514" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
              <characteristics>
