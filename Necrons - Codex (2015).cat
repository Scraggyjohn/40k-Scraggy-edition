      <infoLinks>
        <infoLink name="Move Through Cover" id="4ecb-21bd-091d-499f" hidden="false" targetId="7ecc-bc3d-6e22-63dc" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Target Designated" id="f48a-ee66-b3b7-0852" hidden="false" publicationId="026a-37f6-pubN68514">
          <description>At the start of each of the controlling player&apos;s Shooting phases, nominate one enemy unit within line of sight of a Triarch Stalker from this Formation. All units from this Formation can re-roll failed To Hit, To Wound and armour penetration rolls against the nominated unit until the end of the phase.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Formation: Living Tomb" id="6c08-2f39-7851-96b1" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Monolith" id="4053-ced3-a013-c683" collective="false" hidden="false" import="true" targetId="aefee237-cdf1-6c4d-c8d4-f45ce0a9c486" type="selectionEntry">
