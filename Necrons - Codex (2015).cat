        <rule name="Command Asset Located" id="9bed-939a-7cd8-33fc" hidden="false" publicationId="026a-37f6-pubN89437">
          <description>You can re-roll To Wound rolls of 1 and Armour Penetration rolls of 1 for units from this Formation if the target is an enemy HQ unit.</description>
        </rule>
        <rule name="Energy Transference" id="f6cc-4e02-c8c6-20d1" hidden="false" publicationId="026a-37f6-pubN89437">
          <description>If the Formation is in an Attack Pattern at the start of your turn, pick a single friendly Necron vehicle that is in Reserve. That vehicle can Deep Strike to the battlefield within 6&quot; of the Night Scythe from this Formation and will not scatter. Then roll for any remaining Reserves normally.</description>
        </rule>
      </rules>
    </selectionEntry>
