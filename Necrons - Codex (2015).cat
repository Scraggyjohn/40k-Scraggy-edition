      <profiles>
        <profile name="Vargard Obyron" id="4ec485c9-0633-6af2-2d57-aee56dd569ad" hidden="false" publicationId="026a-37f6-pubN68514" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
          <characteristics>
