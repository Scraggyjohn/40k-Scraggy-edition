          <rules>
            <rule name="Neural Shock" id="6e1bca60-eebf-4fb8-3734-d14676bbc202" hidden="false" publicationId="a7497f68--pubN66307">
              <description>Hits caused by this weapon always wound on a 4+. This special rule has no effects on vehicles or buildings.</description>
            </rule>
          </rules>
        </selectionEntry>
