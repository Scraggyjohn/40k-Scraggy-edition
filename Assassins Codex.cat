          <rules>
            <rule name="Phasing Hits" id="28e70b7e-93f6-9b6e-8cf8-c9aae730ecda" hidden="false" publicationId="a7497f68--pubN66307">
              <description>Each successful To Wound roll of a 6 made by a Phase sword results in a Phasing Wound. Invulnerable saves cannot be taken against Phasing Wounds.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Poison Blades" id="4d4a171a-d572-a868-dfa8-12aeb849da38" collective="false" hidden="false" import="true" type="upgrade">
