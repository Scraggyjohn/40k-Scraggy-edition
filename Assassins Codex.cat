      <profiles>
        <profile name="Eversor Assassin" id="30c1de5d-ef54-98e7-f53f-d840be9d344a" hidden="false" publicationId="a7497f68--pubN66307" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
