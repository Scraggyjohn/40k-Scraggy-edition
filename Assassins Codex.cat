            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">8</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">8</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">4</characteristic>
            <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">4</characteristic>
            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">3</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">7</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">4</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">10</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4++</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Bio-meltdown" id="7fb277f4-d650-0e96-5851-a2881bd6f665" hidden="false" publicationId="a7497f68--pubN66307">
          <description>If an Eversor Assassin is ever reduced to zero Wounds, before removing the model as a casualty, each nearby unit (friend or foe) suffers a Strength 5 AP- hit for each model it has within D6&quot; of the Eversor Assassin. After resolving any additional damage, remove the Eversor Assassin from play as a casualty.</description>
        </rule>
        <rule name="Fast Shot" id="63be1abf-6505-800c-0cc1-af25708bccfb" hidden="false" publicationId="a7497f68--pubN66307">
          <description>Whenever an Eversor Assassin fires his executioner pistol, he does so 4 times. All of these shots must be at the same target, but can be any mixture of bolt pistol and needle pistol shots.</description>
        </rule>
      </rules>
      <selectionEntries>
