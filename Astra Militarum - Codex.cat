    <profile name="Skystrike Missile" id="87883f65-edb5-f503-b659-398e7234fed2" hidden="false" page="269" publicationId="2be8d152--pubN100633" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
