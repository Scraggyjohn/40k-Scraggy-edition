    <profile name="Recovery Gear" id="a134b5db-b9c9-d945-2f6b-47c9fa03d48e" hidden="false" page="0" publicationId="2be8d152--pubN72426" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">If a vehicle with Recovery Gear is Immobilised, then it subsequent turns it may attempt to repair itself. Roll 1D6 at the end of the Movement phase: on a 6 the vehicle is no longer Immobilised. This does not restore HP.</characteristic>
      </characteristics>
    </profile>
    <profile name="Refractor Field" id="f162bd89-3afc-8415-8305-a6ea6c221881" hidden="false" page="0" publicationId="2be8d152--pubN72426" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">5+ Invul Sv</characteristic>
      </characteristics>
    </profile>
    <profile name="Regimental Standard" id="e088b01b-9eb7-7966-bccb-18c265ed1722" hidden="false" page="0" publicationId="2be8d152--pubN72426" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">A unit that contains a model with a platoon standard counts as scoring an additional Wound for the purposes of calculating assault results. In addition, any friendly units from Codex: Astra Militarum within 12&quot; of a model with a regimental standard re-roll failed Morale, Fear and Pinning tests.</characteristic>
      </characteristics>
    </profile>
    <profile name="Relic Plating" id="e77b4872-3c53-9578-0f94-614c2166d1fb" hidden="false" page="0" publicationId="2be8d152--pubN72426" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
