    <profile name="Lasgun" id="96c16e5c-9c96-c572-55b7-bb1737883ba7" hidden="false" page="0" publicationId="2be8d152--pubN72426" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
