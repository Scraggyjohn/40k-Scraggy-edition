        <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">4</characteristic>
        <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">7</characteristic>
        <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">4+</characteristic>
      </characteristics>
    </profile>
    <profile name="Sly Marbo" id="fc05-9bb4-7773-9b2e" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
      <characteristics>
        <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Character)</characteristic>
        <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">5</characteristic>
        <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">5</characteristic>
        <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">3</characteristic>
        <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">3</characteristic>
        <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">2</characteristic>
        <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">5</characteristic>
        <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">4</characteristic>
        <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">7</characteristic>
        <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">5+</characteristic>
      </characteristics>
    </profile>
    <profile name="Envenomed Blade" id="98e7-94e5-fbb4-3263" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">Melee</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Poisoned (2+)</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Twin linked Lasgun" id="ee5b-25d1-b7e0-fdfa" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">24&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">3</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Rapid Fire, Twin-linked</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Bombast Field Gun" id="5f31-9577-c86c-3dc5" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">60&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">7</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Ordnance 1, Barrage, Large Blast</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Heavy Lascannon" id="c3a2-5da4-ca0f-ba90" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">54&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">10</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">2</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Heavy 2</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
    <profile name="Malleus Rocket Launcher" id="b716-75e9-948b-5086" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
        <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">48&quot;</characteristic>
        <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">6</characteristic>
        <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
        <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Ordnance D6, Barrage, Blast</characteristic>
        <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Accidental Detonation" id="d67348b1-da45-e710-d628-5c4eb3dcce53" hidden="false" page="215" publicationId="2be8d152--pubN100633"/>
    <rule name="Accurate Bombardment" id="a328a20e-5867-9cfc-ed82-e8e2468be31b" hidden="false" page="162" publicationId="2be8d152--pubN100633"/>
    <rule name="Adamantium Will" id="f9d2bc2a-a97d-d31a-6248-8c3e5bda2080" hidden="false" page="157" publicationId="2be8d152--pubN229712">
      <description>Model&apos;s unit gets +1 to Deny the Witch.</description>
    </rule>
    <rule name="Advance and Hold" id="0989-0558-1b5c-41f7" hidden="false">
      <description>All infantry units in Battlegroup Hammerblow have the Objective Secured and Stubborn special rules.</description>
    </rule>
    <rule name="Advisors" id="562dd521-72dd-1514-e562-b75e24872113" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Agile" id="e7631a3f-1fbc-f24c-de42-bb7ace11f322" hidden="false" page="5" publicationId="2be8d152--pubN71923"/>
    <rule name="Agile (Super-heavy)" id="a08bff8b-c7f3-5c2d-0516-2e866112b074" hidden="false" page="6" publicationId="2be8d152--pubN99523"/>
    <rule name="Air-to-air" id="356bf697-6389-998c-b7a5-11d7ebe638ac" hidden="false" page="5" publicationId="2be8d152--pubN71923"/>
    <rule name="Airborne Assault" id="9eae1363-f11b-7fa2-8f81-7c0bc2ffc616" hidden="false" page="46" publicationId="2be8d152--pubN77996"/>
    <rule name="All Guns Blazing" id="0add4f9e-d9c0-f899-eb00-8258ba611a1e" hidden="false" page="274" publicationId="2be8d152--pubN100633"/>
    <rule name="All Power to the Weapons!" id="6c8a768e-73a3-e73d-4753-f7af372ac84d" hidden="false" page="13" publicationId="2be8d152--pubN100814"/>
    <rule name="All-terrain APC" id="6b435d5f-37f3-15e8-5128-736b7f5683a6" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>Re-roll Dangerous Terrain</description>
    </rule>
    <rule name="All-terrain Vehicle" id="0ae2ef65-ea95-d87d-4a42-28ceb33f30b4" hidden="false" page="229" publicationId="2be8d152--pubN100633"/>
    <rule name="Ambush Patrol" id="947fb572-14be-1c99-28db-8e2c082404d8" hidden="false" page="13" publicationId="2be8d152--pubN229895"/>
    <rule name="Ammunition Stowage" id="8b282160-f9ce-53dc-2c06-c35412ac5eb9" hidden="false" page="56" publicationId="2be8d152--pubN202674"/>
    <rule name="Amphibious" id="c3c24c87-92a7-d6ee-ba91-d2e122d95920" hidden="false" page="40" publicationId="2be8d152--pubN72426">
      <description>All water terrain is open ground.</description>
    </rule>
    <rule name="And They Shall Know No Fear" id="44e0993d-4c19-297a-837a-869e17e25c12" hidden="false" page="157" publicationId="2be8d152--pubN229712"/>
    <rule name="Apocalyptic Barrage" id="5317607a-3f17-ac41-76bc-3552cd4db4a2" hidden="false" page="0" publicationId="2be8d152--pubN71923"/>
    <rule name="Armoured Gate" id="f119cda4-ee74-54b4-befa-50a391b20807" hidden="false" page="41" publicationId="2be8d152--pubN99523"/>
    <rule name="Armoured Spearheads" id="b2d275ff-2ffa-10da-fc14-7b25cdf68204" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Artillery Bombardment" id="7e129f9f-7ace-4d29-45d5-2791e000a4a7" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>The Master of Ordnance may make a shooting attack: Infinite Range, S9, AP3, Ordnance 1, Barrage, Large Blast.  If scatter die rolls hit, scatter 2D6&quot; anyway.  scatter 3D6&quot; if an arrow rolls.  Reduce scatter by BS if within LoS.</description>
    </rule>
    <rule name="Artillery Command" id="9867-10ad-3c79-85d9" hidden="false" page="158" publicationId="2be8d152--pubN73328">
      <description>The Company Commander from this Formation can issue the &apos;Smite at Will!&apos;, &apos;Suppressive Fire!&apos; and &apos;Fire on my Target!&apos; orders to units of vehicles from this Formation. Units of vehicles from this Formation count as having a Leadership characteristic of 8 for the purposes of seeing whether the order has been understood.</description>
    </rule>
    <rule name="Artillery Tractor" id="49db581d-f4cf-5484-7557-33cb73cdeba6" hidden="false" page="75" publicationId="2be8d152--pubN100633"/>
    <rule name="Assault Vehicle" id="195844c7-cf06-1e67-20dd-b119514ee0c9" hidden="false" page="157" publicationId="2be8d152--pubN229712">
      <description>Disembarking passengers may charge.</description>
    </rule>
    <rule name="Aura of Discipline" id="0a31b24f-a0eb-5320-5252-63f4c38569e9" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>Any friendly Codex: Astra Militarum unit within 6&quot; uses his Leadership for Pinning, Morale, and Fear tests.</description>
    </rule>
    <rule name="Auto-targeting" id="2df4c82f-a131-4460-f090-e74a510707fa" hidden="false" page="5" publicationId="2be8d152--pubN71923"/>
    <rule name="Automated Artillery" id="d1a63c74-2105-d623-3c11-5f70f6042e15" hidden="false" page="5" publicationId="2be8d152--pubN71923"/>
    <rule name="Awaken the Machine" id="7e8a1d81-6c13-e9f7-639d-f244743d51e8" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>May give a single friendly Astra Militarium vehicle within 12&quot; Power of the Machine Spirit until end of turn.</description>
    </rule>
    <rule name="Baneblade Difficult Terrain" id="76c84a18-93d6-3bcc-a380-e8f3503cc7a8" hidden="false" page="90" publicationId="2be8d152--pubN100633"/>
    <rule name="Baneblade Ordnance" id="64cb52de-1127-254c-17db-888da5c6e24c" hidden="false" page="90" publicationId="2be8d152--pubN100633"/>
    <rule name="Baneblade Tank Shock" id="74db9595-8f92-8934-a0f2-942d59916331" hidden="false" page="90" publicationId="2be8d152--pubN100633"/>
    <rule name="Barrage Patterns" id="3d12c629-759b-db9d-5f0c-2b135c889d34" hidden="false" page="45" publicationId="2be8d152--pubN99523"/>
    <rule name="Battery Fire" id="940e0c09-8dab-360d-7fae-d30c02b05668" hidden="false" page="52" publicationId="2be8d152--pubN202674"/>
    <rule name="Battle Group Vox-net" id="30ba-9d4a-0253-e5c4" hidden="false" page="168" publicationId="2be8d152--pubN73328">
      <description>When an officer from this Detachment issues an order to a unit from this Detachment, roll an additional dice for the Leadership test and discard the highest roll.</description>
    </rule>
    <rule name="Battlefield Doctrines" id="d2cb-04d9-b969-d8f5" hidden="false" page="159" publicationId="2be8d152--pubN73328">
      <description>If a vehicle from this Formation that is within 6&quot; of an Enginseer from this Formation suffers a penetrating hit, your opponent must roll two dice on the Vehicle Damage table and discard the highest.</description>
    </rule>
    <rule name="Behind Enemy Lines" id="0a090012-f12d-cd74-02ba-be2bf569ed79" hidden="false" page="46" publicationId="2be8d152--pubN77996"/>
    <rule name="Blazing Weapons" id="22156b8f-7433-3c5b-b5cc-057539a22b0e" hidden="false" page="0" publicationId="2be8d152--pubN230287"/>
    <rule name="Blessings of the Omnissiah" id="15c94625-405c-6b67-5cdb-0fdceae5c11b" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>Instead of shooting, may repair a friendly vehicle embarked or in base contact.  Need 5+, adding +1 for each Servitor with servo-arm in unit. Success restores hull point, or repairs destroyed weapon, or repairs Immobilised.</description>
    </rule>
    <rule name="Blind" id="2c8f402b-390f-51d2-56de-0ece624f7228" hidden="false" page="159" publicationId="2be8d152--pubN229712">
      <description>Hit units test Initiative at end of phase. Failure reduces Weapon and Ballistic skills to 1 until end of next turn.  Units cannot blind themselves nor anything without Initiative.</description>
    </rule>
    <rule name="Born in the Saddle" id="28229793-5a76-65af-2656-afba3c979585" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>All Rough Rider units within 12&quot; of the Rough Rider Command Squad have the Skilled Rider rule.</description>
    </rule>
    <rule name="Broad Spectrum Camouflage" id="5c2de08f-f776-f604-3ef8-7bf32346626b" hidden="false" page="55" publicationId="2be8d152--pubN202674"/>
    <rule name="Brotherhood of Psykers" id="d2c5a26e-bba9-1699-76e4-0bea6bcdaeb6" hidden="false" page="159" publicationId="2be8d152--pubN229712">
      <description>Model&apos;s unit is Psyker with Mastery Level 1. Manifest from any one model with rule. Hits from Perils or anty-Psyker weapons are randomly allocated.</description>
    </rule>
    <rule name="Bulky" id="32b0b507-82e7-5304-1a9c-b69fb2f5ae98" hidden="false" page="159" publicationId="2be8d152--pubN229712">
      <description>Occupies double Transport Capacity</description>
    </rule>
    <rule name="Camouflage" id="d5dcc13b-10ee-d6ca-e6ef-6b324bdb737e" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Careful Planner" id="eeda8380-ed1d-56ad-06a3-8a36e9b99a6d" hidden="false" page="77" publicationId="2be8d152--pubN126697"/>
    <rule name="Cavalry" id="9c49a9ac-b424-8a55-e98d-025bdd01c169" hidden="false" page="67" publicationId="2be8d152--pubN229712">
      <description>Can move 12&quot; and treats difficult terrain as dangerous instead.  Falls back 3D6&quot;. Also has Fleet and Hammer of Wrath.</description>
    </rule>
    <rule name="Chain of Command" id="9e8aba5a-82c9-d51c-4be3-ed88779b7114" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>May only be Warlord if no other Senior Officers.</description>
    </rule>
    <rule name="Clarion Vox-net" id="37b87a40-ea3b-1668-9f82-f5c017f1fccf" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>Friendly units within 18&quot; may use this model&apos;s Leadership for Pinning, Morale, and Fear.</description>
    </rule>
    <rule name="Clear the Area" id="78f1-65d7-84d0-d8c4" hidden="false" page="157" publicationId="2be8d152--pubN73328">
      <description>Units from an Assault Company have the Preferred Enemy special rule against enemy units within 6&quot; of an Objective Marker.</description>
    </rule>
    <rule name="Close-ranged Fire Support" id="65b9-2404-35f6-42d1" hidden="false">
      <description>All weapons fired by Battlegroup Hammerblow&apos;s Baneblade and Leman Russ Squadron have the twin-linked special rule so long as the target is within 12&quot; of another unit from this formation.</description>
    </rule>
    <rule name="Cold Steel and Courage" id="bb35c863-d804-4c8d-8042-21b78bb12f4f" hidden="false" page="57" publicationId="2be8d152--pubN72426"/>
    <rule name="Combined Fire" id="2dacfb58-680a-82ea-1399-b4ecc9cd3f07" hidden="false" page="0" publicationId="2be8d152--pubN230555">
      <description>See datasheet</description>
    </rule>
    <rule name="Combined Squad" id="89354426-c301-fbb1-128f-0916ee8f04bf" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>May combine Infantry Squads just before rolling for Warlord Traits.</description>
    </rule>
    <rule name="Command Sentinel" id="64580817-2ec1-a897-f9cd-9b1fcbf2f486" hidden="false" page="0" publicationId="2be8d152--pubN230593"/>
    <rule name="Command Tank" id="e53371b7-8995-9e57-6b79-6f46c13125cc" hidden="false" page="6" publicationId="2be8d152--pubN99523"/>
    <rule name="Command Valkyrie" id="9b1ba8a0-8c6c-9a93-6edb-8b2a01fc10c4" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>All friendly Valkyries, Vendettas &amp; Vultures within 24&quot; of Steel Eagle may re-roll Immobilised results on the Damage tables.</description>
    </rule>
    <rule name="Commissariat Crew" id="36088b48-f782-c692-bb97-aedac2786e2a" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Company Command" id="7ccf-205f-4b7a-a1f0" hidden="false" page="156" publicationId="2be8d152--pubN73328">
      <description>One Scout Sentinel or Armoured Sentinel in this Formation must be designated the Command Sentinel. That model gains the Character unit type, and can issue the &apos;Take Aim!&apos;, &apos;Forwards, for the Emperor!&apos; or &apos;Move! Move! Move!&apos; order to a unit in its Formation as though it were an officer. Units from this Formation count as having a Leadership characteristic of 8 for the purposes of the test to see if the order has been understood.</description>
    </rule>
    <rule name="Containment Failure" id="8fce20c7-4989-1f17-1aee-8605459d2a61" hidden="false" page="0" publicationId="2be8d152--pubN230679"/>
    <rule name="Counter Attack" id="e7475b53-675c-ec02-256d-d2aa6a3d5e55" hidden="false" page="163" publicationId="2be8d152--pubN229712">
      <description>Unless already locked in combat, model&apos;s unit gets +1 Attack when charged by an enemy.</description>
    </rule>
    <rule name="Covering Fire" id="d10f7545-14e8-f6d5-c67f-3d3b3b26e578" hidden="false" page="58" publicationId="2be8d152--pubN202674"/>
    <rule name="Crack Shot" id="0bff9538-543f-23e6-b715-6e7283ec7251" hidden="false" page="59" publicationId="2be8d152--pubN72426">
      <description>Can re-roll armor penetration. Also bonuses for weapons:
* Battle Cannon, Vanquisher, Demolisher, Eradicator: re-roll To Hit
* Exterminator or Punisher: Rending
* Executioner: may fire 36&quot; S7 AP2 Heavy 1, Large Blast, Blind, Gets Hot</description>
    </rule>
    <rule name="Crossfire" id="a6f9dd83-74db-05b4-191b-da4eab02e2a6" hidden="false" page="58" publicationId="2be8d152--pubN202674"/>
    <rule name="Deadly Riposte" id="6af0-0f9c-1633-cea6" hidden="false" page="167" publicationId="2be8d152--pubN73328">
      <description>When fighting in a challenge, a model wielding Celeritas has an invulnerable save of 4+. For each successful save made by the model during a challenge, it can immediately make an attack with Celeritas that hits automatically and has the Rending special rule, even if the model is slain as the result of failing other saves at the same time.</description>
    </rule>
    <rule name="Death from Above" id="8d3d70a2-2e93-e765-57e2-d24931fc87be" hidden="false" page="49" publicationId="2be8d152--pubN99523"/>
    <rule name="Deathstrike Vortex Missile" id="4e6e4c43-6df1-cadc-2b42-589d9b0e31f6" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>One use, indirect only. 
After determining the final position of the marker, any models and removable terrain touched by the blast are removed from the game (flyers are unaffected).
No saves or special saving rules of any type.
Gargantuan Creatures automatically lose D6 Wounds.
Super Heavy vehicles automatically lose D3 Structure Points.

After the initial damge is resolved, the vortex partially collapses. Replace the 10&quot; marker with the 3&quot;.
At the beginning of every following player turn (both sides) the vortex scatters 2D6&quot;. After determining the final position of the marker, resolve damage as above. If a double is rolled for the distance, remove the vortex instead.</description>
    </rule>
    <rule name="Dedicated Hunters" id="0848b56e-5107-5806-dd4e-4a01c7409607" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Dedicated Hunters*" id="6844-6ef1-8124-47ed" hidden="false" page="156" publicationId="2be8d152--pubN73328">
      <description>At the start of your first turn, pick a unit in the enemy army. All models in this Recon Company have the Preferred Enemy special rule against that unit for the remainder of the game.</description>
    </rule>
    <rule name="Dedicated Servant" id="2aab-7cc1-79d2-fa84" hidden="false" page="162" publicationId="2be8d152--pubN73328">
      <description>When the Enginseer from this Formation uses the Blessings of the Omnissiah rule to repair a vehicle from this Formation, add 2 to the result of the roll.</description>
    </rule>
    <rule name="Deep Strike" id="90311584-d42b-5056-1554-0c859a6db9ab" hidden="false" page="162" publicationId="2be8d152--pubN229712"/>
    <rule name="Defend to the Last Man" id="96b85194-4fb3-4d6e-7a5c-c5befb75b046" hidden="false" page="41" publicationId="2be8d152--pubN99523"/>
    <rule name="Defending Battle Force" id="75f46c65-7f3d-f7a2-0075-2cbdf9092ce1" hidden="true" publicationId="2be8d152--pubN230905"/>
    <rule name="Defensive Strategy" id="979d1cc0-9ed5-22e8-101c-802e25393947" hidden="true" publicationId="2be8d152--pubN230905"/>
    <rule name="Deflagrate" id="8c5c0d06-bca1-f489-c754-67c455d757a0" hidden="false" publicationId="2be8d152--pubN189262"/>
    <rule name="Desert Raider" id="e29a404d-d388-794a-fb64-ae5a5fde2836" hidden="false" page="64" publicationId="2be8d152--pubN77996"/>
    <rule name="Devastating Bombardment" id="c187-edec-4d53-636d" hidden="false" page="161" publicationId="2be8d152--pubN73328">
      <description>If an enemy unit is hit by 3 or more Primary weapons from this Formation, it must take a Morale check on 4D6 unless it has Gone to Ground.</description>
    </rule>
    <rule name="Direct Support" id="d4517c60-5902-2c2f-74f9-7ed612a60649" hidden="false" page="49" publicationId="2be8d152--pubN230985"/>
    <rule name="Divert Power" id="26c97ea1-be1a-3bdf-dfb9-bd626f97668c" hidden="false" page="0" publicationId="2be8d152--pubN156636"/>
    <rule name="Divine Protection" id="5cde5c68-b95a-abf8-1343-ad8c0c63efb2" hidden="false" page="0" publicationId="2be8d152--pubN230287"/>
    <rule name="Doctrine: Demolitions" id="853955a3-6b4d-743b-5c67-a9e86bd6e295" hidden="false" page="38" publicationId="2be8d152--pubN72426"/>
    <rule name="Doctrine: Forward Sentries" id="eccbda38-3d4f-43ff-4938-b8668e55849d" hidden="false" page="38" publicationId="2be8d152--pubN72426"/>
    <rule name="Doctrine: Grenadiers" id="52ac96c9-3b23-35e1-3fa3-68364b91cd80" hidden="false" page="38" publicationId="2be8d152--pubN72426">
      <description>4+ carapace armour</description>
    </rule>
    <rule name="Earthshock" id="7296e297-c708-e05d-45d1-f9a9c98cc4d3" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Elite Tank Crews" id="f4ece9d0-ad9b-56ce-51e8-6838108f198c" hidden="false" publicationId="2be8d152--pubN177988"/>
    <rule name="Empyric Link" id="a5e7-0cab-6b41-a822" hidden="false" page="161" publicationId="2be8d152--pubN73328">
      <description>The Primaris Psyker knows any Psychic Powers known by units of Wyrdvane Psykers from the same Division while they are within 12&quot;. In addition, add 1 to the Primaris Psyker&apos;s Mastery Level until the end of the Psychic phase for every 5 Wyrdvane Psykers from the same Division that are within 12&quot; at the start of the phase. Note that this does not cause him to generate any additional powers.</description>
    </rule>
    <rule name="Encouraging Presence" id="2683-fd49-9d00-6a14" hidden="false" page="161" publicationId="2be8d152--pubN73328">
      <description>While a unit of Wyrdvane Psykers from this Formation is joined by a Commissar from this Formation, it successfully harnesses Warp Charge points on a roll of 2+ rather than 4+. However, if it attempts to manifest a Psychic Power and fails its psychic test, one randomly determined Wyrdvane Psyker from the unit is removed as a casualty. Furthermore, if it suffers Perils of the Warp, one randomly determined Wyrdvane Psyker from the unit is removed as a casualty and no roll is made on the Perils of the Warp table.</description>
    </rule>
    <rule name="Endless Ranks" id="a8599301-b0b6-e9a3-5814-d7ea41a7603d" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Engine Damage" id="1cd1806f-3b3e-a936-39a6-e36450f39efa" hidden="false" page="6" publicationId="2be8d152--pubN99523"/>
    <rule name="Eternal Warrior" id="5c931240-087a-3624-74d9-41572b0c32fd" hidden="false" page="163" publicationId="2be8d152--pubN229712">
      <description>Not affected by Instant Death</description>
    </rule>
    <rule name="Explosive Demise" id="3d07f624-4f87-3389-b892-f6fd53515138" hidden="false" page="206" publicationId="2be8d152--pubN100633"/>
    <rule name="Extremely Bulky (Cyclops) (Rapier &amp; Crew)" id="695c6e4d-b798-6881-19c5-f0f48fb554bf" hidden="false" page="159" publicationId="2be8d152--pubN229712"/>
    <rule name="Fear" id="179e20b2-b985-74fe-b514-8f6da2e8dea3" hidden="false" page="163" publicationId="2be8d152--pubN229712">
      <description>Unit in base contact must pass Fear test at beginning of each Fight sub-phase or fight at Weapon Skill 1.</description>
    </rule>
    <rule name="Fearless" id="92e3a95b-9df5-a19f-4932-3a0650a8daf2" hidden="false" page="163" publicationId="2be8d152--pubN229712">
      <description>Automatically pass Morale, Regroup, Pinning, and Fear. Cannot Go to Ground or use Our Weapons Are Useless. Cancels Go to Ground.</description>
    </rule>
    <rule name="Fearless (Cyclops)" id="f7db5947-1984-071a-df32-d0b0ff31c747" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Feedback" id="1179ef63-efd4-051e-89a3-3e8dee31b019" hidden="false" page="135" publicationId="2be8d152--pubN99523"/>
    <rule name="Feel No Pain" id="1a39557d-f118-167d-1363-0d5ceefa789f" hidden="false" page="164" publicationId="2be8d152--pubN229712">
      <description>Extra roll after saving throw, 5+++ if not specified. No use against Instant Death or Destroyer attacks.</description>
    </rule>
    <rule name="Fighter Ace" id="0659c2f0-2ade-4c75-631f-ff484780df39" hidden="false" page="44" publicationId="2be8d152--pubN126112"/>
    <rule name="Fighting Men of the Imperium" id="6fb74456-74dd-0616-15d5-6579160b221e" hidden="false" page="10" publicationId="2be8d152--pubN229895"/>
    <rule name="Finest Hour: Hero of Hades Hive" id="7dbc8e48-ca3b-a100-d139-7b4a58b096c4" hidden="true" page="0" publicationId="2be8d152--pubN231357"/>
    <rule name="Fire Control" id="6327d668-fc02-029d-d2a7-35457506ff6e" hidden="false" page="22" publicationId="2be8d152--pubN231373"/>
    <rule name="Fire Modes - Point Defence, Sentry, Interceptor" id="db8ad088-19ef-797a-f780-f789a285c39f" hidden="false" page="201" publicationId="2be8d152--pubN100633"/>
    <rule name="Fire of Xerxes" id="5de426d2-f427-42b9-c7d9-3dd7fed0617a" hidden="false" page="56" publicationId="2be8d152--pubN202674"/>
    <rule name="First Charge" id="af3d4111-3268-27d1-8a5d-b6aaeb41610e" hidden="false" page="44" publicationId="2be8d152--pubN77996"/>
    <rule name="Flank Speed" id="9b99994b-6dff-a564-e70c-bedb9c5e3124" hidden="false" page="0" publicationId="2be8d152--pubN189615"/>
    <rule name="Fleet" id="6d6b6e2d-9882-c696-8782-074c00a5f2e0" hidden="false" page="164" publicationId="2be8d152--pubN229712">
      <description>Re-roll any dice for Run and Charge moves.</description>
    </rule>
    <rule name="Fleshbane/Poisoned" id="b6168ee9-fcfd-3432-578b-fecd68533042" hidden="false" page="61" publicationId="2be8d152--pubN77996"/>
    <rule name="Follow-up Attack" id="7b4f6ee6-9c36-130f-9aec-5e9ff7b77fb5" hidden="false" page="209" publicationId="2be8d152--pubN100633"/>
    <rule name="Formation Flight" id="17bc-6d97-9bfe-a77e" hidden="false" page="163" publicationId="2be8d152--pubN73328">
      <description>If a Reserves Roll for a unit from this Formation is successful, you can choose to automatically pass any remaining Reserves Rolls for units from this Aerial Company in the same turn.</description>
    </rule>
    <rule name="Formation Leader" id="0e3f3389-5652-a7e7-f548-34b925b7ec2f" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Formation Leader*" id="3399-fbfe-e82b-7b28" hidden="false" page="159" publicationId="2be8d152--pubN231539">
      <description>Any Leman Russ from this Formation within 12&quot; of the Tank Commander from this Formation has a Ballistic Skill of 4.</description>
    </rule>
    <rule name="Fortified Battlements" id="7a6526c9-ad16-a6ec-1906-d3e198e2fb13" hidden="false" page="41" publicationId="2be8d152--pubN99523"/>
    <rule name="Forward Deployment" id="9c214c02-737f-647b-c4dc-0d62023ca3a9" hidden="false" page="22" publicationId="2be8d152--pubN231373"/>
    <rule name="Forward Recon" id="7c7d7928-ae8a-2264-9f4b-8c506f9fe4b9" hidden="false" page="17" publicationId="2be8d152--pubN231590"/>
    <rule name="Forward Recon*" id="0595-d21e-de5e-8cfe" hidden="false" page="154" publicationId="2be8d152--pubN73328">
      <description>Units from this Formation&apos;s Infantry Platoon have the Move Through Cover special rule whilst they are within 9&quot; of a Scout Sentinel or Armoured Sentinel from this Formation.</description>
    </rule>
    <rule name="Forward, You Dogs!" id="dcd4c468-2d22-746b-1667-1af8887bcd48" hidden="false" page="65" publicationId="2be8d152--pubN77996"/>
    <rule name="Fuelled and Ready to Launch" id="8cc6808e-916c-0e7c-f42a-315fc6b38966" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>Add +2 dice to the roll when determining if you can launch.</description>
    </rule>
    <rule name="Fully Automated" id="ebc5a0a0-b1ff-0523-b9df-93e2950c6a92" hidden="false" page="0" publicationId="2be8d152--pubN230679"/>
    <rule name="Furious Charge" id="efc0f034-c92b-3279-9ccd-413c8bd50609" hidden="false" page="164" publicationId="2be8d152--pubN229712">
      <description>+1 Strength after charge (unless disordered)</description>
    </rule>
    <rule name="Galvanic Motor" id="7f163a5b-c216-29cf-f882-b35e7fe5b918" hidden="false" page="229" publicationId="2be8d152--pubN100633"/>
    <rule name="Grand Strategist" id="1b4c8af0-2513-97e7-ad15-243e1eb1c523" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>D3 units in your army gain Outflank.</description>
    </rule>
    <rule name="Grav Chute Insertion" id="471b5c19-fb46-88a7-ed37-d48bcff86e1b" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>Passengers may disembark as if Deep Striking even after vehicle moves more than 6&quot;. Roll scatter from point under vehicle&apos;s movement.  Scatter causes dangerous terrain test.</description>
    </rule>
    <rule name="Groundshaking Charge" id="fc99-3570-8706-54b4" hidden="false" page="160" publicationId="2be8d152--pubN73328">
      <description>If a unit of Ogryns or Bullgryns from this Formation charges an enemy unit that has already been charged by a unit of Ogryns or Bullgryns from this Formation in the same Assault phase, their Hammer of Wrath hits are resolved at Strength 7.</description>
    </rule>
    <rule name="Guerilla Warfare" id="0b0e22ab-2952-885f-d05a-3c2203609f7f" hidden="false" page="13" publicationId="2be8d152--pubN229895"/>
    <rule name="Gun Carriage" id="d2937f8a-fa05-d47e-5ebe-b948f79d8337" hidden="false" page="188" publicationId="2be8d152--pubN100633"/>
    <rule name="Gun Deployment" id="9e41ef09-e804-34d1-655f-8282005c9f6b" hidden="false" page="75" publicationId="2be8d152--pubN100633"/>
    <rule name="Gung-ho" id="228edcf3-afaf-8f79-0eb9-6190a02a6a4d" hidden="false" page="57" publicationId="2be8d152--pubN72426">
      <description>Must always issue and accept challenges.</description>
    </rule>
    <rule name="Hail of Fire" id="670d6ea0-fd24-942e-0c0c-35c63a985f14" hidden="false" page="26" publicationId="2be8d152--pubN231373"/>
    <rule name="Hammer of the Greenskins" id="133040ac-13fe-42e6-e66e-231fdc889328" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Hammer of Wrath" id="4f3e5d21-7348-f25b-ae11-dddb6da51267" hidden="false" page="165" publicationId="2be8d152--pubN229712">
      <description>Additional attack at Initiative 10 automatically hits at unmodified Strength and no Armour Piercing without any special rules.</description>
    </rule>
    <rule name="Hardened Crew" id="2387bca9-ebf3-2521-0e0f-7dcadb8a4c7f" hidden="false" page="272" publicationId="2be8d152--pubN100633"/>
    <rule name="Hatred" id="44425a9e-5444-8b0f-6819-2977c1462575" hidden="false" page="165" publicationId="2be8d152--pubN229712">
      <description>In first round of each close combat, re-roll failed To Hit against hated enemies.</description>
    </rule>
    <rule name="Heat Seeker" id="89e6cbe2-8b68-b1cf-c1cf-1b6741bf8309" hidden="false" page="5" publicationId="2be8d152--pubN71923"/>
    <rule name="Heavy Vehicle" id="b1769cfc-4434-03fe-0dff-28d2a80c8f8d" hidden="false" page="88" publicationId="2be8d152--pubN229712">
      <description>Cannot move faster than Combat Speed nor Flat Out. Always counts as stationary for shooting.</description>
    </rule>
    <rule name="Heroic Sacrifice" id="932b561c-1507-9977-289d-2869434a5a90" hidden="false" page="58" publicationId="2be8d152--pubN72426"/>
    <rule name="High Command" id="fcb15db1-38c6-7fb7-7d1a-cefda4607259" hidden="false" page="9" publicationId="2be8d152--pubN229895"/>
    <rule name="High Command" id="2630-b0b1-5afe-d049" hidden="false" page="168" publicationId="2be8d152--pubN73328">
      <description>A Company Commander that is part of a Battle Group Command can issue up to three orders each turn, rather than two, and can issue them to units from this Detachment that are within 24&quot; rather than 12”.</description>
    </rule>
    <rule name="Highly Volatile" id="5f6ba753-cfb4-8892-3c87-0a3e7f1abd9e" hidden="false" page="52" publicationId="2be8d152--pubN202674"/>
    <rule name="Hit and Run" id="defb89bb-4557-e9ae-c22a-4a017c2dad09" hidden="false" page="165" publicationId="2be8d152--pubN229712"/>
    <rule name="Hold At All Costs" id="5508d8e5-cb36-9d9c-d21a-56e617a864fd" hidden="false" page="0" publicationId="2be8d152--pubN156636"/>
    <rule name="Icon of Victory" id="c20a8161-6f70-dc6d-07b9-35a5ceac560b" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Ideal Mission Commander" id="852d2433-a276-7db9-d635-062c2691cb3e" hidden="true" publicationId="2be8d152--pubN174596"/>
    <rule name="Immobile" id="721b6bb8-6e4a-46a7-25e3-a9f9fe9c86d8" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Impenetrable Shield Wall" id="a7753983-2b4a-12e3-fdfb-a7c3f2c97ac4" hidden="false" publicationId="2be8d152--pubN177988"/>
    <rule name="Imperial Guard Orders" id="773d272a-412a-8190-5cc4-1138def978d0" hidden="false" page="29" publicationId="2be8d152--pubN77996"/>
    <rule name="Improvised Weapon Mount" id="e4de7bdf-262b-38c4-3d69-e7e5beaa7126" hidden="false" page="19" publicationId="2be8d152--pubN71923"/>
    <rule name="Independent Character" id="3a63aad4-b9a1-cdfa-0e6b-4a4a7351b77e" hidden="false" page="166" publicationId="2be8d152--pubN229712"/>
    <rule name="Indirect Fire" id="3aa5a5a7-901a-6428-a35e-f9e377b5dbdc" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Infiltrate" id="8f03a73f-941b-7192-f932-ebc4a5192379" hidden="false" page="167" publicationId="2be8d152--pubN229712"/>
    <rule name="Inspirational Hero" id="c1c85f22-b651-c32e-1994-d1e4ade4e30b" hidden="false" page="63" publicationId="2be8d152--pubN77996"/>
    <rule name="Inspired Tactics" id="33b0122e-52c1-139d-bf8a-c9394d7e566c" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>If ordered unit rolls double 1 for Leadership, all orders automatically succeed for the rest of this turn.</description>
    </rule>
    <rule name="Interceptor" id="049f2c72-cf5d-6968-af00-7883c98e3024" hidden="false" page="167" publicationId="2be8d152--pubN232232">
      <description>May fire at enemies that arrived from Reserves at end of their movement phase. Cannot shoot same weapon during next turn.</description>
    </rule>
    <rule name="Invading Battle Force" id="596d8220-53fd-c63e-e0fc-d67cf1cf8977" hidden="true" publicationId="2be8d152--pubN230905"/>
    <rule name="Invincible Behemoth" id="e4675f80-82d0-040f-4569-d027a34d5fed" hidden="false" page="66" publicationId="2be8d152--pubN100814"/>
    <rule name="Iron Will" id="90f0117c-24c9-70a8-374e-d27ea669fbe5" hidden="false" page="55" publicationId="2be8d152--pubN72426"/>
    <rule name="It&apos;s for Your Own Good" id="3dd4132d-b896-3c95-4991-eb7da48869d3" hidden="false" page="0" publicationId="2be8d152--pubN72426">
      <description>Commissar executes Pyskers who suffer Perils of the Warp (after resolving its effects).</description>
    </rule>
    <rule name="It&apos;s Up to us, Lads" id="e83186ba-ddf3-fa87-f0f7-1affd65008bd" hidden="false" page="59" publicationId="2be8d152--pubN77996"/>
    <rule name="Khanasan&apos;s Fiercest" id="b25b3beb-16be-d49d-6411-ba035993210f" hidden="false" page="66" publicationId="2be8d152--pubN77996"/>
    <rule name="Leman Russ Commander" id="70cb523e-899c-582a-8d29-16b6f78749cc" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Leman Russ Tank Ace" id="e7be22f8-a805-c37d-d2b7-f23113460f8b" hidden="false" page="58" publicationId="2be8d152--pubN77996"/>
    <rule name="Like the Wind" id="282e6769-36a1-d5e8-dde1-e33bdb283d3e" hidden="false" page="64" publicationId="2be8d152--pubN77996"/>
    <rule name="Limited Ammunition" id="2d3e1ecf-c262-51da-a463-186c61917061" hidden="false" page="52" publicationId="2be8d152--pubN72426">
      <description>Carries only four rockets and each is a separate weapon that may be destroyed.</description>
    </rule>
    <rule name="Listen Up, Maggots!" id="832b4532-13ef-6698-57d7-48aeaca073ff" hidden="false" page="56" publicationId="2be8d152--pubN72426"/>
    <rule name="Look Out - Arghh!" id="601cb1a4-14d8-0ad1-5a81-85e5496cad57" hidden="false" page="56" publicationId="2be8d152--pubN72426"/>
    <rule name="Low Altitude Drop" id="fe85-d8ec-e6c0-30d8" hidden="false" page="163" publicationId="2be8d152--pubN73328">
      <description>At the start of your Movement phase, you can declare that a unit from this Formation will enact a low altitude drop. If it does so it must take a difficult terrain test each time it moves over terrain that is more than 3&quot; tall during this phase, and cannot Jink until your next Movement phase. However, until the end of the phase, units that disembark from models making a low altitude drop using the Grav Chute Insertion special rule do not scatter.</description>
    </rule>
    <rule name="Loyal to the End" id="a6ea1e33-d34a-6741-7924-578122771d6f" hidden="false" page="58" publicationId="2be8d152--pubN72426"/>
    <rule name="Lumbering Behemoth" id="7f43f670-7c3c-e3fe-1aad-bf920a982494" hidden="false" page="48" publicationId="2be8d152--pubN77996"/>
    <rule name="Machine Destroyer" id="baa9a165-bb2b-ce81-cbd8-8d3de8bef03b" hidden="false" publicationId="2be8d152--pubN188177"/>
    <rule name="Marching Drill" id="807c-6024-00a1-dadd" hidden="false" page="154" publicationId="2be8d152--pubN73328">
      <description>The Platoon Commander can issue the &apos;Fire and Advance!&apos; order to one unit from its Infantry Platoon, in addition to any other orders it issues.</description>
    </rule>
    <rule name="Massive Fortification" id="6409589d-c23b-3ca8-93ce-31cfdee2797e" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Masters of Strategy" id="524ba3fa-23e3-1a49-9969-2b3d108ab6a9" hidden="false" page="9" publicationId="2be8d152--pubN229895"/>
    <rule name="Melta-cutter Drill" id="52d17472-9d90-5058-0fc4-d375345c1581" hidden="false" page="209" publicationId="2be8d152--pubN100633"/>
    <rule name="Meltdown" id="4ccabaa3-7065-2d1b-aa35-9ed1e1dddeb7" hidden="false" page="135" publicationId="2be8d152--pubN99523"/>
    <rule name="Mindlock" id="18e6cadf-1688-ab8c-858b-cd4cee924d5d" hidden="false" page="35" publicationId="2be8d152--pubN72426"/>
    <rule name="Mobile Command Vehicle" id="3421c351-9fc2-119d-883e-52ce70d26e59" hidden="false" page="40" publicationId="2be8d152--pubN72426"/>
    <rule name="Monster Hunter" id="be032c0b-31b0-03c7-8684-a4b645951889" hidden="false" page="168" publicationId="2be8d152--pubN229712">
      <description>Re-roll To Wound against Monstrous Creatures.</description>
    </rule>
    <rule name="Move Through Cover" id="16f1ecd6-226c-37d6-8990-b0112bb8330a" hidden="false" page="168" publicationId="2be8d152--pubN229712">
      <description>Roll extra D6 for difficult terrain. Automatically pass Dangerous Terrain.</description>
    </rule>
    <rule name="Mukaali Mounts" id="f4d99bb9-5a04-1fe7-25d9-2181bf50e55f" hidden="false" page="226" publicationId="2be8d152--pubN164097">
      <description>All Hammer of Wrath attacks inflicted by Mukaali riders are resolved at S5, Ap-
Mukaali roll only 2D6 for any Fall Back moves they make</description>
    </rule>
    <rule name="Munitions Vaults &amp; Medicae Annex" id="eda833ad-5248-52ee-24f9-e1141b11aada" hidden="false" page="41" publicationId="2be8d152--pubN99523"/>
    <rule name="Navy Orders: Co-ordinate Reserves" id="c6740f31-a704-95f7-f8cc-acb7a181111f" hidden="false" page="31" publicationId="2be8d152--pubN72426"/>
    <rule name="Navy Orders: Intercept Reserves" id="1db4d273-b4d4-326e-e308-eba98f00b585" hidden="false" page="31" publicationId="2be8d152--pubN72426"/>
    <rule name="Neutron Thunderstrike" id="89a93651-3e2e-c18f-9511-ee1f63bdd081" hidden="false" page="43" publicationId="2be8d152--pubN99523"/>
    <rule name="Never Forgive" id="eb9324f7-f8e6-0a48-706f-55eee4d4da61" hidden="false" page="0" publicationId="2be8d152--pubN230287"/>
    <rule name="Never Give Up, Never Surrender!" id="ace2559e-80e8-b37c-de43-02d2fd4abcc4" hidden="false" page="59" publicationId="2be8d152--pubN77996"/>
    <rule name="Night Vision" id="10cc798c-0cef-41d4-dd97-37a0fbac9fae" hidden="false" page="168" publicationId="2be8d152--pubN229712">
      <description>Ignores Night Fighting</description>
    </rule>
    <rule name="No Ordinary Weapon" id="82368bdc-7332-7ce3-4f50-f1b05fa00958" hidden="false" page="53" publicationId="2be8d152--pubN72426"/>
    <rule name="Objective Secured" id="906a5f96-4c50-0fd6-c525-cd611e4ee811" hidden="true" publicationId="2be8d152--pubN174596"/>
    <rule name="Objective Secured*" id="258a-387f-450c-d970" hidden="false" page="157" publicationId="2be8d152--pubN73328">
      <description>Infantry units from an Assault Company have the Objective Secured special rule. A unit with this special rule controls Objective Markers even if an enemy scoring unit is within range of the Objective Marker, unless the enemy unit also has this special rule.</description>
    </rule>
    <rule name="Objective Sighted" id="7e06e2ef-3822-2be7-bd8c-4e018932b096" hidden="false" page="0" publicationId="2be8d152--pubN156636"/>
    <rule name="Offensive Strategy" id="dfa2c1f9-0c3c-c276-6fd3-abdc60fc2657" hidden="true" publicationId="2be8d152--pubN230905"/>
    <rule name="Operator" id="a5163c32-635c-876a-415e-7022353a78a7" hidden="false" page="215" publicationId="2be8d152--pubN100633"/>
    <rule name="Orbital Cannon" id="4f36ed35-1c20-77b5-784f-5fc1d958e36e" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>A Defence Laser can forgo its usual shooting in order to neutralise an opponent&apos;s off-table support.

Declare the Orbital Cannon option is being used when the enemy attempts to use one of the following Strategic Assets and roll to hit using the Defence Laser&apos;s usual BS:
Orbital Bombardment, Scheduled Bombardment, Precision Strike, Blind Barrage.
If a hit is scored the Strategic Asset is neutralised for the rest of the game. If the Defence Laser misses, the Strategic Asset may be used as normal.</description>
    </rule>
    <rule name="Orders: Bring it Down!" id="ae625cd8-6bd0-4c34-d935-d5cfdcdb05e6" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Fire and Advance!" id="41d2-3e87-ce1d-fc09" hidden="false" page="154" publicationId="2be8d152--pubN73328">
      <description>The ordered unit must make a shooting attack. The unit count as being stationary, even if it moved in the preceding Movement phase.</description>
    </rule>
    <rule name="Orders: Fire on my Target!" id="741bb832-399a-6b47-d80b-a14e49cfec96" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: First Rank, FIRE! Second Rank, FIRE!" id="d8fecad7-7b67-3d10-fc25-4ef58be26ae2" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Forwards, for the Emperor!" id="40f9f8da-06b3-85a6-f361-f08fe2f19066" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Get Back in the Fight!" id="6be995b3-2399-e320-4e91-7223188f4e8f" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Move! Move! Move!" id="925fcdd3-e334-ae6a-f89c-e82559f3992e" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Smite at Will!" id="40a6a236-30da-ba43-f9a2-4e4126b2e935" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Suppressive Fire!" id="333c18e2-0b91-8da6-0fcc-a1fde4cd65cd" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Orders: Take Aim!" id="4aa3b953-bf90-960d-c72c-fe0f78f792c7" hidden="false" page="0" publicationId="2be8d152--pubN72426"/>
    <rule name="Outflank" id="7ae778b2-8ebc-ffde-bdbe-cbfcb6675c9d" hidden="false" page="168" publicationId="2be8d152--pubN229712"/>
    <rule name="Overdrive" id="2cb30dbc-2cd4-5b08-1b7b-ec5c5b798f82" hidden="false" page="6" publicationId="2be8d152--pubN99523"/>
    <rule name="Overtaxed Reactor" id="3ab64f78-328c-8bf3-af80-4698c944d46f" hidden="false" publicationId="2be8d152--pubN205666"/>
    <rule name="Pinning" id="3070fdfe-1123-bf01-3249-59e8258c943e" hidden="false" page="168" publicationId="2be8d152--pubN229712"/>
    <rule name="Pinpoint Execution" id="eceb9502-e315-defc-5909-b806331d62f0" hidden="false" page="53" publicationId="2be8d152--pubN202674"/>
    <rule name="Pounding Barrage" id="9e121429-981d-66b0-ec3a-ea51600adb8d" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Power of the Machine Spirit" id="2dbae37d-01b7-170b-d5ee-036461e83917" hidden="false" page="169" publicationId="2be8d152--pubN229712"/>
    <rule name="Powerlifter" id="cdd7795a-ad2a-3863-107a-ecd65273f231" hidden="false" page="223" publicationId="2be8d152--pubN100633"/>
    <rule name="Preferred Enemy" id="de532034-37c7-c95e-e2bb-3c1356f01440" hidden="false" page="169" publicationId="2be8d152--pubN229712">
      <description>Re-roll 1&apos;s To Hit and To Wound Preferred Enemy in both shooting and close combat.</description>
    </rule>
    <rule name="Preferred Enemy (Everything!)" id="1577594b-de82-1c22-6cf5-4a77438ddb08" hidden="false" page="232" publicationId="2be8d152--pubN100633"/>
    <rule name="Preferred Enemy (Orks)" id="7e7775b6-b84f-70c3-836f-1631d6578768" hidden="false" page="55" publicationId="2be8d152--pubN72426"/>
    <rule name="Primary Target" id="fa7385f3-0ad8-76b7-3b40-b25dcebd4066" hidden="false" page="0" publicationId="2be8d152--pubN230679"/>
    <rule name="Prime Reaver" id="189deb5a-71df-e541-e2f9-8126899d6768" hidden="false" page="206" publicationId="2be8d152--pubN233274"/>
    <rule name="Psychic Choirs" id="8a33f832-04c0-1581-2fa6-7d2824f0ff99" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Psychic Discipline: Biomancy" id="281e230f-4363-bb46-ff31-2cad750bdbb5" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Psychic Discipline: Daemonology" id="a004e025-5589-0768-4593-c70ab258d828" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Psychic Discipline: Divination" id="116a1015-ae2b-c01a-35a8-9106cf0aa0a2" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Psychic Discipline: Pyromancy" id="5b55b0ce-44dc-1567-1f5c-c9d1c0994fbf" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Psychic Discipline: Telekinesis" id="d9621112-144a-fe7d-98d8-1cd9b723e323" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Psyker" id="a93869c6-4270-c60f-aee9-01f61581d06e" hidden="false" page="22" publicationId="2be8d152--pubN229712"/>
    <rule name="Psyker (Mastery Level 1)" id="7672255a-03d3-3a8b-e7f5-ea6d624175f0" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Psyker (Mastery Level 2)" id="fa0ea3b3-9cba-8035-7c1d-33148075f3ac" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Punishing Fusillade" id="e4a2-3bd6-88a7-f2a2" hidden="false" page="155" publicationId="2be8d152--pubN73328">
      <description>The Company Commander can choose to issue the &apos;First Rank, Fire! Second Rank, Fire!&apos; order to any number of units from the Infantry Company at the same time. This counts as issuing a single order. If he does so, make a single Leadership test, using the highest Leadership among the ordered units. If the test is passed, all ordered units must shoot at the same target.</description>
    </rule>
    <rule name="Punitive" id="8fbc-10b3-586e-3d92" hidden="false" page="167" publicationId="2be8d152--pubN73328">
      <description>A weapon with this special rule always wounds on a roll of 4+. In addition, when making armour saves against attacks made by a weapon with this special rule, a roll of 3 or less will always fail, even if the target&apos;s Save characteristic is 3+ or better.</description>
    </rule>
    <rule name="Rad-phage" id="daf404a1-e23a-1c76-dc5b-5a866abcbb97" hidden="false" publicationId="2be8d152--pubN205666"/>
    <rule name="Rapid Assault" id="df1424ab-dd7a-eeb2-aba9-a35f7e61f595" hidden="false" page="17" publicationId="2be8d152--pubN233487"/>
    <rule name="Rapid Response" id="e77c-4806-c9f2-8352" hidden="false">
      <description>Battlegroup Hammerblow&apos;s Militarum Tempestus Scions must begin the game embarked upon the formation&apos;s Valkyrie. Instead of making Reserve rolls for the Valkyrie, at the start of any of your turns (including the first) you may have it arrive from Deep Strike Reserve. It will not scatter if placed within 12&quot; of the Scout Sentinel Squadron from this formation.</description>
    </rule>
    <rule name="Reactor Meltdown" id="e62673a2-b8b7-53eb-1836-d08c880ab3be" hidden="false" page="6" publicationId="2be8d152--pubN99523"/>
    <rule name="Recovery Vehicle" id="25d6d4f6-7168-e7b6-22e6-6c21aa6fe27c" hidden="false" page="211" publicationId="2be8d152--pubN100633"/>
    <rule name="Relentless" id="e45bac6e-634e-e66e-4394-49d88b42f182" hidden="false" page="170" publicationId="2be8d152--pubN229712"/>
    <rule name="Remote Control" id="c8cc1fb5-b56e-bb27-f093-2d08006c2dce" hidden="false" page="215" publicationId="2be8d152--pubN100633"/>
    <rule name="Rending" id="268d865a-dc2e-b3e6-63c9-4fcc102f9cba" hidden="false" page="170" publicationId="2be8d152--pubN229712"/>
    <rule name="Repair" id="1a0dc6b9-bd8b-79bb-8253-8a9e9834556c" hidden="false" page="5" publicationId="2be8d152--pubN71923"/>
    <rule name="Righteous Fury" id="21872a4b-4fdb-4def-fc1c-6834c1929320" hidden="false" page="35" publicationId="2be8d152--pubN77996"/>
    <rule name="Run Them Through!" id="3eb4c8f7-023c-3a02-fa75-56b061dd3c75" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>In any turn in which the the Rough Rider Commander charges into combat, all units in his formation within 6&quot; gain the Furious Charge ability &amp; recieve +2A instead of the normal +1A charging bonus.</description>
    </rule>
    <rule name="Saturation Bombardment" id="b8b15aaf-d450-2bbd-948e-3fd14e844f87" hidden="false" page="44" publicationId="2be8d152--pubN99523"/>
    <rule name="Scanner Modes - LR Sweep, SR Lock" id="267e9ee9-bbf9-04b5-86f2-951b5ba0ea3a" hidden="false" page="4" publicationId="2be8d152--pubN167642"/>
    <rule name="Scout" id="ae716543-4d76-2571-3a91-1e57f66692fc" hidden="false" page="171" publicationId="2be8d152--pubN229712"/>
    <rule name="Send in the Next Wave" id="716ce69c-2361-2390-35d5-47ddc463d5fd" hidden="false" page="65" publicationId="2be8d152--pubN77996"/>
    <rule name="Senior Officer" id="f34c8090-4e32-bd27-df37-1b714a4288d2" hidden="false" page="30" publicationId="2be8d152--pubN72426"/>
    <rule name="Sentry Defence System" id="5e811d64-b1f3-2f4c-0cae-52fe296badb0" hidden="false" page="0" publicationId="2be8d152--pubN230679"/>
    <rule name="Shadowy Herald of Strife" id="6004a4f9-d824-64e6-79c9-57fc60ad2316" hidden="false" page="0" publicationId="2be8d152--pubN230287"/>
    <rule name="Sharpshooters" id="2144-d2e5-e934-7634" hidden="false" page="168" publicationId="2be8d152--pubN73328">
      <description>Models from this Detachment can re-roll To Hit rolls of 1 when firing lasguns or hot-shot lasguns.</description>
    </rule>
    <rule name="Shell Shock" id="3d8293cf-eed3-a505-8edd-aeb9c6fbce92" hidden="false" page="197" publicationId="2be8d152--pubN100633"/>
    <rule name="Shock Pulse" id="cb1b68cf-76f7-6387-1488-8687567ea98c" hidden="false" page="135" publicationId="2be8d152--pubN99523"/>
    <rule name="Shoot Sharp and Scarper" id="9f5f81bb-9842-c713-45ac-113485039f94" hidden="false" page="43" publicationId="2be8d152--pubN72426"/>
    <rule name="Show Them the Emperor&apos;s Mercy!" id="ad79bb4b-0fbf-55c4-8b23-fde7d0172303" hidden="false" page="53" publicationId="2be8d152--pubN202674"/>
    <rule name="Shrouded" id="6b8d42ab-e38b-a1de-7dcf-4ca95231bb4d" hidden="false" page="170" publicationId="2be8d152--pubN229712">
      <description>+2 cover save</description>
    </rule>
    <rule name="Skilled Gunnery" id="74af7cbd-0e94-4394-4492-5730777a2dee" hidden="false" page="272" publicationId="2be8d152--pubN100633"/>
    <rule name="Sky Killer" id="01d337b3-1183-cbf3-f2f3-894ff541a3da" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>All Praetor tanks within the formation are equipped with Pilum warhead missiles &amp; may not use any other type.</description>
    </rule>
    <rule name="Sky Lift" id="8d940c74-76e8-207a-ed56-a374fd2d75e8" hidden="false" page="16" publicationId="2be8d152--pubN71923"/>
    <rule name="Skyfire" id="48916643-2f54-dfcd-f165-4d47d6afb04b" hidden="false" page="42" publicationId="2be8d152--pubN174596"/>
    <rule name="Slow" id="bb05d286-b406-d9b5-65d7-a487539e29aa" hidden="false" page="0" publicationId="2be8d152--pubN174596"/>
    <rule name="Slow And Purposeful" id="89022042-3a2b-3829-d0e9-09512a95dbd7" hidden="false" page="171" publicationId="2be8d152--pubN229712"/>
    <rule name="Smash" id="b9244de6-5d3b-4600-e67d-25ea2ee62d90" hidden="false" page="171" publicationId="2be8d152--pubN229712"/>
    <rule name="Sniper" id="f0641044-7a43-de6d-428a-3a41903cd2cd" hidden="false" page="171" publicationId="2be8d152--pubN229712"/>
    <rule name="Sniper Cover" id="8b069627-b9d3-187d-b2b9-2499c10eba96" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>Instead of door gunners with Heavy Bolters, Col Paseski&apos;s crew includes a pair of master snipers, 1 on each side door. Their Sniper Rifles may always fire, even if not normally allowed to, and may engage any enemy unit they can see, not only those fired at by Steel Eagles other weapons.
Once per game, you may declare a single &apos;champion&apos; shot to be fired by each sniper. This rolls to hit as normal, S10, AP1, 2D6 armour pen. The snipers may be lost as a result of a Weapon Destroyed damage result (one per result).</description>
    </rule>
    <rule name="Sonic Boom" id="8694be98-1cbf-00cf-30d7-f8f76b516cc0" hidden="false" page="0" publicationId="2be8d152--pubN230679"/>
    <rule name="Special Manoeuvres" id="eb95dad9-5e29-2474-4d99-3874751f67c1" hidden="false" page="77" publicationId="2be8d152--pubN234031"/>
    <rule name="Special Operations" id="f4d2c529-9c02-360a-0679-3af74377d682" hidden="false" page="49" publicationId="2be8d152--pubN77996"/>
    <rule name="Split Fire" id="25295fc6-d439-0585-616a-cfc202f1d52d" hidden="false" page="172" publicationId="2be8d152--pubN229712"/>
    <rule name="Spotting Rounds" id="2fbcac2d-b3a4-c902-1f17-bc2dc05d5976" hidden="false" page="19" publicationId="2be8d152--pubN231590"/>
    <rule name="Squadron Command Tank" id="a8e1c355-2374-3717-c1e5-061a343cbbaa" hidden="false" page="18" publicationId="2be8d152--pubN231590"/>
    <rule name="Stalk the Enemy" id="51758a7a-85fd-c261-3577-7dec49a49222" hidden="false" page="64" publicationId="2be8d152--pubN77996"/>
    <rule name="Stealth" id="4ef69611-d89c-409b-2955-acb043e1cf2f" hidden="false" page="172" publicationId="2be8d152--pubN229712">
      <description>+1 cover save</description>
    </rule>
    <rule name="Stealth Formation Leader" id="b9d97984-6ac5-a501-7ff7-cc36bf320ef7" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Steel Assault" id="da8c4f01-148b-5f6b-1ccd-88a8352a2d64" hidden="false" page="48" publicationId="2be8d152--pubN230985"/>
    <rule name="Steel Phalanx" id="a0f2c2fd-5d4b-bd1a-d7a3-d60868281ac7" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Steel Phalanx*" id="a323-def4-00c7-c9f1" hidden="false" page="159" publicationId="2be8d152--pubN73328">
      <description>If a unit is Tank Shocked or Rammed by more than one vehicle from this Formation in the same turn, subtract 1 from its Leadership for the Tank Shock test or add 1 to the Strength of the Ram for each vehicle after the first.</description>
    </rule>
    <rule name="Stomp" id="702de286-c480-b115-bf5e-e46c5761e747" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Storm the Objective" id="45eb9dbc-bb48-bdfa-880c-f1b061c62b49" hidden="false" page="54" publicationId="2be8d152--pubN202674"/>
    <rule name="Strafing Run" id="05138154-c5cd-1abb-33fe-25e1699c590c" hidden="false" page="172" publicationId="2be8d152--pubN229712"/>
    <rule name="Strategic Asset - Blind Barrage" id="48385270-0e65-e4ef-9a50-54f9d7213733" hidden="false" page="0" publicationId="2be8d152--pubN230593"/>
    <rule name="Strategic Asset - Camoflage" id="6bf3e7de-57e8-a651-b192-b89af331e4b4" hidden="false" page="0" publicationId="2be8d152--pubN230593"/>
    <rule name="Strategic Asset - Flank March" id="e06156be-f23e-3d19-28ea-2f5f0b9e29b1" hidden="false" page="0" publicationId="2be8d152--pubN230341"/>
    <rule name="Strategic Asset - Supreme Headquarters" id="169ca5ba-a166-0eed-a0ec-5073afbcc0ab" hidden="false" page="0" publicationId="2be8d152--pubN230593"/>
    <rule name="Strategic Asset - Vital Objective" id="30ca273d-3d64-6d86-93d8-c4c1712930ea" hidden="false" page="0" publicationId="2be8d152--pubN230593"/>
    <rule name="Strategic Redeployment" id="d82e8f87-b9ea-7fd0-3d1c-e74edb878f3d" hidden="false" page="0" publicationId="2be8d152--pubN230593"/>
