    <rule name="Summary Execution" id="e3493339-64c4-881d-a4e4-dfae745232e1" hidden="false" page="33" publicationId="2be8d152--pubN72426"/>
    <rule name="Sunder" id="1e7fece4-ca86-ae22-1b2d-9832c69373e0" hidden="false" publicationId="2be8d152--pubN189262"/>
    <rule name="Super Heavy Hunters" id="300b83da-f068-27a3-32d6-5e04298e8cc2" hidden="false" page="0" publicationId="2be8d152--pubN156636"/>
    <rule name="Supersonic" id="381bb905-a0f2-f66b-13ee-74bbf271a5cf" hidden="false" page="172" publicationId="2be8d152--pubN229712">
      <description>May move Flat Out between 18&quot; and 36&quot;</description>
    </rule>
    <rule name="Support Vehicle" id="5f545bb5-3e7a-a99e-f18d-f4c9dd18bb6c" hidden="false" page="231" publicationId="2be8d152--pubN100633"/>
    <rule name="Supreme Commander" id="45603e39-cf58-0fdc-bc23-950aadb5fb29" hidden="false" page="56" publicationId="2be8d152--pubN72426"/>
    <rule name="Surprise Attack" id="bab0d4f9-9b15-f8a7-67fd-09b605596a10" hidden="false" page="17" publicationId="2be8d152--pubN233487"/>
    <rule name="Swift Strike" id="35304385-a7d6-ccf1-f66a-8460cadceb7d" hidden="false" page="0" publicationId="2be8d152--pubN189615"/>
    <rule name="Sworn Protector" id="0e6fe1c7-f25e-03f9-7f2b-2165334417d8" hidden="false" page="56" publicationId="2be8d152--pubN72426"/>
    <rule name="Tactical Genius" id="68c28c70-560a-0015-bdd5-189461607fc5" hidden="false" page="56" publicationId="2be8d152--pubN72426">
      <description>Creed gets two Warlord Traits.</description>
    </rule>
    <rule name="Tallarn Desert Raiders" id="5d5a679e-b120-bf89-3c2c-10438616dbbc" hidden="false" page="226" publicationId="2be8d152--pubN164097">
      <description>May re-roll any To Hit rolls of 1 in the Shooting phase.
Gains the Move Through Cover special rule.
May not take Carapace Armour.</description>
    </rule>
    <rule name="Tank Hunters" id="2bcf943d-60f4-fa44-21c8-564c556dc706" hidden="false" page="172" publicationId="2be8d152--pubN229712">
      <description>Re-roll Armour Penetration</description>
    </rule>
    <rule name="Tank Orders: Full Throttle!" id="a0c6603e-25e1-bddf-3cdb-e6781636722e" hidden="false" page="32" publicationId="2be8d152--pubN72426"/>
    <rule name="Tank Orders: Gunners, Kill on Sight!" id="58e56144-d1c0-34f7-1665-af4ddf5176ea" hidden="false" page="32" publicationId="2be8d152--pubN72426"/>
    <rule name="Tank Orders: Strike and Shroud!" id="43b70a95-f432-14a3-5dbd-057fe861ef43" hidden="false" page="32" publicationId="2be8d152--pubN72426"/>
    <rule name="Target Acquired" id="207f14e2-a794-768f-3ef6-41cd369f27dc" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>Once per shooting phase, the owning player may nominate a single enemy unit within line of sight to the Command Squad. All units in the Heavy Weapons Company within 12&quot; of the Command Squad must fire at this target but they count their weapons ass twin-linked for that round of shooting.</description>
    </rule>
    <rule name="Target Designation" id="0daa9133-8914-8779-61ce-50357bbc618b" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Target Sighted" id="7e2e-6484-46c2-de39" hidden="false" page="158" publicationId="2be8d152--pubN73328">
      <description>Once per turn, in your Shooting phase, one friendly model equipped with a vox-caster can call in target coordinates. Choose an enemy unit within 18&quot; and in line of sight of that model. Until the end of the phase, models from this Formation count their weapons as Twin-linked when firing at that enemy unit.</description>
    </rule>
    <rule name="Taskmaster" id="2b700447-a8e3-1f55-28b3-55d5d5f160ca" hidden="false" page="65" publicationId="2be8d152--pubN77996"/>
    <rule name="Telepathic Relay" id="50b24603-47bd-5bf1-d0f7-14c050c0d1bf" hidden="false" page="31" publicationId="2be8d152--pubN77996"/>
    <rule name="Tempest Attack" id="58d27822-6239-f7fe-f372-f31b6b8d0d60" hidden="false" publicationId="2be8d152--pubN189262"/>
    <rule name="Temporal Distort" id="5b941e4f-c059-ec51-3c27-5b3c0aab4fc9" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="The Blessings of the Omnissiah" id="03125af0-12e9-9154-9a70-226096258e30" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>All Praetor tanks within the formation are BS4 when using their Praetor Launchers &amp; may re-roll failed Primary Weapon saves.</description>
    </rule>
    <rule name="The Ground Shakes" id="bbaf6188-483b-f94f-352d-57a787e74a40" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="The Ground Shakes*" id="a002-d75d-6eda-2bff" hidden="false" page="162" publicationId="2be8d152--pubN73328">
      <description>Enemy units within 12&quot; of at least two vehicles from this Formation move as though they are in difficult terrain.</description>
    </rule>
    <rule name="The Hour is Nigh" id="22d0db13-c29d-57e7-2d09-b38d3342ffd6" hidden="false" page="53" publicationId="2be8d152--pubN72426"/>
    <rule name="The Hunters and the Hounds" id="6abdf1d4-213c-da1a-0c5c-c9c83511ab3a" hidden="false" page="42" publicationId="2be8d152--pubN99523"/>
    <rule name="The Lord Castellan&apos;s Command Centre" id="56622557-f491-ae5f-deb0-58cbc6d10e39" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="The Thunder of the Guns" id="5fecabf8-8d62-bfe0-9419-724d6e4bc2cb" hidden="false" page="208" publicationId="2be8d152--pubN233274"/>
    <rule name="Thunderblitz" id="2b7bd030-9073-b18d-c65c-ef5ba26ca7ee" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Thunderblitzing &amp; Assaulting the Minotaur" id="1ef344a1-ca37-b686-ae9e-adf41f84f136" hidden="false" page="31" publicationId="2be8d152--pubN99523"/>
    <rule name="Thunderstrike Command Tank Auspex Array" id="6a88527b-50a2-a77c-11a5-677993d6b482" hidden="false" page="212" publicationId="2be8d152--pubN233274"/>
    <rule name="Titan Maniple" id="57cbd571-5e4e-f3c1-af88-9b14b26fc4ff" hidden="false" page="42" publicationId="2be8d152--pubN99523"/>
    <rule name="Titanic Tread" id="8c11dc31-868e-4abc-425d-e5f77522ab55" hidden="false" page="0" publicationId="2be8d152--pubN230341">
      <description>When the Emperor Titan moves, the ground is rocked by violent shockwaves. All units, except Super Heavy vehicles &amp; Gargantuan Creatures, that move within 12&quot; of the Titan&apos;s feet count as moving through Difficult Terrain.</description>
    </rule>
    <rule name="Towering Monstrosity" id="8fcc68a0-41a5-2734-07e2-bf23ec82bc83" hidden="false" page="0" publicationId="2be8d152--pubN235009"/>
    <rule name="Traps" id="95f39bb6-f3b6-b317-d1a6-328db90e2514" hidden="false" page="0" publicationId="2be8d152--pubN100814"/>
    <rule name="Unquestioning Loyalty" id="f6f4-1303-20a7-d9a4" hidden="false" page="160" publicationId="2be8d152--pubN73328">
      <description>Units of Ogryns and Bullgryns from this Formation that are within 12&quot; of the Commissar from this Formation have the Fearless special rule.</description>
    </rule>
    <rule name="Unstable Reactor" id="23888c9c-deb0-2791-db21-ba0c3b1819ed" hidden="false" page="6" publicationId="2be8d152--pubN99523"/>
    <rule name="Vector Dancer" id="0ea0bab0-b3e8-ae0e-0777-1907941f311b" hidden="false" page="174" publicationId="2be8d152--pubN174596"/>
    <rule name="Very Bulky" id="e419b169-b2cc-88b0-1b87-34a329d99a2b" hidden="false" page="159" publicationId="2be8d152--pubN229712">
      <description>Counts as three models in Transport</description>
    </rule>
    <rule name="Veteran Crew" id="c222f5b8-b30e-6582-c38d-72a86bd2090d" hidden="false" page="272" publicationId="2be8d152--pubN100633"/>
    <rule name="Vicous Temperament" id="6adff594-6cf5-19a6-bd49-65191dfa2e4f" hidden="false" page="66" publicationId="2be8d152--pubN77996"/>
    <rule name="Vital Mission" id="83dc9ad2-3f81-1335-5a76-82f94a3219e1" hidden="false" page="54" publicationId="2be8d152--pubN202674"/>
    <rule name="Voice of Command" id="2ff26b94-8048-d15d-c541-fd4da0f49571" hidden="false" page="28" publicationId="2be8d152--pubN72426"/>
    <rule name="Void Shields" id="2567eea6-5039-d7f8-daf5-da73a68dcbb5" hidden="false" page="41" publicationId="2be8d152--pubN99523"/>
