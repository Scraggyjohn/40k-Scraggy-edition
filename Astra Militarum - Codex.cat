    <profile name="Kurov&apos;s Aquila" id="6544dd5d-c559-db91-4088-6de940117752" hidden="false" page="0" publicationId="2be8d152--pubN72426" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">The officer, and all friendly units from Codex: Astra Militarum within 6&quot;, have the Preferred Enemy special rule. In addition, the bearer may re-roll a single failed Leadership test per turn.</characteristic>
      </characteristics>
    </profile>
