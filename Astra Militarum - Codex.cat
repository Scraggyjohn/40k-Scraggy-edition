          <entryLinks>
            <entryLink name="Krak Grenades" id="50ac539c-e5d0-2679-5aa4-f1dde3549ce3" collective="false" hidden="false" import="true" targetId="e2beb4ff-2117-ad18-eb26-91a10181fc36" type="selectionEntry"/>
            <entryLink name="Standard Kit" id="fd8ff38c-98af-0eae-4349-ef291b0faa08" collective="false" hidden="false" import="true" targetId="1e659a54-a460-f848-526e-c2b99a76d627" type="selectionEntry"/>
            <entryLink name="Warlord" id="b9ba67b7-6068-96ca-1a6f-dd50f0f96849" collective="false" hidden="false" import="true" targetId="f3aee269-2f69-f57e-eaea-6a91ac502357" type="selectionEntry"/>
