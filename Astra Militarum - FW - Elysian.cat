    <rule name="Stubborn" id="aafe93ed-12e1-4622-7fd6-36a1b31c3695" hidden="false" page="43" publicationId="d5d7c4c4--pubN110258"/>
    <rule name="Summary Execution" id="e3493339-64c4-881d-a4e4-dfae745232e1" hidden="false" page="32" publicationId="d5d7c4c4--pubN112751"/>
    <rule name="Sunder" id="1e7fece4-ca86-ae22-1b2d-9832c69373e0" hidden="false" publicationId="d5d7c4c4--pubN66249"/>
    <rule name="Supersonic" id="db2e9ea8-3c12-d84c-8d14-eed44e864cbe" hidden="false" page="43" publicationId="d5d7c4c4--pubN110258">
      <description>A Supersonic vehicle that moves Flat Out must move at least 18&quot; and can move up to 36&quot;. Supersonic Flyers cannot enter Hover mode.</description>
    </rule>
    <rule name="Surgical Enhancement" id="d7ffc4f9-91a7-0b7f-fb2e-8f802d9ed7e6" hidden="false" page="0" publicationId="d5d7c4c4--pubN113782"/>
