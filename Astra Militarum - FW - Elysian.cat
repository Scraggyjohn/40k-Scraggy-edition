    <profile name="Flamer" id="06d73e79-f635-f39c-d438-9ac3c7929b21" hidden="false" page="0" publicationId="d5d7c4c4--pubN67466" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
