    <rule name="Tempest Attack" id="58d27822-6239-f7fe-f372-f31b6b8d0d60" hidden="false" publicationId="d5d7c4c4--pubN66249"/>
    <rule name="Tenacity" id="d9a79067-3f39-ef07-cdc2-4cef02323a1b" hidden="false" page="2" publicationId="d5d7c4c4--pubN112783"/>
    <rule name="Vector Dancer" id="9089f807-7d81-6208-1427-8c7982d513e9" hidden="false" page="0" publicationId="d5d7c4c4--pubN114332">
      <description>A model with this special rule can make an additional pivot on the spot of up to 90 degrees at the end of its move. A model that uses this extra pivot cannot move Flat Out in the following Shooting phase.</description>
    </rule>
