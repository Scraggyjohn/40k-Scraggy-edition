    <profile name="Illum Flare" id="5432a591-fd7c-6c71-0e92-cc376dea1774" hidden="false" page="6" publicationId="d5d7c4c4--pubN96686" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">During each friendly Movement phase, a model equipped with illum flares may drop one as though it were a weapon with the Bomb 1 type, placing a marker where the flare lands. All units within 12&quot; of the Flare marker may be targeted as though Night Fight was not in effect. Illum flares have no effect if the Night Fight rules are not in play. At the end of each Game Turn, remove all Flare markers currently on the battlefield.</characteristic>
      </characteristics>
    </profile>
    <profile name="Imperial Bastion" id="c68d4fda-c0dd-5159-5488-d19cef60622f" hidden="false" page="0" publicationId="d5d7c4c4--pubN110258" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228"/>
      </characteristics>
    </profile>
    <profile name="Infrared Targeting" id="fb1f6c9a-5446-7579-7255-317e7b4f5037" hidden="false" page="6" publicationId="d5d7c4c4--pubN96686" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gains Night Vision. During the Dogfight phase, a vehicle equipped with this upgrade may re-roll all To Hit rolls of a &apos;1&apos; made during the Attack sub-phase.</characteristic>
      </characteristics>
    </profile>
