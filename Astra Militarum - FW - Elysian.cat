    <profile name="Meltagun" id="27997a1d-f5c5-0e8b-4d52-45c3037e6b4d" hidden="false" page="0" publicationId="d5d7c4c4--pubN67466" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
