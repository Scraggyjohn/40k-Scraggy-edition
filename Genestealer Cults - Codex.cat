    <profile name="Cult Icon" id="22d8-78e9-37a6-da97" hidden="false" page="100" publicationId="f840-ed73-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
      <characteristics>
        <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">All models in a unit with the cult icon have +1 Weapon Skill while the bearer is alive.</characteristic>
      </characteristics>
    </profile>
    <profile name="Demolition Charge" id="e17b-c8c2-3c6f-d11e" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
      <characteristics>
