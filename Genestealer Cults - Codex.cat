            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">3</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">5</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">1</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">5+/5++</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Preternatural Senses" id="c3eb-04b3-07a5-4109" hidden="false">
          <description>Gives a 5+ Invulnerable Save.</description>
        </rule>
        <rule name="Gunslinger" id="903b-b499-573c-cd50" hidden="false">
          <description>This model can target enemy Characters, even if they are in a Unit. Look Out, Sir! Rolls are taken at a -1 against this model’s attacks. In Addition, this model may fire all three of its Liberator Autostubs and treat each as Split Fire. Finally, when this model hits an enemy with a pistol shooting attack, it can immediately make one additional To Hit Roll against that target using the same weapon. These bonus hit rolls cannot generate any further hit rolls.</description>
        </rule>
        <rule name="Heroic Deeds, Heroic Inspiration" id="51d5-07d4-0d3a-7717" hidden="false">
          <description>If this model kills any character models with its ranged weapons, then until the end of the phase, after resolving its own attacks, re-roll To Hit rolls of 1 for attacks made with friendly Genestealer Cult Infantry units whilst they are within 6” of this model.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Liberator Autostub" id="dd75-9c28-e989-9434" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fb4d-bf4d-566f-701b" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="3"/>
            <constraint id="f1b5-be2e-6bff-0668" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="3"/>
          </constraints>
          <profiles>
            <profile name="Liberator Autostub" id="96f3-3702-cbd8-3500" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
              <characteristics>
                <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">12&quot;</characteristic>
                <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">4</characteristic>
                <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">5</characteristic>
                <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Pistol 2</characteristic>
                <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
              </characteristics>
            </profile>
            <profile name="3x Liberator Autostub" id="5717-b2c6-98d4-f579" hidden="false" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">When the Kelermorph Fights, it uses the Close Combat Weapon and Two Pistols, so therefore his base attacks is 3. If it charges, then it’s 4, and so on. When he shoots, each pistol may be shot at a different target, each pistol is 2 shots each.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
    <selectionEntry name="Locus" id="426b-1b19-3887-868b" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Elites" id="e6be-4710-5d49-b1d1" hidden="false" primary="true" targetId="638d74c6-bd97-4de5-b65a-6aaa24e9f4b2"/>
