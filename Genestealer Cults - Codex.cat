      <rules>
        <rule name="Priority Target Sighted" id="6706-8755-00c5-0a8f" hidden="false">
          <description>At the start of your Shooting Phase, select one non-vehicle Enemy unit that is visible to and within 36” of this model. Until the end of the phase, add 1 To Hit rolls for Shooting Attacks made by friendly Genestealer Cult units that target that enemy whilst they are within 6” of this model (or 12” if they are a friendly GSC Biker Unit). An enemy Unit can only be selected as the target of this ability once per phase.</description>
        </rule>
      </rules>
