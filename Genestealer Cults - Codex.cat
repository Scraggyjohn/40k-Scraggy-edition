            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">5+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unquestioning Bodyguard" id="a160-8924-2b5a-635e" hidden="false">
          <description>Each time a Genestealer Cult Character is challenged within 6”, the Locus may accept the challenge on the other Character’s Behalf.</description>
        </rule>
        <rule name="Neurotraumal Rod" id="e4fc-de4c-ec3a-33d8" hidden="false">
          <description>Subtract 1 from the Leadership Characteristic of enemy units while they are within 6” of any Locus.</description>
        </rule>
        <rule name="Sudden Strike" id="38d9-9ae6-39f7-ea95" hidden="false">
          <description>When this model charges, it makes a single attack with the Locus Blades at Initiative step 10.</description>
        </rule>
        <rule name="Quicksilver Dodge" id="8d7f-4bf4-1e23-8212" hidden="false">
          <description>Gives the model a 5+ Invulnerable Save</description>
        </rule>
        <rule name="Quicksilver Strike" id="75d3-1a07-ca38-a433" hidden="false">
          <description>If this model has the highest Initiative in Close Combat, it may reroll failed To Hit Rolls.</description>
        </rule>
      </rules>
      <selectionEntries>
