            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">2</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">5+</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Genomic Enhancement" id="bec0-07bf-fa83-b530" hidden="false">
          <description>This model can enhance a friendly Abberant unit that it is attached to. At the end of your movement phase, roll a D6, on a 1 a model in that Aberrant Unit is slain with no saves allowed. Then roll a D3 and refer to the table below to see what bonus the unit receives for the rest of the battle. A unit can only be target of this ability once per battle.




1 / +1 Strength
2 / +1 Toughness
3 / +1 Attacks</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Injector Goad" id="0434-d01a-d76c-fb0a" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6520-de51-6079-9d0f" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="80e1-233e-68f7-c591" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
