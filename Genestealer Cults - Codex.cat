              <characteristics>
                <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">Gives the +1 to Cover Saves. If it is not in Cover, it receives a 6+ Cover Save</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
