      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="20"/>
      </costs>
      <profiles>
        <profile name="The Crouchling" id="d963-9cf6-4240-9198" hidden="false" page="101" publicationId="f840-ed73-pubN65537" typeId="72c5eafc-75bf-4ed9-b425-78009f1efe82" typeName="Wargear Item">
          <characteristics>
            <characteristic name="Description" typeId="21befb24-fc85-4f52-a745-64b2e48f8228">In close combat, a model with accompanied by the Crouchling makes two additional S4 AP- attacks with the Rending special rule. In addition, the bearer may generate one additional psychic power at the start of the game.  The Crouchling is represented by a separate miniature that will always remain as close as possible to it&apos;s master. The model itself is decorative and is always ignored for game purproses - just move it to one side if it gets in the way. Remove the Crouchling once it&apos;s master has been slain.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="The Doting Throng" id="57f9-ea29-4fc2-ee67" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Frenzied Devotion" id="ff8d-b084-2313-f764" hidden="false" page="92" publicationId="f840-ed73-pubN65537">
          <description>Units from this Formation have the Zealot special rule whilst they are within 12&quot; of a friendly Magus. Furthermore, a unit that is actually joined by a Magus can re-roll failed To Hit rolls in every round of close combat, not just the first.</description>
        </rule>
        <rule name="Willing Subjects" id="eb99-5454-7931-3950" hidden="false" page="92" publicationId="f840-ed73-pubN65537">
          <description>If a Magus targets a Neophyte Hybrid or Acolyte Hybrid unit from this Formation with a blessing psychic power, be can re-roll the Psychic test if it is failed.</description>
        </rule>
      </rules>
      <selectionEntryGroups>
        <selectionEntryGroup name="Magus" id="9886-2585-5b23-2b57" collective="false" defaultSelectionEntryId="090c-cabd-5c5a-ab7d" hidden="false" import="true">
