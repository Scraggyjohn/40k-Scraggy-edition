      <rules>
        <rule name="Scrambler Array" id="9d7d-a3f6-b411-dec8" hidden="false">
          <description>Enemy Units that are set up on the battlefield as Reinforcements cannot be set up within 12” of this model (This would trigger a Deep Strike Mishap). In addition, at the start of your Shooting Phase, roll a D6 for each enemy non-vehicle unit within 6” of the Clamavus. On a 6, the unit suffers a S10 AP2 Hit.</description>
        </rule>
        <rule name="Proclamator Hailer" id="c93c-7321-5e8c-e186" hidden="false">
          <description>Add 1 to the Leadership Characteristic of friendly Genestealer Cult Units that are within 6” of a Clamavus. In Addition, add 1 to Advance and Charge rolls for friendly Genestealer Cult Units within 6” of the Clamavus.</description>
        </rule>
      </rules>
    </selectionEntry>
