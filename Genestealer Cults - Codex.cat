      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="105"/>
      </costs>
      <entryLinks>
        <entryLink name="Rending claws" id="0633-7732-7385-ffb3" hidden="false" import="true" targetId="5177-153f-603f-c73b" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Cult Ambush" id="113f-3afc-f586-3e2b" hidden="false" targetId="5e06-11ab-8ac6-6375" type="rule"/>
        <infoLink name="Return to the Shadows" id="ecd2-afbb-2415-f6b6" hidden="false" targetId="68a1-1058-e764-744e" type="rule"/>
        <infoLink name="It Will Not Die" id="78bc-4241-e282-a541" hidden="false" targetId="8de3-9e93-da02-b9dd" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Abominant" id="0418-67e5-a1c3-9049" hidden="false" typeId="2d6001b0-980e-46d2-bcc2-a9fc60109afd" typeName="Unit">
          <characteristics>
            <characteristic name="Unit Type" typeId="c2b4b061-a0fd-499d-8a3d-6ee52587cbd5">Infantry (Independent Character)</characteristic>
            <characteristic name="WS" typeId="5ee4ff0b-b244-4670-9d05-91d10f80c32e">5</characteristic>
            <characteristic name="BS" typeId="f6f92f00-8bb1-4afa-8ccb-46310b7dd5e5">1</characteristic>
            <characteristic name="S" typeId="da036dbb-32c2-430a-9dd5-aa74e0c4f74b">6</characteristic>
            <characteristic name="T" typeId="3f9ed75c-36cd-4169-9cef-48391bb55cfd">5</characteristic>
            <characteristic name="W" typeId="17ee558f-3014-4bd2-afc1-b474d8d2b7a8">3</characteristic>
            <characteristic name="I" typeId="a558b3ef-04d0-440e-a312-bac3255bf592">5</characteristic>
            <characteristic name="A" typeId="5dff3e7c-e024-4030-a71d-03195ec06ea7">3</characteristic>
            <characteristic name="Ld" typeId="4a42059d-12cd-4c1f-a4c7-bb569d13eeea">8</characteristic>
            <characteristic name="Save" typeId="b215fe72-dbce-4ad6-89ec-c4bb3962c39d">5+/5++</characteristic>
          </characteristics>
        </profile>
        <profile name="Power Sledgehammer" id="c96f-4164-6bfd-1bdb" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">x2</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">3</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Unwieldy</characteristic>
            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Bestial Vigour" id="693d-9eb2-801b-158b" hidden="false">
          <description>Gives the model a 5+ Invulnerable Save.</description>
        </rule>
        <rule name="The Chosen One" id="bc06-bbdd-f3fb-0dea" hidden="false">
          <description>Each umodified To Hit roll of 6 for attacks made in the Fight Sub-phase by friendly Abberant Units whilst this model is attached score 2 hits instead of 1.</description>
        </rule>
        <rule name="Mindwyrm Familiar" id="831a-b6b2-6110-d635" hidden="false">
          <description>In close combat, a model with a Mindwyrm Familiar makes two additional Strength 4 AP- attacks with the Rending special rule. Additionally, Enemy Psykers within 12” of this model subtract 1 from Psychic Tests (Instead of a warp charge on a 4+, it would be a 5+).</description>
        </rule>
      </rules>
    </selectionEntry>
