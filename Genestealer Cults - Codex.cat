  <forceEntries>
    <forceEntry name="Cult Insurrection" id="e34d-8198-502a-4daa" hidden="false">
      <categoryLinks>
        <categoryLink name="Core" id="e34d-8198-502a-4daa-bf93-7277-bf48-16f7" hidden="false" primary="false" targetId="bf93-7277-bf48-16f7">
          <constraints>
            <constraint id="5fd0-e93a-6617-881c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
            <constraint id="6005-d894-b89a-f2ad" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="6"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Command" id="e34d-8198-502a-4daa-9050-d437-3301-7e42" hidden="false" primary="false" targetId="9050-d437-3301-7e42">
          <constraints>
            <constraint id="d210-9850-eb3e-936f" field="selections" includeChildForces="true" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
        </categoryLink>
        <categoryLink name="Auxiliary" id="e34d-8198-502a-4daa-ef2b-83bd-1bad-5742" hidden="false" primary="false" targetId="ef2b-83bd-1bad-5742">
          <constraints>
            <constraint id="de0e-3ad5-bec5-1250" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
          </constraints>
        </categoryLink>
        <categoryLink name="No Force Org Slot" id="e34d-8198-502a-4daa-ff36a6f3-19bf-4f48-8956-adacfd28fe74" hidden="false" primary="false" targetId="ff36a6f3-19bf-4f48-8956-adacfd28fe74"/>
      </categoryLinks>
      <infoLinks>
        <infoLink name="Infiltrate" id="9856-8427-197e-6438" hidden="false" targetId="0b11-a0ff-f0ba-5341" type="rule"/>
        <infoLink name="Shrouded" id="0d2d-84ca-62bc-ca97" hidden="false" targetId="7182-6dce-dc98-9f7c" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Cult Father" id="58e0-93d6-48a2-5357" hidden="false" page="66" publicationId="f840-ed73-pubN65537">
          <description>If you choose a Patriarch from this Detachment as your Warlord, you can re-roll the result when rolling on the Warlord Traits table in Codex: Genestealer Cults.</description>
        </rule>
        <rule name="An Uprising Generations in the Making" id="a585-cf83-fe47-cbf5" hidden="false" page="66" publicationId="f840-ed73-pubN65537">
          <description>All non-vehicle units in this Detachment have the Infiltrate special rule (units that already hve the Infiltrate special rule instead have the Shrouded special rule during the first game turn). In addition, you can add 1 to all your Reserve Rolls, whilst your opponent must subtract 1 from all their Reserve Rolls.</description>
        </rule>
        <rule name="Numbers Beyond Counting" id="7538-e1d1-9a7a-9722" hidden="false" page="66" publicationId="f840-ed73-pubN65537">
          <description>Each time a unit from this Detachment arrives from Ongoing Reserves, it is reinforced - you can return D6 models to the unit that were slain previously during the battle.</description>
        </rule>
      </rules>
    </forceEntry>
  </forceEntries>
