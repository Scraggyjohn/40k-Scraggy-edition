        <profile name="Dagger of the Swift Sacrifice" id="4f9b-5b8f-62e8-dba7" hidden="false" page="101" publicationId="f840-ed73-pubN65537" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapon">
          <characteristics>
            <characteristic name="Range" typeId="6fa97fa8-ea74-4a27-a0fb-bc4e5f367464">-</characteristic>
            <characteristic name="Strength" typeId="a6383362-5aa8-4ff0-b1d0-00e059fc9d45">User</characteristic>
            <characteristic name="AP" typeId="6abee736-f8d3-498e-97ac-a5c68445609f">-</characteristic>
            <characteristic name="Type" typeId="077c342f-d7b9-45c6-b8af-88e97cafd3a2">Melee, Instant Death, Poisoned (2+)</characteristic>
            <characteristic name="Extra Info" typeId="a165-1a07-fe23-3796"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Dagger of the Swift Sacrifice" id="ef66-201e-48fb-0d4a" hidden="false" page="101" publicationId="f840-ed73-pubN65537">
          <description>When making its close combat attacks, a model with the Dagger of the Swift Sacrifice can instead make a single attack, rolling To Hit as normal, using the profile of the weapon.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Deliverance Broodsurge" id="39d7-8363-ea30-25ee" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
      </costs>
      <rules>
        <rule name="Reckless Fanaticism" id="93a5-9988-9f17-46b9" hidden="false" page="87" publicationId="f840-ed73-pubN65537">
          <description>All units of Neophyte Hybrids from a Deliverance Broodsurge must begin the game embarked upon their Goliath Trucks. These units can disembark even if their vehicle moved at Cruising Speed, though each model that does so must take a Dangerous Terrain test.</description>
        </rule>
        <rule name="Perfervid Crew" id="8c54-831a-4599-e390" hidden="false" page="87" publicationId="f840-ed73-pubN65537">
          <description>Each time a vehicle from this Formation suffers a Crew Stunned or Crew Shaken result, that result is ignored (though the vehicle still loses a Hull Point).</description>
        </rule>
      </rules>
